@model List<WebsiteBabyShop.Models.Product>
@{
    ViewData["Title"] = "Bộ Sưu Tập Thời Trang Trẻ Em - BabyShop";
    var categories = ViewBag.Categories as List<WebsiteBabyShop.Models.Category> ?? new List<WebsiteBabyShop.Models.Category>();
    string currentGender = ViewBag.CurrentGender as string ?? "";
    string currentCategory = ViewBag.CurrentCategory as string ?? "";
    string currentAgeRange = ViewBag.CurrentAgeRange as string ?? "";
    string currentSearch = ViewBag.CurrentSearch as string ?? "";
    string currentSort = ViewBag.CurrentSort as string ?? "";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalItems = ViewBag.TotalItems ?? 0;
}

<div class="container py-3 py-md-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index"><i class="bi bi-house"></i> Trang Chủ</a></li>
            <li class="breadcrumb-item @(string.IsNullOrEmpty(currentGender) && string.IsNullOrEmpty(currentAgeRange) ? "active" : "")">
                <a asp-controller="Product" asp-action="Index" class="text-decoration-none">Thời Trang Trẻ Em</a>
            </li>
            @if (!string.IsNullOrEmpty(currentGender))
            {
                <li class="breadcrumb-item @(string.IsNullOrEmpty(currentAgeRange) ? "active" : "")">@currentGender</li>
            }
            @if (!string.IsNullOrEmpty(currentAgeRange))
            {
                <li class="breadcrumb-item active">@currentAgeRange</li>
            }
        </ol>
    </nav>

    <!-- Contemporary Page Header Banner -->
    <div class="baby-cat-banner">
        <div class="row align-items-center g-3">
            <div class="col-12 col-md-8">
                <h1>
                    @if (!string.IsNullOrEmpty(currentSearch))
                    {
                        <span>Kết quả tìm kiếm: "@currentSearch"</span>
                    }
                    else if (!string.IsNullOrEmpty(currentGender) && !string.IsNullOrEmpty(currentAgeRange))
                    {
                        <span>Thời Trang @currentGender • @currentAgeRange</span>
                    }
                    else if (!string.IsNullOrEmpty(currentAgeRange))
                    {
                        <span>Độ Tuổi: @currentAgeRange</span>
                    }
                    else if (!string.IsNullOrEmpty(currentGender))
                    {
                        <span>Thời Trang @currentGender Cao Cấp</span>
                    }
                    else
                    {
                        <span>Tất Cả Sản Phẩm Cho Bé Yêu</span>
                    }
                </h1>
                <p>Khám phá <strong>@totalItems</strong> thiết kế chất liệu 100% Organic an toàn cho da bé, phom dáng chuẩn mực và bền đẹp.</p>
            </div>
            <div class="col-12 col-md-4 text-md-end">
                <button type="button" class="btn btn-baby-primary" data-bs-toggle="modal" data-bs-target="#sizeGuideModal">
                    <i class="bi bi-rulers me-1"></i> Bảng Đo Size Chuẩn
                </button>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Filter Sidebar -->
        <div class="col-12 col-lg-3">
            <div class="baby-filter-card">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="baby-filter-title m-0"><i class="bi bi-sliders text-muted"></i> Bộ Lọc</span>
                    <a asp-controller="Product" asp-action="Index" class="small text-muted text-decoration-none">Xóa lọc</a>
                </div>

                <form method="get" asp-controller="Product" asp-action="Index">
                    @if (!string.IsNullOrEmpty(currentSearch))
                    {
                        <input type="hidden" name="search" value="@currentSearch" />
                    }

                    <!-- Gender Filter -->
                    <div class="mb-4">
                        <label class="fw-bold small text-uppercase text-muted mb-2">Đối tượng / Giới tính</label>
                        <div class="d-flex flex-column gap-1">
                            <a asp-controller="Product" asp-action="Index" asp-route-category="@currentCategory" asp-route-ageRange="@currentAgeRange"
                               class="baby-filter-link @(string.IsNullOrEmpty(currentGender) ? "active" : "")">
                                <span>Tất cả bé</span>
                                <i class="bi bi-chevron-right small text-muted"></i>
                            </a>
                            <a asp-controller="Product" asp-action="Index" asp-route-gender="Bé gái" asp-route-category="@currentCategory" asp-route-ageRange="@currentAgeRange"
                               class="baby-filter-link @(currentGender == "Bé gái" ? "active" : "")">
                                <span>👗 Bé Gái</span>
                                <i class="bi bi-chevron-right small text-muted"></i>
                            </a>
                            <a asp-controller="Product" asp-action="Index" asp-route-gender="Bé trai" asp-route-category="@currentCategory" asp-route-ageRange="@currentAgeRange"
                               class="baby-filter-link @(currentGender == "Bé trai" ? "active" : "")">
                                <span>👕 Bé Trai</span>
                                <i class="bi bi-chevron-right small text-muted"></i>
                            </a>
                            <a asp-controller="Product" asp-action="Index" asp-route-gender="Sơ sinh" asp-route-category="@currentCategory" asp-route-ageRange="@currentAgeRange"
                               class="baby-filter-link @(currentGender == "Sơ sinh" ? "active" : "")">
                                <span>👶 Sơ Sinh (0 - 24M)</span>
                                <i class="bi bi-chevron-right small text-muted"></i>
                            </a>
                        </div>
                    </div>

                    <hr class="opacity-10 my-3" />

                    <!-- Age Range Filter -->
                    <div class="mb-4">
                        <label class="fw-bold small text-uppercase text-muted mb-2">Theo Độ Tuổi</label>
                        <div class="d-flex flex-column gap-1">
                            <a asp-controller="Product" asp-action="Index" asp-route-gender="@currentGender" asp-route-category="@currentCategory"
                               class="baby-filter-link @(string.IsNullOrEmpty(currentAgeRange) ? "active" : "")">
                                <span>Tất cả độ tuổi</span>
                                <i class="bi bi-chevron-right small text-muted"></i>
                            </a>
                            @foreach (var age in WebsiteBabyShop.Helpers.AgeRangeHelper.StandardOptions)
                            {
                                <a asp-controller="Product" asp-action="Index" asp-route-gender="@currentGender" asp-route-category="@currentCategory" asp-route-ageRange="@age"
                                   class="baby-filter-link @(currentAgeRange == age ? "active" : "")">
                                    <span>@age</span>
                                    <i class="bi bi-chevron-right small text-muted"></i>
                                </a>
                            }
                        </div>
                    </div>

                    <hr class="opacity-10 my-3" />

                    <!-- Category Filter -->
                    <div class="mb-4">
                        <label class="fw-bold small text-uppercase text-muted mb-2">Danh mục</label>
                        <div class="d-flex flex-column gap-1">
                            @foreach (var cat in categories)
                            {
                                <a asp-controller="Product" asp-action="Index" asp-route-category="@cat.Slug" asp-route-gender="@currentGender" asp-route-ageRange="@currentAgeRange"
                                   class="baby-filter-link @(currentCategory == cat.Slug ? "active" : "")">
                                    <span>@cat.Name</span>
                                    <i class="bi bi-chevron-right small text-muted"></i>
                                </a>
                            }
                        </div>
                    </div>

                    <hr class="opacity-10 my-3" />

                    <!-- Price Filter -->
                    <div class="mb-2">
                        <label class="fw-bold small text-uppercase text-muted mb-2">Khoảng giá (VNĐ)</label>
                        <div class="d-flex flex-column gap-1">
                            <a asp-controller="Product" asp-action="Index" asp-route-gender="@currentGender" asp-route-category="@currentCategory" asp-route-ageRange="@currentAgeRange" asp-route-maxPrice="200000" 
                               class="baby-filter-link">
                                <span>&le; Dưới 200.000đ</span>
                            </a>
                            <a asp-controller="Product" asp-action="Index" asp-route-gender="@currentGender" asp-route-category="@currentCategory" asp-route-ageRange="@currentAgeRange" asp-route-minPrice="200000" asp-route-maxPrice="300000" 
                               class="baby-filter-link">
                                <span>200.000đ - 300.000đ</span>
                            </a>
                            <a asp-controller="Product" asp-action="Index" asp-route-gender="@currentGender" asp-route-category="@currentCategory" asp-route-ageRange="@currentAgeRange" asp-route-minPrice="300000" 
                               class="baby-filter-link">
                                <span>&ge; Trên 300.000đ</span>
                            </a>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <!-- Product Grid Area -->
        <div class="col-12 col-lg-9">
            <!-- Sort & Quick Filter Bar -->
            <div class="bg-white p-3 rounded-4 shadow-sm border mb-4 d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div class="text-muted small">
                    @if (totalItems > 0)
                    {
                        int pSize = ViewBag.PageSize ?? 12;
                        int startItem = (currentPage - 1) * pSize + 1;
                        int endItem = Math.Min(currentPage * pSize, totalItems);
                        <span>Hiển thị <strong>@startItem - @endItem</strong> trong tổng số <strong>@totalItems</strong> sản phẩm</span>
                    }
                    else
                    {
                        <span>Không có sản phẩm nào</span>
                    }
                </div>

                <!-- Sort dropdown -->
                <div class="d-flex align-items-center gap-2">
                    <span class="small text-muted text-nowrap">Sắp xếp:</span>
                    <select class="form-select form-select-sm rounded-pill" style="min-width: 170px;" onchange="location = this.value;">
                        <option value="@GetSortUrl("")" selected="@(string.IsNullOrEmpty(currentSort))">Mới nhất</option>
                        <option value="@GetSortUrl("popular")" selected="@(currentSort == "popular")">Bán chạy nhất</option>
                        <option value="@GetSortUrl("price-asc")" selected="@(currentSort == "price-asc")">Giá tăng dần</option>
                        <option value="@GetSortUrl("price-desc")" selected="@(currentSort == "price-desc")">Giá giảm dần</option>
                    </select>
                </div>
            </div>

            <!-- Products List -->
            @if (Model.Any())
            {
                <div class="row g-3 g-md-4">
                    @foreach (var prod in Model)
                    {
                        <div class="col-6 col-md-4">
                            @await Html.PartialAsync("_ProductCard", prod)
                        </div>
                    }
                </div>

                <!-- Pagination -->
                @if (totalPages > 1)
                {
                    <nav class="mt-5" aria-label="Phân trang sản phẩm">
                        <ul class="pagination justify-content-center align-items-center gap-1">
                            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                <a class="page-link rounded-pill px-3 py-2" href="@(currentPage > 1 ? GetProductPageUrl(currentPage - 1) : "#")" aria-label="Trang trước">
                                    <i class="bi bi-chevron-left me-1"></i> Trước
                                </a>
                            </li>
                            @{
                                int startP = Math.Max(1, currentPage - 2);
                                int endP = Math.Min(totalPages, currentPage + 2);
                                if (startP > 1)
                                {
                                    <li class="page-item">
                                        <a class="page-link rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 38px; height: 38px;" href="@GetProductPageUrl(1)">1</a>
                                    </li>
                                    if (startP > 2)
                                    {
                                        <li class="page-item disabled"><span class="page-link border-0 bg-transparent">...</span></li>
                                    }
                                }
                                for (int i = startP; i <= endP; i++)
                                {
                                    <li class="page-item @(currentPage == i ? "active" : "")">
                                        <a class="page-link rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 38px; height: 38px;" href="@GetProductPageUrl(i)">@i</a>
                                    </li>
                                }
                                if (endP < totalPages)
                                {
                                    if (endP < totalPages - 1)
                                    {
                                        <li class="page-item disabled"><span class="page-link border-0 bg-transparent">...</span></li>
                                    }
                                    <li class="page-item">
                                        <a class="page-link rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 38px; height: 38px;" href="@GetProductPageUrl(totalPages)">@totalPages</a>
                                    </li>
                                }
                            }
                            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                <a class="page-link rounded-pill px-3 py-2" href="@(currentPage < totalPages ? GetProductPageUrl(currentPage + 1) : "#")" aria-label="Trang sau">
                                    Sau <i class="bi bi-chevron-right ms-1"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                }
            }
            else
            {
                <div class="text-center py-5 bg-white rounded-4 shadow-sm border p-5">
                    <div class="baby-brand-icon mx-auto mb-3" style="width: 70px; height: 70px; font-size: 2rem;">
                        <i class="bi bi-search"></i>
                    </div>
                    <h4 class="fw-bold mt-3">Chưa có sản phẩm phù hợp</h4>
                    <p class="text-muted">Mẹ hãy thử chọn tiêu chí lọc khác hoặc xem tất cả các bộ sưu tập xinh xắn khác nhé!</p>
                    <a asp-action="Index" class="btn btn-baby-primary mt-2">Xem Tất Cả Sản Phẩm</a>
                </div>
            }
        </div>
    </div>
</div>

@functions {
    string GetProductPageUrl(int targetPage)
    {
        var dict = new Dictionary<string, Microsoft.Extensions.Primitives.StringValues>();
        foreach (var kvp in Context.Request.Query)
        {
            if (!string.Equals(kvp.Key, "page", StringComparison.OrdinalIgnoreCase))
            {
                dict[kvp.Key] = kvp.Value;
            }
        }
        dict["page"] = targetPage.ToString();

        var qb = new Microsoft.AspNetCore.Http.Extensions.QueryBuilder();
        foreach (var item in dict)
        {
            foreach (var val in item.Value)
            {
                if (!string.IsNullOrEmpty(val))
                {
                    qb.Add(item.Key, val);
                }
            }
        }
        return $"{Context.Request.Path}{qb.ToQueryString()}";
    }

    string GetSortUrl(string? sortValue)
    {
        var dict = new Dictionary<string, Microsoft.Extensions.Primitives.StringValues>();
        foreach (var kvp in Context.Request.Query)
        {
            if (!string.Equals(kvp.Key, "sort", StringComparison.OrdinalIgnoreCase) && !string.Equals(kvp.Key, "page", StringComparison.OrdinalIgnoreCase))
            {
                dict[kvp.Key] = kvp.Value;
            }
        }
        if (!string.IsNullOrEmpty(sortValue))
        {
            dict["sort"] = sortValue;
        }

        var qb = new Microsoft.AspNetCore.Http.Extensions.QueryBuilder();
        foreach (var item in dict)
        {
            foreach (var val in item.Value)
            {
                if (!string.IsNullOrEmpty(val))
                {
                    qb.Add(item.Key, val);
                }
            }
        }
        return $"{Context.Request.Path}{qb.ToQueryString()}";
    }
}

