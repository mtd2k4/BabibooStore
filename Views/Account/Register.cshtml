@model WebsiteBabyShop.Models.RegisterViewModel
@{
    ViewData["Title"] = "Đăng Ký Tài Khoản - BabyShop";
    var returnUrl = ViewData["ReturnUrl"] as string;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="bg-white rounded-4 shadow-sm border p-4 p-md-5">
                <div class="text-center mb-4">
                    <div class="baby-brand-icon mx-auto mb-3" style="width: 58px; height: 58px; font-size: 1.6rem; border-radius: var(--radius-md);">
                        <i class="bi bi-person-plus"></i>
                    </div>
                    <h3 class="fw-bold">Tạo Tài Khoản Mới</h3>
                    <p class="text-muted small">Đăng ký thành viên để nhận voucher và đổi size tận nhà dễ dàng từ BabyShop</p>
                </div>

                <form asp-action="Register" asp-route-returnUrl="@returnUrl" method="post" onsubmit="sessionStorage.clear();">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small rounded-3" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label asp-for="Username" class="form-label fw-bold small">
                                Tên đăng nhập <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Username" class="form-control rounded-3" placeholder="Tên đăng nhập (từ 3 ký tự)" required />
                            <span asp-validation-for="Username" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="FullName" class="form-label fw-bold small">
                                Họ và tên <span class="text-danger">*</span>
                            </label>
                            <input asp-for="FullName" class="form-control rounded-3" placeholder="Ví dụ: Nguyễn Thị Hoa" required />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="Email" class="form-label fw-bold small">
                                Email <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Email" type="email" class="form-control rounded-3" placeholder="email@gmail.com" required />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="PhoneNumber" class="form-label fw-bold small">
                                Số điện thoại <span class="text-danger">*</span>
                            </label>
                            <input asp-for="PhoneNumber" class="form-control rounded-3" placeholder="0912345678" required />
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label asp-for="Address" class="form-label fw-bold small mb-0">Địa chỉ nhận hàng</label>
                                <span class="badge bg-light text-muted border small"><i class="bi bi-info-circle me-1"></i>Có thể bỏ qua</span>
                            </div>
                            <input asp-for="Address" class="form-control rounded-3" placeholder="Số nhà, tên đường, Phường/Xã, Quận/Huyện, Tỉnh/TP (Không bắt buộc)" />
                            <div class="form-text text-muted small mt-1">
                                <i class="bi bi-shield-check text-success me-1"></i>Bạn có thể bỏ qua mục này khi đăng ký. Hệ thống sẽ tự động lưu địa chỉ làm mặc định khi bạn đặt hàng lần đầu.
                            </div>
                            <span asp-validation-for="Address" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="Password" class="form-label fw-bold small">
                                Mật khẩu <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Password" type="password" class="form-control rounded-3" placeholder="Tối thiểu 6 ký tự" required />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="ConfirmPassword" class="form-label fw-bold small">
                                Xác nhận mật khẩu <span class="text-danger">*</span>
                            </label>
                            <input asp-for="ConfirmPassword" type="password" class="form-control rounded-3" placeholder="Nhập lại mật khẩu" required />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-baby-primary w-100 justify-content-center py-2 fs-6 my-4">
                        HOÀN TẤT ĐĂNG KÝ
                    </button>

                    <div class="text-center small text-muted">
                        Đã có tài khoản? <a asp-action="Login" asp-route-returnUrl="@returnUrl" class="text-primary fw-bold">Đăng nhập</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
