@model List<WebsiteBabyShop.Models.Order>
@{
    ViewData["Title"] = "Đơn Hàng Của Tôi - BabyShop";
}

<div class="container py-3 py-md-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index"><i class="bi bi-house"></i> Trang Chủ</a></li>
            <li class="breadcrumb-item active" aria-current="page">Lịch Sử Mua Hàng</li>
        </ol>
    </nav>

    <h2 class="fw-bold mb-4"><i class="bi bi-bag-check text-primary me-2"></i>Lịch Sử Mua Hàng Của Bạn</h2>

    @if (Model.Any())
    {
        <div class="d-flex flex-column gap-4">
            @foreach (var order in Model)
            {
                <div class="bg-white rounded-4 shadow-sm border p-4">
                    <div class="d-flex flex-wrap justify-content-between align-items-center pb-3 border-bottom mb-3 gap-2">
                        <div>
                            <span class="text-muted small">Mã đơn:</span>
                            <strong class="fs-6 ms-1 text-primary">@order.OrderCode</strong>
                            <span class="text-muted small ms-3"><i class="bi bi-clock"></i> @order.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                        </div>
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            @if (order.OrderStatus == "Pending")
                            {
                                <span class="badge bg-warning-subtle text-warning-emphasis px-3 py-2 rounded-pill">Đang chờ xác nhận</span>
                                <span class="badge bg-light text-muted border px-2 py-1 small"><i class="bi bi-clock me-1"></i>Tích +@(((int)(order.TotalAmount / 1000m)).ToString("N0")) pts khi hoàn tất</span>
                            }
                            else if (order.OrderStatus == "Processing")
                            {
                                <span class="badge bg-info-subtle text-info-emphasis px-3 py-2 rounded-pill">Đang chuẩn bị hàng</span>
                                <span class="badge bg-light text-muted border px-2 py-1 small"><i class="bi bi-clock me-1"></i>Tích +@(((int)(order.TotalAmount / 1000m)).ToString("N0")) pts khi hoàn tất</span>
                            }
                            else if (order.OrderStatus == "Shipping")
                            {
                                <span class="badge bg-primary-subtle text-primary px-3 py-2 rounded-pill">Đang giao hàng</span>
                                <span class="badge bg-light text-muted border px-2 py-1 small"><i class="bi bi-clock me-1"></i>Tích +@(((int)(order.TotalAmount / 1000m)).ToString("N0")) pts khi hoàn tất</span>
                            }
                            else if (order.OrderStatus == "Completed")
                            {
                                <span class="badge bg-success-subtle text-success px-3 py-2 rounded-pill">Đã hoàn thành</span>
                                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2 py-1 small fw-bold"><i class="bi bi-star-fill text-warning me-1"></i>+@(((int)(order.TotalAmount / 1000m)).ToString("N0")) pts Baby Club</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary px-3 py-2 rounded-pill">@order.OrderStatus</span>
                            }
                        </div>
                    </div>

                    <!-- Items -->
                    <div class="row g-3 mb-3">
                        @foreach (var item in order.OrderDetails)
                        {
                            <div class="col-12 col-md-6">
                                <div class="d-flex align-items-center gap-3">
                                    <img src="@(string.IsNullOrEmpty(item.ProductImage) ? "https://images.unsplash.com/photo-1622290291468-a28f7a7dc6a8?auto=format&fit=crop&w=100&q=80" : item.ProductImage)" 
                                         alt="@item.ProductName" class="rounded-3" style="width: 55px; height: 55px; object-fit: cover;" />
                                    <div class="small">
                                        <div class="fw-bold">@item.ProductName</div>
                                        <div class="text-muted">Size: @(item.Size ?? "-") | Màu: @(item.Color ?? "-")</div>
                                        <div>@item.Quantity &times; @item.UnitPrice.ToString("N0") đ</div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="d-flex flex-wrap justify-content-between align-items-center pt-3 border-top gap-2">
                        <div class="small text-muted">
                            <div><i class="bi bi-geo-alt"></i> Giao tới: @order.ShippingAddress</div>
                            <div><i class="bi bi-wallet2"></i> Thanh toán: @(order.PaymentMethod == "COD" ? "Thanh toán khi nhận hàng (COD)" : "Chuyển khoản ngân hàng")</div>
                        </div>
                        <div class="text-end">
                            <span class="text-muted small">Tổng thanh toán: </span>
                            <strong class="fs-5 text-dark">@order.TotalAmount.ToString("N0") đ</strong>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5 bg-white rounded-4 shadow-sm border p-5">
            <div class="baby-brand-icon mx-auto mb-3" style="width: 70px; height: 70px; font-size: 2rem;">
                <i class="bi bi-bag"></i>
            </div>
            <h4 class="fw-bold">Bạn chưa có đơn hàng nào</h4>
            <p class="text-muted">Các bộ sưu tập mới nhất của BabyShop đang có nhiều ưu đãi hấp dẫn đang chờ mẹ khám phá!</p>
            <a asp-controller="Product" asp-action="Index" class="btn btn-baby-primary mt-2">
                <i class="bi bi-cart-plus me-1"></i> Khám Phá Sản Phẩm Ngay
            </a>
        </div>
    }
</div>
