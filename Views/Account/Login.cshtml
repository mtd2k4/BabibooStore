@model WebsiteBabyShop.Models.LoginViewModel
@{
    ViewData["Title"] = "Đăng Nhập Tài Khoản - BabyShop";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-6 col-lg-5">
            <div class="bg-white rounded-4 shadow-sm border p-4 p-md-5">
                <div class="text-center mb-4">
                    <div class="baby-brand-icon mx-auto mb-3" style="width: 58px; height: 58px; font-size: 1.6rem; border-radius: var(--radius-md);">
                        <i class="bi bi-stars"></i>
                    </div>
                    <h3 class="fw-bold">Đăng Nhập</h3>
                    <p class="text-muted small">Chào mừng mẹ quay lại mua sắm đồ xinh cho bé tại BabyShop</p>
                </div>

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger rounded-3 small d-flex align-items-center mb-3 border-0 shadow-sm" role="alert">
                        <i class="bi bi-exclamation-triangle-fill fs-5 me-2 text-danger"></i>
                        <div>@TempData["ErrorMessage"]</div>
                    </div>
                }

                @if (TempData["InfoMessage"] != null)
                {
                    <div class="alert alert-info rounded-3 small d-flex align-items-center mb-3 border-0 shadow-sm" style="background-color: #e8f4fd; color: #0c5460;" role="alert">
                        <i class="bi bi-info-circle-fill fs-5 me-2 text-primary"></i>
                        <div>@TempData["InfoMessage"]</div>
                    </div>
                }

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success rounded-3 small d-flex align-items-center mb-3 border-0 shadow-sm" role="alert">
                        <i class="bi bi-check-circle-fill fs-5 me-2 text-success"></i>
                        <div>@TempData["SuccessMessage"]</div>
                    </div>
                }

                <form asp-action="Login" method="post" onsubmit="sessionStorage.clear();">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ReturnUrl" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small rounded-3" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Username" class="form-label fw-bold small"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="bi bi-person text-muted"></i></span>
                            <input asp-for="Username" class="form-control border-start-0" placeholder="Nhập tên đăng nhập" required />
                        </div>
                        <span asp-validation-for="Username" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-bold small"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="bi bi-lock text-muted"></i></span>
                            <input asp-for="Password" type="password" class="form-control border-start-0" placeholder="Nhập mật khẩu" required />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-4 small">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" asp-for="RememberMe" id="rememberMe">
                            <label class="form-check-label text-muted" for="rememberMe">
                                Ghi nhớ đăng nhập
                            </label>
                        </div>
                        <a href="#" class="text-muted text-decoration-none">Quên mật khẩu?</a>
                    </div>

                    <button type="submit" class="btn btn-baby-primary w-100 justify-content-center py-2 fs-6 mb-3">
                        ĐĂNG NHẬP
                    </button>

                    <!-- Hint for default accounts -->
                    <div class="alert alert-light border rounded-3 small mb-3">
                        <strong>Tài khoản mẫu:</strong><br />
                        • Admin: <code>admin</code> / <code>Admin@123456</code><br />
                        • Khách hàng: <code>khachhang</code> / <code>123456</code>
                    </div>

                    <div class="text-center small text-muted">
                        Chưa có tài khoản? <a asp-action="Register" asp-route-returnUrl="@Model.ReturnUrl" class="text-primary fw-bold">Đăng ký ngay</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
