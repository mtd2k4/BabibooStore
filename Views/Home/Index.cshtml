@model WebsiteBabyShop.Models.HomeViewModel
@{
    ViewData["Title"] = "Trang Chủ - Thời Trang Trẻ Em Thiết Kế & Cao Cấp - BabyShop";
    var activeCoupons = ViewBag.ActiveCoupons as List<WebsiteBabyShop.Models.Coupon> ?? new List<WebsiteBabyShop.Models.Coupon>();
    var userCollectedCouponIds = ViewBag.UserCollectedCouponIds as HashSet<int> ?? new HashSet<int>();
}

<!-- 1. Editorial Lookbook Hero Section -->
<section class="py-3 py-md-4">
    <div class="container">
        <div id="babyHeroCarousel" class="carousel slide" data-bs-ride="carousel">
            <div class="carousel-indicators">
                <button type="button" data-bs-target="#babyHeroCarousel" data-bs-slide-to="0" class="active" aria-current="true"></button>
                <button type="button" data-bs-target="#babyHeroCarousel" data-bs-slide-to="1"></button>
            </div>
            <div class="carousel-inner rounded-4 overflow-hidden shadow-sm border">
                <!-- Slide 1 -->
                <div class="carousel-item active">
                    <div class="baby-hero-slide">
                        <div class="row align-items-center g-0">
                            <div class="col-12 col-md-7">
                                <div class="baby-hero-content">
                                    <span class="baby-hero-tag">
                                        <i class="bi bi-stars"></i> Bộ Sưu Tập Mới 2026
                                    </span>
                                    <h1 class="baby-hero-title">
                                        Tự Do Vận Động, <br />
                                        <span>Êm Ái Cho Bé Yêu</span>
                                    </h1>
                                    <p class="baby-hero-desc">
                                        Chất liệu 100% Cotton Organic tự nhiên, mềm mại và an toàn tuyệt đối cho làn da nhạy cảm. Thiết kế tối giản, tinh tế cho bé luôn thoải mái khám phá.
                                    </p>
                                    <div class="d-flex flex-wrap gap-2 gap-sm-3">
                                        <a asp-controller="Product" asp-action="Index" asp-route-gender="Bé gái" class="btn btn-baby-primary">
                                            Đồ Bé Gái
                                        </a>
                                        <a asp-controller="Product" asp-action="Index" asp-route-gender="Bé trai" class="btn btn-baby-outline">
                                            Đồ Bé Trai
                                        </a>
                                        <a asp-controller="Product" asp-action="Index" asp-route-gender="Sơ sinh" class="btn btn-baby-outline">
                                            Đồ Sơ Sinh
                                        </a>
                                    </div>
                                </div>
                            </div>
                            <div class="col-12 col-md-5 d-none d-md-block p-4">
                                <div class="rounded-4 overflow-hidden shadow-sm" style="aspect-ratio: 4/3;">
                                    <img src="https://images.unsplash.com/photo-1622290291468-a28f7a7dc6a8?auto=format&fit=crop&w=800&q=80" 
                                         alt="BabyShop Kids Collection" class="w-100 h-100 object-fit-cover" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Slide 2 -->
                <div class="carousel-item">
                    <div class="baby-hero-slide" style="background: linear-gradient(135deg, #F5EDE4 0%, #EFE5D8 100%);">
                        <div class="row align-items-center g-0">
                            <div class="col-12 col-md-7">
                                <div class="baby-hero-content">
                                    <span class="baby-hero-tag" style="background: var(--baby-rose-light); color: var(--baby-rose); border-color: #F5D6D8;">
                                        <i class="bi bi-tag-fill"></i> Ưu Đãi Mùa Này
                                    </span>
                                    <h1 class="baby-hero-title">
                                        Set Đồ Đi Chơi <br />
                                        <span>Ưu Đãi Đến 30%</span>
                                    </h1>
                                    <p class="baby-hero-desc">
                                        Cơ hội sắm những set đồ xinh xắn, chuẩn phong cách Hàn Quốc cho bé với mức giá nhẹ nhàng. Miễn phí giao hàng toàn quốc từ 300.000đ.
                                    </p>
                                    <div class="d-flex flex-wrap gap-2 gap-sm-3">
                                        <a asp-controller="Product" asp-action="Index" asp-route-isSale="true" class="btn btn-baby-primary">
                                            Khám Phá Ưu Đãi &rarr;
                                        </a>
                                    </div>
                                </div>
                            </div>
                            <div class="col-12 col-md-5 d-none d-md-block p-4">
                                <div class="rounded-4 overflow-hidden shadow-sm" style="aspect-ratio: 4/3;">
                                    <img src="https://images.unsplash.com/photo-1519689680058-324335c77eba?auto=format&fit=crop&w=800&q=80" 
                                         alt="BabyShop Boy Collection" class="w-100 h-100 object-fit-cover" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <button class="carousel-control-prev" type="button" data-bs-target="#babyHeroCarousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon p-3 rounded-circle bg-dark bg-opacity-25" aria-hidden="true"></span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#babyHeroCarousel" data-bs-slide="next">
                <span class="carousel-control-next-icon p-3 rounded-circle bg-dark bg-opacity-25" aria-hidden="true"></span>
            </button>
        </div>
    </div>
</section>

<!-- 2. Quick Category Cards -->
<section class="py-3 py-md-4">
    <div class="container">
        <div class="row g-2 g-md-3 justify-content-center">
            <div class="col-4 col-sm-3 col-md-2">
                <a asp-controller="Product" asp-action="Index" asp-route-gender="Bé gái" class="baby-cat-pill-card">
                    <div class="baby-cat-thumb">
                        <img src="https://images.unsplash.com/photo-1622290291468-a28f7a7dc6a8?auto=format&fit=crop&w=200&q=80" alt="Đầm bé gái" />
                    </div>
                    <span class="baby-cat-name">Đầm Bé Gái</span>
                </a>
            </div>
            <div class="col-4 col-sm-3 col-md-2">
                <a asp-controller="Product" asp-action="Index" asp-route-gender="Bé trai" class="baby-cat-pill-card">
                    <div class="baby-cat-thumb">
                        <img src="https://images.unsplash.com/photo-1519689680058-324335c77eba?auto=format&fit=crop&w=200&q=80" alt="Yếm bé trai" />
                    </div>
                    <span class="baby-cat-name">Yếm Bé Trai</span>
                </a>
            </div>
            <div class="col-4 col-sm-3 col-md-2">
                <a asp-controller="Product" asp-action="Index" asp-route-gender="Sơ sinh" class="baby-cat-pill-card">
                    <div class="baby-cat-thumb">
                        <img src="https://images.unsplash.com/photo-1515488042361-ee00e0ddd4e4?auto=format&fit=crop&w=200&q=80" alt="Đồ sơ sinh" />
                    </div>
                    <span class="baby-cat-name">Đồ Sơ Sinh</span>
                </a>
            </div>
            <div class="col-4 col-sm-3 col-md-2">
                <a asp-controller="Product" asp-action="Index" asp-route-category="phu-kien-giay-dep" class="baby-cat-pill-card">
                    <div class="baby-cat-thumb">
                        <img src="https://images.unsplash.com/photo-1522337360788-8b13dee7a37e?auto=format&fit=crop&w=200&q=80" alt="Giày dép" />
                    </div>
                    <span class="baby-cat-name">Giày Dép</span>
                </a>
            </div>
            <div class="col-4 col-sm-3 col-md-2">
                <a asp-controller="Product" asp-action="Index" asp-route-isNew="true" class="baby-cat-pill-card">
                    <div class="baby-cat-thumb">
                        <img src="https://images.unsplash.com/photo-1503944583220-79d8926ad5e2?auto=format&fit=crop&w=200&q=80" alt="Hàng mới" />
                    </div>
                    <span class="baby-cat-name">Hàng Mới</span>
                </a>
            </div>
            <div class="col-4 col-sm-3 col-md-2">
                <a asp-controller="Product" asp-action="Index" asp-route-isSale="true" class="baby-cat-pill-card">
                    <div class="baby-cat-thumb">
                        <img src="https://images.unsplash.com/photo-1522771739844-6a9f6d5f14af?auto=format&fit=crop&w=200&q=80" alt="Ưu đãi" />
                    </div>
                    <span class="baby-cat-name">Ưu Đãi Hot</span>
                </a>
            </div>
        </div>
    </div>
</section>

<!-- 2.5. Hộp Quà 12H - Dành Riêng Cho Bạn -->
<section class="py-2 py-md-3">
    <div class="container">
        <div class="baby-foryou-banner">
            <div class="row align-items-center g-3">
                <div class="col-auto">
                    <div class="baby-gift-box-wrapper">
                        <i class="bi bi-gift-fill"></i>
                    </div>
                </div>
                <div class="col">
                    <div class="baby-foryou-tag mb-1">
                        <i class="bi bi-stars"></i> Độc Quyền Baby Club • 12H Nhận 1 Lần
                    </div>
                    <h4 class="baby-foryou-title">🎁 Hộp Quà May Mắn 12H - Trúng Voucher Bất Ngờ</h4>
                    <p class="baby-foryou-desc">
                        Cứ mỗi 12 tiếng, mẹ nhận ngay 1 voucher ngẫu nhiên cực sốc (lên đến 35% hoặc 100K)! Mã áp dụng 1 lần duy nhất khi đặt hàng!
                    </p>
                    <div id="forYouActiveNotice" class="mt-2 text-success small fw-bold" style="display: none;">
                        <i class="bi bi-check-circle-fill me-1"></i>Mã may mắn hiện tại: <span id="forYouActiveCode" class="font-monospace text-danger bg-white px-2 py-05 rounded border"></span> - <span id="forYouActiveDesc"></span>
                    </div>
                </div>
                <div class="col-12 col-lg-auto d-flex flex-wrap align-items-center gap-3">
                    <div class="d-flex flex-column align-items-start align-items-lg-end">
                        <span class="small fw-bold text-dark mb-1" id="forYouTimerLabel">Lượt mở quà tiếp theo sau:</span>
                        <div class="baby-foryou-countdown">
                            <div class="baby-countdown-block">
                                <span class="baby-countdown-num" id="forYouHour">12</span>
                                <span class="baby-countdown-lbl">Giờ</span>
                            </div>
                            <span class="baby-countdown-colon">:</span>
                            <div class="baby-countdown-block">
                                <span class="baby-countdown-num" id="forYouMin">00</span>
                                <span class="baby-countdown-lbl">Phút</span>
                            </div>
                            <span class="baby-countdown-colon">:</span>
                            <div class="baby-countdown-block">
                                <span class="baby-countdown-num" id="forYouSec">00</span>
                                <span class="baby-countdown-lbl">Giây</span>
                            </div>
                        </div>
                    </div>
                    <div>
                        <button type="button" id="btnClaimForYou" class="btn-foryou-claim" onclick="handleClaimForYou()">
                            <i class="bi bi-box2-heart-fill"></i>
                            <span id="btnClaimForYouText">Mở Quà 12H</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- 2.6. Săn Mã Giờ Vàng - Khung Giờ Mở Thưởng -->
<section class="py-2 py-md-3">
    <div class="container">
        <div class="baby-flashhunt-teaser-banner p-3 p-md-4 rounded-4 shadow-sm border position-relative overflow-hidden">
            <div class="row align-items-center g-3">
                <div class="col-12 col-md-8">
                    <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill bg-danger bg-opacity-10 text-danger small fw-bold mb-2">
                        <i class="bi bi-lightning-charge-fill"></i> SỰ KIỆN SĂN MÃ HOT
                    </div>
                    <h4 class="fw-bold text-dark mb-1">⚡ Săn Mã Giảm Giá - Khung Giờ Vàng</h4>
                    <p class="text-muted small mb-0">
                        Mã giảm giá cực sốc được nạp sẵn vào Kho Voucher của mọi tài khoản. Canh đúng giờ mở để kích hoạt áp dụng đơn hàng nhé mẹ!
                    </p>
                </div>
                <div class="col-12 col-md-4 text-md-end">
                    <a asp-controller="Account" asp-action="MyVouchers" class="btn btn-baby-primary rounded-pill px-4 py-2 fw-bold shadow-sm">
                        <i class="bi bi-ticket-perforated-fill me-1"></i>Vào Kho Săn Mã &rarr;
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- 3. Flash Deals Section -->
@{
    var flashList = Model.FlashSaleProducts.Any() ? Model.FlashSaleProducts : Model.FeaturedProducts.Take(4).ToList();
}
@if (flashList.Any())
{
    <section class="py-4">
        <div class="container">
            <div class="baby-flash-box">
                <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="baby-brand-icon" style="background: linear-gradient(135deg, #ff416c, #ff4b2b); color: white;">
                            <i class="bi bi-lightning-charge-fill"></i>
                        </div>
                        <div>
                            <div class="d-flex align-items-center gap-2">
                                <h3 class="fw-bold mb-0">Flash Sale Giờ Vàng</h3>
                                @if (Model.FlashSaleProducts.Any())
                                {
                                    <span class="badge bg-danger text-white rounded-pill pulse-badge">Đang diễn ra</span>
                                }
                            </div>
                            <span class="small text-muted">Săn đồ hiệu cho bé giá sốc - Số lượng có hạn kết thúc sau:</span>
                        </div>
                    </div>

                    <!-- Countdown Timer -->
                    <div class="baby-countdown-wrap">
                        <div class="baby-countdown-box" id="flashHour">02</div>
                        <span class="baby-countdown-colon">:</span>
                        <div class="baby-countdown-box" id="flashMin">30</div>
                        <span class="baby-countdown-colon">:</span>
                        <div class="baby-countdown-box" id="flashSec">45</div>
                    </div>
                </div>

                <!-- Products Grid -->
                <div class="row g-3 g-md-4">
                    @foreach (var prod in flashList.Take(4))
                    {
                        <div class="col-6 col-md-3">
                            @await Html.PartialAsync("_ProductCard", prod)
                        </div>
                    }
                </div>
            </div>
        </div>
    </section>
}

<!-- 4. Curated Collection: Bé Gái Tỏa Sáng -->
@if (Model.GirlProducts.Any())
{
    <section class="py-4">
        <div class="container">
            <div class="baby-section-header">
                <div>
                    <span class="baby-section-tag">Dành Riêng Cho Bé Gái</span>
                    <h2 class="baby-section-title">Váy Xinh & Đồ Bộ Dịu Dàng</h2>
                </div>
                <a asp-controller="Product" asp-action="Index" asp-route-gender="Bé gái" class="baby-section-link">
                    Xem tất cả <i class="bi bi-arrow-right"></i>
                </a>
            </div>

            <div class="row g-3 g-md-4">
                @foreach (var prod in Model.GirlProducts.Take(4))
                {
                    <div class="col-6 col-md-3">
                        @await Html.PartialAsync("_ProductCard", prod)
                    </div>
                }
            </div>
        </div>
    </section>
}

<!-- 5. Dual Curated Lookbook Banners -->
<section class="py-3">
    <div class="container">
        <div class="row g-3 g-md-4">
            <div class="col-12 col-md-6">
                <div class="p-4 p-md-5 rounded-4 border h-100 d-flex flex-column justify-content-between" style="background: linear-gradient(135deg, #FBF8F4 0%, #F5EDE4 100%);">
                    <div>
                        <span class="badge bg-white text-muted border px-3 py-1 rounded-pill small mb-3">Mùa hè năng động</span>
                        <h3 class="fw-bold mb-2">Trang Phục Dạo Phố Bé Trai</h3>
                        <p class="text-muted small mb-4">Polo cotton dệt tổ ong thoáng khí, kết hợp quần kaki mềm mại cho bé thoải mái chạy nhảy cả ngày.</p>
                    </div>
                    <div>
                        <a asp-controller="Product" asp-action="Index" asp-route-gender="Bé trai" class="btn btn-baby-primary btn-sm">
                            Xem Bộ Sưu Tập &rarr;
                        </a>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-6">
                <div class="p-4 p-md-5 rounded-4 border h-100 d-flex flex-column justify-content-between" style="background: linear-gradient(135deg, #FAF7F2 0%, #F0E8DD 100%);">
                    <div>
                        <span class="badge bg-white text-muted border px-3 py-1 rounded-pill small mb-3">100% Organic Bamboo</span>
                        <h3 class="fw-bold mb-2">Đồ Sơ Sinh Nâng Niu Làn Da</h3>
                        <p class="text-muted small mb-4">Chất liệu sợi tre organic kháng khuẩn, đường chỉ may phẳng êm, không gây cọ xát ngứa ngáy cho trẻ sơ sinh.</p>
                    </div>
                    <div>
                        <a asp-controller="Product" asp-action="Index" asp-route-gender="Sơ sinh" class="btn btn-baby-primary btn-sm">
                            Khám Phá Ngay &rarr;
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

