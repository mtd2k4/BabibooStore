<!-- 8. Core Values & Customer Commitments -->
<section class="py-4 py-md-5 my-3">
    <div class="container">
        <div class="row g-3 g-md-4">
            <div class="col-6 col-lg-3">
                <div class="baby-service-card">
                    <div class="baby-service-icon">
                        <i class="bi bi-shield-check"></i>
                    </div>
                    <h5>100% Vải An Toàn</h5>
                    <p>Đạt tiêu chuẩn Oeko-Tex Standard 100 quốc tế, mềm mại với da bé.</p>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="baby-service-card">
                    <div class="baby-service-icon" style="background: var(--baby-sage-light); color: var(--baby-sage);">
                        <i class="bi bi-arrow-repeat"></i>
                    </div>
                    <h5>Đổi Hàng Tận Nhà</h5>
                    <p>Hỗ trợ đổi size trong 7 ngày, shipper tới tận nhà thu hàng tiện lợi.</p>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="baby-service-card">
                    <div class="baby-service-icon" style="background: var(--baby-rose-light); color: var(--baby-rose);">
                        <i class="bi bi-truck"></i>
                    </div>
                    <h5>Freeship Từ 300K</h5>
                    <p>Miễn phí giao hàng toàn quốc cho đơn hàng từ 300.000đ.</p>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="baby-service-card">
                    <div class="baby-service-icon" style="background: var(--baby-sand-light); color: var(--baby-primary);">
                        <i class="bi bi-box-seam"></i>
                    </div>
                    <h5>Đồng Kiểm Nhận Hàng</h5>
                    <p>Mẹ được kiểm tra đồ xinh cho bé trước khi thanh toán cho shipper.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Floating Gift / Promo Announcement Button -->
<a href="javascript:void(0)" class="baby-home-fab" onclick="openHomePromoModal()" id="babyHomeGiftFab" title="Bấm để xem quà tặng & mã giảm giá hôm nay">
    <i class="bi bi-gift-fill fs-5 text-warning"></i>
    <span>Quà Tặng & Voucher</span>
    <span class="baby-fab-badge">Hot</span>
</a>

<!-- BabyShop Home Announcement Popup Modal -->
<div class="modal fade baby-promo-modal" id="babyHomePromoModal" tabindex="-1" aria-labelledby="babyHomePromoModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 540px;">
        <div class="modal-content">
            <!-- Header -->
            <div class="baby-promo-header">
                <button type="button" class="btn-close position-absolute top-0 end-0 m-3 shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
                <div class="baby-promo-header-badge">
                    <i class="bi bi-stars me-1"></i> ƯU ĐÃI ĐẶC QUYỀN HÔM NAY
                </div>
                <h4>Chào Mừng Mẹ & Bé Yêu! 💕</h4>
                <p>Khám phá bộ sưu tập mới & nhận ngay voucher giảm giá độc quyền</p>
            </div>

            <!-- Body -->
            <div class="modal-body p-3 p-md-4">
                <!-- Vouchers List -->
                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="small fw-bold text-dark"><i class="bi bi-ticket-perforated-fill text-danger me-1"></i>Mã Giảm Giá Dành Tặng Mẹ:</span>
                        <span class="small text-muted" style="font-size: 0.75rem;">(Mỗi tài khoản nhận 1 lần)</span>
                    </div>

                    @if (activeCoupons.Any())
                    {
                        @foreach (var c in activeCoupons)
                        {
                            bool alreadyInWallet = userCollectedCouponIds.Contains(c.Id);
                            <div class="baby-promo-ticket">
                                <div class="pe-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="baby-promo-code">@c.Code</span>
                                        <span class="badge bg-danger-subtle text-danger small fw-bold">
                                            @(c.DiscountType == WebsiteBabyShop.Models.DiscountType.Percentage ? $"Giảm {c.DiscountValue}%" : $"Giảm {c.DiscountValue:N0}đ")
                                        </span>
                                    </div>
                                    <div class="text-muted small mt-1" style="font-size: 0.78rem;">
                                        @(string.IsNullOrEmpty(c.Description) ? c.Title : c.Description)
                                    </div>
                                    <div class="text-muted small" style="font-size: 0.72rem;">
                                        <i class="bi bi-clock me-1"></i>Hạn dùng: @(c.ExpiryDate?.ToString("dd/MM/yyyy") ?? "Vô thời hạn")
                                    </div>
                                </div>
                                <div class="d-flex flex-column gap-1 align-items-end">
                                    @if (alreadyInWallet)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-success rounded-pill px-3 py-1 small fw-bold" disabled>
                                            <i class="bi bi-check2-circle me-1"></i>Đã trong kho
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-sm btn-baby-primary rounded-pill px-3 py-1 small fw-bold" onclick="collectVoucherFromHome(@c.Id, '@c.Code', this)">
                                            <i class="bi bi-download me-1"></i>Lưu vào kho
                                        </button>
                                    }
                                    <button type="button" class="btn btn-sm btn-link p-0 text-muted small text-decoration-none" onclick="BabyAlert.copy('@c.Code', 'mã voucher')" style="font-size: 0.72rem;">
                                        <i class="bi bi-clipboard me-1"></i>Chép mã
                                    </button>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="baby-promo-ticket">
                            <div class="pe-2">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="baby-promo-code">BABYNEW</span>
                                    <span class="badge bg-danger-subtle text-danger small fw-bold">Giảm 10%</span>
                                </div>
                                <div class="text-muted small mt-1" style="font-size: 0.78rem;">
                                    Giảm 10% tối đa 40k cho đơn hàng đầu tiên từ 150k
                                </div>
                            </div>
                            <div class="d-flex flex-column gap-1 align-items-end">
                                <button type="button" class="btn btn-sm btn-baby-primary rounded-pill px-3 py-1 small fw-bold" onclick="collectVoucherFromHome(0, 'BABYNEW', this)">
                                    <i class="bi bi-download me-1"></i>Lưu vào kho
                                </button>
                                <button type="button" class="btn btn-sm btn-link p-0 text-muted small text-decoration-none" onclick="BabyAlert.copy('BABYNEW', 'mã voucher')" style="font-size: 0.72rem;">
                                    <i class="bi bi-clipboard me-1"></i>Chép mã
                                </button>
                            </div>
                        </div>
                    }
                </div>

                <!-- Baby Club Reward Points Highlight -->
                <div class="p-3 rounded-3 bg-warning-subtle bg-opacity-25 border border-warning-subtle mb-3">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <div class="rounded-circle bg-warning text-dark d-flex align-items-center justify-content-center fw-bold" style="width: 26px; height: 26px; font-size: 0.8rem;">
                            <i class="bi bi-star-fill"></i>
                        </div>
                        <span class="fw-bold text-dark small">Đặc Quyền Hội Viên Baby Club:</span>
                    </div>
                    <div class="text-muted small ps-4" style="font-size: 0.8rem;">
                        Tích lũy <strong>100 điểm cho mỗi 100k</strong> chi tiêu (100 điểm = 10k giảm giá đơn tiếp theo). Hạng Kim Cương được <strong>giảm 20% trọn đời</strong>!
                    </div>
                </div>

                <!-- CTA Button -->
                <div class="d-grid gap-2">
                    <a asp-controller="Product" asp-action="Index" class="btn btn-baby-primary py-2 rounded-pill fw-bold text-center" onclick="closeHomePromoModal()">
                        <i class="bi bi-bag-heart-fill me-1"></i> Khám Phá Sản Phẩm Hot Ngay
                    </a>
                </div>

                <!-- Dismiss Option -->
                <div class="text-center mt-3">
                    <div class="form-check d-inline-block text-muted small" style="font-size: 0.78rem;">
                        <input class="form-check-input" type="checkbox" id="dontShowAgainTodayCheck" onchange="toggleDismissPromoToday(this.checked)">
                        <label class="form-check-label cursor-pointer" for="dontShowAgainTodayCheck">
                            Không hiển thị lại thông báo này trong hôm nay
                        </label>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Real-time Flash Sale Countdown Timer
        (function() {
            var targetTime = new Date();
            targetTime.setHours(targetTime.getHours() + 8);
            targetTime.setMinutes(targetTime.getMinutes() + 45);

            function updateTimer() {
                var now = new Date().getTime();
                var diff = targetTime.getTime() - now;

                if (diff <= 0) {
                    targetTime = new Date();
                    targetTime.setHours(targetTime.getHours() + 12);
                    diff = targetTime.getTime() - now;
                }

                var hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                var minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
                var seconds = Math.floor((diff % (1000 * 60)) / 1000);

                var elH = document.getElementById('flashHour');
                var elM = document.getElementById('flashMin');
                var elS = document.getElementById('flashSec');

                if (elH) elH.textContent = String(hours).padStart(2, '0');
                if (elM) elM.textContent = String(minutes).padStart(2, '0');
                if (elS) elS.textContent = String(seconds).padStart(2, '0');
            }

            updateTimer();
            setInterval(updateTimer, 1000);
        })();

        // Home Announcement Popup Logic
        function openHomePromoModal() {
            var el = document.getElementById('babyHomePromoModal');
            if (el && window.bootstrap) {
                var modal = bootstrap.Modal.getInstance(el) || new bootstrap.Modal(el);
                modal.show();
            }
        }

        function closeHomePromoModal() {
            var el = document.getElementById('babyHomePromoModal');
            if (el && window.bootstrap) {
                var modal = bootstrap.Modal.getInstance(el);
                if (modal) modal.hide();
            }
        }

        function toggleDismissPromoToday(checked) {
            var today = new Date().toISOString().slice(0, 10);
            if (checked) {
                localStorage.setItem('babyshop_hide_home_popup_date', today);
                if (window.BabyAlert) {
                    BabyAlert.toast('Đã lưu tùy chọn không hiện lại hôm nay ✨', 'info');
                }
            } else {
                localStorage.removeItem('babyshop_hide_home_popup_date');
            }
        }

        function collectVoucherFromHome(couponId, couponCode, btnElem) {
            if (!couponId && !couponCode) return;

            var originalHtml = btnElem ? btnElem.innerHTML : '';
            if (btnElem) {
                btnElem.disabled = true;
                btnElem.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Lưu...';
            }

            fetch('/Account/CollectCouponAjax', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ couponId: couponId || 0, couponCode: couponCode || '' })
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    BabyAlert.success('Đã Lưu Vào Kho Voucher! 🎁', data.message);
                    if (btnElem) {
                        btnElem.className = 'btn btn-sm btn-outline-success rounded-pill px-3 py-1 small fw-bold';
                        btnElem.innerHTML = '<i class="bi bi-check2-circle me-1"></i>Đã trong kho';
                        btnElem.disabled = true;
                    }
                } else {
                    if (data.requiresLogin) {
                        BabyAlert.confirm('Đăng Nhập Nhận Quà', data.message, 'Đăng nhập ngay').then(r => {
                            if (r.isConfirmed) {
                                window.location.href = '/Account/Login?returnUrl=' + encodeURIComponent(window.location.pathname);
                            }
                        });
                    } else if (data.alreadyCollected) {
                        BabyAlert.error('Đã Nhận Mã Này', data.message);
                        if (btnElem) {
                            btnElem.className = 'btn btn-sm btn-outline-success rounded-pill px-3 py-1 small fw-bold';
                            btnElem.innerHTML = '<i class="bi bi-check2-circle me-1"></i>Đã trong kho';
                            btnElem.disabled = true;
                        }
                    } else {
                        BabyAlert.error('Thông Báo', data.message);
                    }
                    if (btnElem && !data.alreadyCollected) {
                        btnElem.disabled = false;
                        btnElem.innerHTML = originalHtml;
                    }
                }
            })
            .catch(err => {
                console.error(err);
                BabyAlert.error('Lỗi', 'Không thể kết nối máy chủ để lưu mã giảm giá.');
                if (btnElem) {
                    btnElem.disabled = false;
                    btnElem.innerHTML = originalHtml;
                }
            });
        }

        // Tính Năng "Dành Cho Bạn" 12H
        var forYouTimerInterval = null;
        var forYouRemainingSeconds = 0;
        var forYouCanClaim = false;
        var forYouIsAuth = false;

        function formatTwoDigits(n) {
            return String(Math.floor(n)).padStart(2, '0');
        }

        function updateForYouDisplay() {
            var h = Math.floor(forYouRemainingSeconds / 3600);
            var m = Math.floor((forYouRemainingSeconds % 3600) / 60);
            var s = Math.floor(forYouRemainingSeconds % 60);

            var elH = document.getElementById('forYouHour');
            var elM = document.getElementById('forYouMin');
            var elS = document.getElementById('forYouSec');
            if (elH) elH.textContent = formatTwoDigits(h);
            if (elM) elM.textContent = formatTwoDigits(m);
            if (elS) elS.textContent = formatTwoDigits(s);

            var btn = document.getElementById('btnClaimForYou');
            var btnText = document.getElementById('btnClaimForYouText');
            var timerLbl = document.getElementById('forYouTimerLabel');

            if (!forYouIsAuth) {
                if (btnText) btnText.textContent = 'Đăng nhập mở quà';
                if (btn) btn.disabled = false;
                if (timerLbl) timerLbl.textContent = 'Mở quà mỗi 12 giờ:';
                return;
            }

            if (forYouCanClaim || forYouRemainingSeconds <= 0) {
                if (btn) {
                    btn.disabled = false;
                    btn.className = 'btn-foryou-claim pulse-badge';
                }
                if (btnText) btnText.innerHTML = '<i class="bi bi-stars me-1"></i>Mở Quà 12H Ngay!';
                if (timerLbl) timerLbl.textContent = 'Quà đã sẵn sàng!';
            } else {
                if (btn) {
                    btn.disabled = false;
                    btn.className = 'btn-foryou-claim opacity-75';
                }
                if (btnText) btnText.textContent = 'Đang đếm ngược...';
                if (timerLbl) timerLbl.textContent = 'Lượt mở tiếp theo sau:';
            }
        }

        function startForYouCountdown() {
            if (forYouTimerInterval) clearInterval(forYouTimerInterval);
            updateForYouDisplay();
            forYouTimerInterval = setInterval(function() {
                if (forYouRemainingSeconds > 0) {
                    forYouRemainingSeconds--;
                    updateForYouDisplay();
                } else {
                    forYouCanClaim = true;
                    updateForYouDisplay();
                }
            }, 1000);
        }

        function loadForYouStatus() {
            fetch('/Account/GetForYouStatus')
                .then(res => res.json())
                .then(data => {
                    forYouIsAuth = data.authenticated;
                    forYouCanClaim = data.canClaim;
                    forYouRemainingSeconds = data.remainingSeconds || 0;

                    if (data.currentVoucher) {
                        var noticeEl = document.getElementById('forYouActiveNotice');
                        var codeEl = document.getElementById('forYouActiveCode');
                        var descEl = document.getElementById('forYouActiveDesc');
                        if (noticeEl && codeEl && descEl) {
                            codeEl.textContent = data.currentVoucher.code;
                            descEl.textContent = data.currentVoucher.title + ' (HSD: ' + data.currentVoucher.expiryDate + ')';
                            noticeEl.style.display = 'block';
                        }
                    }
                    startForYouCountdown();
                })
                .catch(err => {
                    console.error('Lỗi tải trạng thái Dành Cho Bạn:', err);
                });
        }

        function handleClaimForYou() {
            if (!forYouIsAuth) {
                BabyAlert.confirm('Đăng Nhập Nhận Quà', 'Vui lòng đăng nhập tài khoản để mở Hộp Quà 12H Dành Riêng Cho Bạn!', 'Đăng nhập ngay')
                    .then(r => {
                        if (r.isConfirmed) {
                            window.location.href = '/Account/Login?returnUrl=' + encodeURIComponent(window.location.pathname);
                        }
                    });
                return;
            }

            if (!forYouCanClaim && forYouRemainingSeconds > 0) {
                var h = Math.floor(forYouRemainingSeconds / 3600);
                var m = Math.floor((forYouRemainingSeconds % 3600) / 60);
                var s = Math.floor(forYouRemainingSeconds % 60);
                var timeStr = formatTwoDigits(h) + ':' + formatTwoDigits(m) + ':' + formatTwoDigits(s);
                BabyAlert.toast('Hộp quà đang nạp năng lượng! Vui lòng quay lại sau ' + timeStr + ' ✨', 'info');
                return;
            }

            var btn = document.getElementById('btnClaimForYou');
            var originalHtml = btn ? btn.innerHTML : '';
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Đang mở...';
            }

            fetch('/Account/ClaimForYouVoucher', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    var rarityBadge = data.coupon.rarity 
                        ? '<span class="badge ' + (data.coupon.rarityColor || 'bg-warning text-dark') + ' px-3 py-1 rounded-pill fw-bold fs-6 mb-2">' + data.coupon.rarity + '</span>'
                        : '';
                    var discountBadge = data.coupon.displayDiscount
                        ? '<span class="badge bg-danger text-white rounded-pill px-3 py-1 fw-bold fs-6 mt-1">' + data.coupon.displayDiscount + '</span>'
                        : '';

                    Swal.fire({
                        title: '🎉 CHÚC MỪNG MẸ TRÚNG QUÀ MAY MẮN!',
                        html: '<div class="text-center py-2">' +
                                '<div class="fs-1 mb-2 animate__animated animate__bounceIn">🎁✨🎲</div>' +
                                rarityBadge +
                                '<h5 class="fw-bold text-danger mb-1 mt-1">' + data.coupon.title + '</h5>' +
                                '<p class="text-muted small mb-3">' + data.coupon.description + '</p>' +
                                '<div class="p-3 bg-light rounded-4 border mb-3 shadow-sm">' +
                                    '<span class="small text-muted d-block mb-1">Mã may mắn độc quyền dành riêng cho bạn:</span>' +
                                    '<div class="fs-3 fw-bold font-monospace text-primary">' + data.coupon.code + '</div>' +
                                    '<div class="d-flex justify-content-center align-items-center gap-2 mt-1">' +
                                        discountBadge +
                                        '<span class="small text-muted">Đơn từ: <strong>' + Number(data.coupon.minOrder || 0).toLocaleString('vi-VN') + 'đ</strong></span>' +
                                    '</div>' +
                                    '<div class="small text-muted mt-2"><i class="bi bi-clock me-1 text-primary"></i>Hiệu lực 12 giờ (Đến: <strong>' + data.coupon.expiryDate + '</strong>)</div>' +
                                '</div>' +
                                '<p class="small text-muted mb-0">Mã đã được lưu vào <a href="/Account/MyVouchers" class="text-decoration-underline text-danger fw-bold">Kho Voucher</a>. Mỗi mã áp dụng 1 lần duy nhất cho đơn hàng.</p>' +
                              '</div>',
                        icon: 'success',
                        confirmButtonText: 'Sử Dụng Ngay Khi Thanh Toán 💕',
                        confirmButtonColor: '#E65100',
                        showCancelButton: true,
                        cancelButtonText: 'Xem Kho Voucher',
                        cancelButtonColor: '#C57B57'
                    }).then(result => {
                        if (result.dismiss === Swal.DismissReason.cancel) {
                            window.location.href = '/Account/MyVouchers';
                        }
                    });
                    loadForYouStatus();
                } else {
                    if (data.requiresLogin) {
                        window.location.href = '/Account/Login?returnUrl=' + encodeURIComponent(window.location.pathname);
                    } else {
                        BabyAlert.error('Thông Báo', data.message);
                        loadForYouStatus();
                    }
                }
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = originalHtml;
                }
            })
            .catch(err => {
                console.error(err);
                BabyAlert.error('Lỗi', 'Không thể kết nối máy chủ để mở quà.');
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = originalHtml;
                }
            });
        }

        document.addEventListener('DOMContentLoaded', function() {
            var today = new Date().toISOString().slice(0, 10);
            var savedDate = localStorage.getItem('babyshop_hide_home_popup_date');
            if (savedDate !== today) {
                setTimeout(function() {
                    openHomePromoModal();
                }, 1200);
            }
            loadForYouStatus();
        });
    </script>
}
