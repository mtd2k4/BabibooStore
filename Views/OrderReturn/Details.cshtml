@model WebsiteBabyShop.Models.ReturnRequest
@{
    ViewData["Title"] = "Chi Tiết Yêu Cầu Đổi / Trả Hàng #" + Model.ReturnCode;
    var proofImages = (Model.ProofImages ?? "").Split(';', StringSplitOptions.RemoveEmptyEntries);
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted"><i class="bi bi-house"></i> Trang Chủ</a></li>
            <li class="breadcrumb-item"><a asp-controller="Account" asp-action="MyOrders" class="text-decoration-none text-muted">Đơn Hàng Của Tôi</a></li>
            <li class="breadcrumb-item active fw-bold text-dark" aria-current="page">Phiếu Đổi Trả #@Model.ReturnCode</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-12 col-lg-9">

            <!-- Card Header Trạng Thái -->
            <div class="bg-white rounded-4 border p-4 mb-4 shadow-sm">
                <div class="d-flex flex-wrap justify-content-between align-items-center pb-3 border-bottom mb-3 gap-2">
                    <div>
                        <span class="text-muted small">Mã phiếu yêu cầu:</span>
                        <h4 class="text-danger fw-bold mb-0">#@Model.ReturnCode</h4>
                        <span class="text-muted small"><i class="bi bi-clock"></i> Gửi lúc: @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                    </div>
                    <div>
                        @if (Model.Status == "Pending")
                        {
                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-3 py-2 rounded-pill fs-6">
                                <i class="bi bi-hourglass-split me-1"></i> Đang chờ Shop thẩm định
                            </span>
                        }
                        else if (Model.Status == "Approved")
                        {
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 rounded-pill fs-6">
                                <i class="bi bi-truck me-1"></i> Đã duyệt - Shipper đang đến đổi hàng
                            </span>
                        }
                        else if (Model.Status == "Completed")
                        {
                            <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill fs-6">
                                <i class="bi bi-check-circle-fill me-1"></i> Đã hoàn tất đổi / trả
                            </span>
                        }
                        else if (Model.Status == "Rejected")
                        {
                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2 rounded-pill fs-6">
                                <i class="bi bi-x-circle-fill me-1"></i> Không được duyệt
                            </span>
                        }
                    </div>
                </div>

                <!-- Phản hồi từ Shop (nếu có) -->
                @if (!string.IsNullOrWhiteSpace(Model.AdminNote))
                {
                    <div class="alert alert-info rounded-4 border-info-subtle p-3 mb-3">
                        <div class="fw-bold text-dark mb-1">
                            <i class="bi bi-chat-dots-fill text-primary me-2"></i>Phản hồi từ BabyShop CSKH:
                        </div>
                        <div class="text-dark small">@Model.AdminNote</div>
                        @if (Model.ProcessedAt.HasValue)
                        {
                            <div class="text-muted mt-1" style="font-size: 0.75rem;">Thời gian phản hồi: @Model.ProcessedAt.Value.ToString("dd/MM/yyyy HH:mm")</div>
                        }
                    </div>
                }

                <!-- Chi tiết yêu cầu -->
                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <div class="p-3 rounded-3 bg-light h-100">
                            <div class="text-muted small">Đơn hàng gốc:</div>
                            <strong class="text-dark">#@Model.Order?.OrderCode</strong>
                            <div class="text-muted small mt-2">Hình thức yêu cầu:</div>
                            <span class="badge @(Model.RequestType == "Exchange" ? "bg-success" : "bg-danger")">
                                @(Model.RequestType == "Exchange" ? "Đổi Size / Đổi Màu Sắc" : "Trả Hàng & Hoàn Tiền")
                            </span>
                            <div class="text-muted small mt-2">Nguồn gốc sự cố:</div>
                            <strong>
                                @(Model.FaultSource == "ShopFault" ? "🏪 Lỗi từ phía Shop" : (Model.FaultSource == "CarrierFault" ? "🚚 Lỗi do Vận chuyển" : "👶 Nhu cầu đổi size của bé"))
                            </strong>
                        </div>
                    </div>

                    <div class="col-12 col-md-6">
                        <div class="p-3 rounded-3 bg-light h-100">
                            <div class="text-muted small">Người yêu cầu:</div>
                            <strong class="text-dark">@Model.CustomerName</strong> (@Model.CustomerPhone)
                            <div class="text-muted small mt-2">Sản phẩm:</div>
                            <strong class="text-primary">@Model.ProductName</strong>
                            <div class="small text-muted">Đang giữ: <b>@(Model.CurrentSizeColor ?? "-")</b></div>
                            @if (!string.IsNullOrWhiteSpace(Model.DesiredSizeColor))
                            {
                                <div class="small text-success mt-1">Muốn đổi sang: <b>@Model.DesiredSizeColor</b></div>
                            }
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="p-3 rounded-3 bg-light">
                            <div class="text-muted small">Lý do chi tiết từ khách hàng:</div>
                            <div class="fw-semibold text-dark">@Model.ReasonCategory</div>
                            @if (!string.IsNullOrWhiteSpace(Model.ReasonDetail))
                            {
                                <div class="text-muted small mt-1">Ghi chú: <em>@Model.ReasonDetail</em></div>
                            }
                        </div>
                    </div>

                    @if (Model.RequestType == "Refund" && !string.IsNullOrWhiteSpace(Model.BankAccountNo))
                    {
                        <div class="col-12">
                            <div class="p-3 rounded-3 bg-danger-subtle bg-opacity-25 border border-danger-subtle">
                                <div class="fw-bold text-danger small mb-1"><i class="bi bi-bank me-1"></i>Tài khoản nhận tiền hoàn:</div>
                                <div class="small text-dark">
                                    Ngân hàng: <strong>@Model.BankName</strong> | STK: <strong class="font-monospace text-primary">@Model.BankAccountNo</strong> | Chủ TK: <strong>@Model.BankAccountName</strong>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- BẰNG CHỨNG HÌNH ẢNH & VIDEO BÓC HÀNG 100MB -->
            <div class="bg-white rounded-4 border p-4 mb-4 shadow-sm">
                <h5 class="fw-bold text-dark mb-3">
                    <i class="bi bi-camera-reels-fill text-danger me-2"></i>Bằng Chứng Đã Cung Cấp
                </h5>

                <div class="row g-4">
                    <!-- Ảnh chụp -->
                    <div class="col-12 col-md-6">
                        <h6 class="fw-bold text-dark small mb-2"><i class="bi bi-images text-primary me-1"></i> Ảnh Chụp Thực Tế (@proofImages.Length ảnh)</h6>
                        @if (proofImages.Any())
                        {
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var img in proofImages)
                                {
                                    <a href="@img" target="_blank">
                                        <img src="@img" alt="Bằng chứng đổi trả" class="rounded-3 border shadow-xs" style="width: 90px; height: 90px; object-fit: cover;" />
                                    </a>
                                }
                            </div>
                        }
                        else
                        {
                            <span class="text-muted small fst-italic">Không có ảnh đính kèm.</span>
                        }
                    </div>

                    <!-- Video bóc hàng (Unboxing Video) -->
                    <div class="col-12 col-md-6">
                        <h6 class="fw-bold text-dark small mb-2"><i class="bi bi-play-circle-fill text-danger me-1"></i> Video Bóc Hàng (Unboxing Video)</h6>
                        @if (!string.IsNullOrWhiteSpace(Model.UnboxingVideoPath))
                        {
                            <div class="rounded-3 overflow-hidden border bg-black shadow-xs">
                                <video controls class="w-100" style="max-height: 220px; object-fit: contain;">
                                    <source src="@Model.UnboxingVideoPath" />
                                    Trình duyệt của bạn không hỗ trợ phát video HTML5.
                                </video>
                            </div>
                            <div class="text-muted small mt-1">
                                <i class="bi bi-file-earmark-play me-1 text-primary"></i> Video lưu trên hệ thống (<a href="@Model.UnboxingVideoPath" target="_blank" download>Tải file về</a>)
                            </div>
                        }
                        else if (!string.IsNullOrWhiteSpace(Model.UnboxingVideoUrl))
                        {
                            <a href="@Model.UnboxingVideoUrl" target="_blank" class="btn btn-outline-danger btn-sm rounded-pill px-3">
                                <i class="bi bi-box-arrow-up-right me-1"></i> Xem Video Mở Hộp Tại Đây
                            </a>
                        }
                        else
                        {
                            <span class="text-muted small fst-italic">Chưa có video bóc hàng.</span>
                        }
                    </div>

                    <!-- Đồng kiểm -->
                    <div class="col-12">
                        <div class="small text-muted border-top pt-2">
                            <i class="bi bi-shield-check text-success me-1"></i>
                            Tình trạng đồng kiểm: <strong>@(Model.HadCarrierCoCheck ? "Đã đồng kiểm cùng bưu tá lúc nhận kiện hàng" : "Mẹ tự bóc hàng tại nhà")</strong>
                            @if (!string.IsNullOrWhiteSpace(Model.CarrierName))
                            {
                                <span class="ms-3">• Đơn vị vận chuyển: <strong>@Model.CarrierName</strong></span>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Nút điều hướng -->
            <div class="d-flex justify-content-between align-items-center">
                <a asp-controller="Account" asp-action="MyOrders" class="btn btn-outline-secondary rounded-pill px-4">
                    <i class="bi bi-arrow-left me-1"></i> Danh Sách Đơn Hàng
                </a>
                <a asp-controller="OrderReturn" asp-action="MyReturns" class="btn btn-baby-primary rounded-pill px-4">
                    <i class="bi bi-list-check me-1"></i> Lịch Sử Đổi / Trả Của Tôi
                </a>
            </div>

        </div>
    </div>
</div>
