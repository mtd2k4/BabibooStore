@{
    ViewData["Title"] = "Chính Sách Giao Hàng Toàn Quốc - BabyShop Studio Kids";
}

<!-- Breadcrumb -->
<div class="bg-light py-3 border-bottom">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">Trang Chủ</a></li>
                <li class="breadcrumb-item"><span class="text-muted">Chính Sách</span></li>
                <li class="breadcrumb-item active fw-bold text-dark" aria-current="page">Giao Hàng Toàn Quốc</li>
            </ol>
        </nav>
    </div>
</div>

<!-- Hero Banner -->
<section class="py-5" style="background: linear-gradient(135deg, #FAF7F2 0%, #EBF3EE 100%);">
    <div class="container text-center py-3">
        <span class="badge rounded-pill px-3 py-2 text-uppercase fw-bold mb-3" style="background: var(--baby-sage-light); color: var(--baby-sage); letter-spacing: 1px; font-size: 0.75rem;">
            Vận Chuyển An Toàn & Tốc Độ
        </span>
        <h1 class="display-6 fw-bold text-dark mb-3">Chính Sách Giao Hàng Toàn Quốc</h1>
        <p class="text-muted mx-auto" style="max-width: 650px; line-height: 1.7;">
            Đồng hành cùng ba mẹ chăm chút từng set đồ cho bé, BabyShop liên kết với các đơn vị vận chuyển uy tín hàng đầu (GHTK, Viettel Post, Shopee Xpress) để mang đến trải nghiệm giao hàng nhanh chóng, an toàn.
        </p>
    </div>
</section>

<!-- 4 Ưu Điểm Vận Chuyển -->
<section class="py-5 bg-white">
    <div class="container">
        <div class="row g-4">
            <div class="col-12 col-md-6 col-lg-3">
                <div class="p-4 rounded-4 border h-100 text-center shadow-xs">
                    <div class="rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 58px; height: 58px; background: #EBF3EE; color: var(--baby-sage); font-size: 1.5rem;">
                        <i class="bi bi-gift"></i>
                    </div>
                    <h6 class="fw-bold mb-2">Freeship Đơn Từ 300K</h6>
                    <p class="small text-muted mb-0">Miễn phí vận chuyển toàn quốc cho mọi đơn hàng từ 300.000đ. Không giới hạn số lượng và khối lượng hàng.</p>
                </div>
            </div>

            <div class="col-12 col-md-6 col-lg-3">
                <div class="p-4 rounded-4 border h-100 text-center shadow-xs">
                    <div class="rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 58px; height: 58px; background: #FAF7F2; color: var(--baby-primary); font-size: 1.5rem;">
                        <i class="bi bi-clock-history"></i>
                    </div>
                    <h6 class="fw-bold mb-2">Giao Nhanh 1 - 3 Ngày</h6>
                    <p class="small text-muted mb-0">Hà Nội & TP.HCM nhận hàng trong 24h - 48h. Các tỉnh thành khác chỉ mất từ 2 đến 3 ngày làm việc.</p>
                </div>
            </div>

            <div class="col-12 col-md-6 col-lg-3">
                <div class="p-4 rounded-4 border h-100 text-center shadow-xs">
                    <div class="rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 58px; height: 58px; background: #FDF2F4; color: var(--baby-rose); font-size: 1.5rem;">
                        <i class="bi bi-box2-heart"></i>
                    </div>
                    <h6 class="fw-bold mb-2">Đồng Kiểm Khi Nhận</h6>
                    <p class="small text-muted mb-0">Mẹ hoàn toàn được quyền mở hộp kiểm tra đúng mẫu, đúng size, chất vải ưng ý rồi mới thanh toán tiền cho shipper.</p>
                </div>
            </div>

            <div class="col-12 col-md-6 col-lg-3">
                <div class="p-4 rounded-4 border h-100 text-center shadow-xs">
                    <div class="rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 58px; height: 58px; background: #F1F5F9; color: #1E293B; font-size: 1.5rem;">
                        <i class="bi bi-shield-check"></i>
                    </div>
                    <h6 class="fw-bold mb-2">Bảo Hiểm Hàng Hóa</h6>
                    <p class="small text-muted mb-0">100% bưu kiện được đóng hộp carton chỉn chu và dán tem niêm phong chống rạch mở, đảm bảo vệ sinh cho đồ bé.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Biểu Phí & Thời Gian Vận Chuyển -->
<section class="py-5" style="background: #FAF9F6;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-lg-9">
                <div class="bg-white p-4 p-md-5 rounded-4 shadow-sm border mb-4">
                    <h4 class="fw-bold mb-3 text-dark"><i class="bi bi-table text-primary me-2" style="color: var(--baby-primary) !important;"></i>1. Biểu Phí & Thời Gian Giao Hàng Chi Tiết</h4>
                    <div class="table-responsive mb-4">
                        <table class="table table-bordered small align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Khu Vực Giao Hàng</th>
                                    <th>Thời Gian Dự Kiến</th>
                                    <th>Đơn Dưới 300.000đ</th>
                                    <th>Đơn Từ 300.000đ</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><strong>Nội thành Hà Nội & TP. Hồ Chí Minh</strong></td>
                                    <td>24h - 48h</td>
                                    <td>25.000đ</td>
                                    <td class="text-success fw-bold">MIỄN PHÍ</td>
                                </tr>
                                <tr>
                                    <td><strong>Các tỉnh, thành phố lớn</strong> (Đà Nẵng, Hải Phòng, Cần Thơ, Nha Trang...)</td>
                                    <td>2 - 3 ngày</td>
                                    <td>30.000đ</td>
                                    <td class="text-success fw-bold">MIỄN PHÍ</td>
                                </tr>
                                <tr>
                                    <td><strong>Huyện, xã vùng xa, biên giới & hải đảo</strong></td>
                                    <td>3 - 4 ngày</td>
                                    <td>35.000đ</td>
                                    <td class="text-success fw-bold">MIỄN PHÍ</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <h4 class="fw-bold mb-3 text-dark"><i class="bi bi-search text-info me-2"></i>2. Quy Định Đồng Kiểm Hàng Khi Nhận (Quan Trọng)</h4>
                    <p class="text-muted small mb-3">BabyShop khuyến khích khách hàng thực hiện đồng kiểm cùng nhân viên giao nhận để đảm bảo quyền lợi tốt nhất:</p>
                    <ul class="text-muted small ps-3 mb-4" style="line-height: 1.8;">
                        <li>Khách hàng được mở bưu kiện để kiểm tra số lượng sản phẩm, mẫu mã, màu sắc và size quần áo có đúng với đơn đặt hàng hay không.</li>
                        <li>Kiểm tra tình trạng ngoại quan: Không bị rách bẩn, ướt nước hoặc đứt cúc.</li>
                        <li><em>Lưu ý:</em> Không áp dụng thử đồ trực tiếp hoặc làm bẩn sản phẩm khi có mặt nhân viên giao hàng. Sau khi nhận, mẹ có thể cho bé thử đồ thoải mái trong <strong>07 ngày</strong>, nếu không vừa BabyShop sẽ đổi size tận nhà.</li>
                        <li>Trường hợp bưu kiện giao sai hoặc hư hỏng do vận chuyển, mẹ có quyền từ chối nhận và không phải thanh toán bất kỳ chi phí nào.</li>
                    </ul>

                    <h4 class="fw-bold mb-3 text-dark"><i class="bi bi-geo-alt text-danger me-2"></i>3. Tra Cứu Trạng Thái Đơn Hàng</h4>
                    <p class="text-muted small mb-3">Sau khi đơn hàng được xác nhận, hệ thống sẽ gửi tin nhắn SMS / Email kèm mã vận đơn. Mẹ có thể dễ dàng kiểm tra lộ trình đơn hàng:</p>
                    <ul class="text-muted small ps-3 mb-4" style="line-height: 1.8;">
                        <li>Truy cập mục <a asp-controller="Account" asp-action="MyOrders" class="fw-bold text-decoration-none" style="color: var(--baby-primary);">Đơn Hàng Của Tôi</a> trên website để xem trạng thái thời gian thực.</li>
                        <li>Nhắn tin vào khung chat gặp Trợ Lý AI hoặc CSKH để được gửi link tra cứu trực tiếp.</li>
                    </ul>

                    <!-- Callout Box -->
                    <div class="p-4 rounded-4" style="background: #EBF3EE; border-left: 4px solid var(--baby-sage);">
                        <h6 class="fw-bold mb-2 text-dark">Cần giao hỏa tốc hoặc thay đổi địa chỉ nhận hàng?</h6>
                        <p class="small text-muted mb-3">Nếu mẹ cần nhận đồ gấp cho bé đi tiệc, chụp ảnh lookbook hoặc muốn đổi địa chỉ giao hàng, vui lòng liên hệ ngay:</p>
                        <div class="d-flex flex-wrap gap-2">
                            <button type="button" class="btn btn-baby-primary btn-sm px-3" onclick="openBabyChat('Staff')">
                                <i class="bi bi-chat-dots-fill me-1"></i> Nhắn CSKH Điều Phối Đơn
                            </button>
                            <a href="tel:1900633520" class="btn btn-outline-dark btn-sm px-3 rounded-pill">
                                <i class="bi bi-telephone-fill me-1"></i> Hotline: 1900 633 520
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
