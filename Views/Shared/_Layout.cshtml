    <!-- BabyAlert Global SweetAlert2 Utilities -->
    <script>
        window.BabyAlert = {
            toast: function(message, icon = 'success') {
                const Toast = Swal.mixin({
                    toast: true,
                    position: 'top-end',
                    showConfirmButton: false,
                    timer: 3500,
                    timerProgressBar: true,
                    customClass: {
                        popup: 'baby-swal-toast'
                    },
                    didOpen: (toast) => {
                        toast.addEventListener('mouseenter', Swal.stopTimer);
                        toast.addEventListener('mouseleave', Swal.resumeTimer);
                    }
                });
                Toast.fire({
                    icon: icon,
                    title: message
                });
            },
            success: function(title, message) {
                return Swal.fire({
                    icon: 'success',
                    title: title,
                    text: message,
                    confirmButtonColor: '#C57B57',
                    confirmButtonText: 'Tuyệt vời',
                    customClass: {
                        popup: 'baby-swal-popup',
                        title: 'baby-swal-title',
                        confirmButton: 'btn btn-baby-primary rounded-pill px-4'
                    },
                    buttonsStyling: false
                });
            },
            error: function(title, message) {
                return Swal.fire({
                    icon: 'error',
                    title: title,
                    text: message,
                    confirmButtonColor: '#DC3545',
                    confirmButtonText: 'Đã hiểu',
                    customClass: {
                        popup: 'baby-swal-popup',
                        title: 'baby-swal-title',
                        confirmButton: 'btn btn-danger rounded-pill px-4'
                    },
                    buttonsStyling: false
                });
            },
            warning: function(title, message, isHtml = false) {
                const config = {
                    icon: 'warning',
                    title: title,
                    confirmButtonColor: '#F59E0B',
                    confirmButtonText: 'Đã hiểu',
                    customClass: {
                        popup: 'baby-swal-popup',
                        title: 'baby-swal-title',
                        confirmButton: 'btn btn-warning text-white fw-bold rounded-pill px-4 shadow-sm'
                    },
                    buttonsStyling: false
                };
                if (isHtml) {
                    config.html = message;
                } else {
                    config.text = message;
                }
                return Swal.fire(config);
            },
            confirm: function(title, message, confirmText = 'Xác nhận', cancelText = 'Hủy') {
                return Swal.fire({
                    title: title,
                    text: message,
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: confirmText,
                    cancelButtonText: cancelText,
                    customClass: {
                        popup: 'baby-swal-popup',
                        title: 'baby-swal-title',
                        confirmButton: 'btn btn-baby-primary rounded-pill px-4 me-2',
                        cancelButton: 'btn btn-outline-secondary rounded-pill px-4'
                    },
                    buttonsStyling: false
                });
            },
            copy: function(text, label = 'mã') {
                if (navigator.clipboard) {
                    navigator.clipboard.writeText(text).then(() => {
                        BabyAlert.toast(`Đã sao chép ${label}: ${text} ✨`, 'success');
                    }).catch(() => {
                        BabyAlert.toast(`Đã chọn ${label}: ${text}`, 'info');
                    });
                }
            }
        };

        // Tự động kích hoạt SweetAlert Toast khi có TempData thông báo
        document.addEventListener('DOMContentLoaded', function() {
            @if (TempData["SuccessMessage"] != null)
            {
                <text>BabyAlert.toast('@Html.Raw(TempData["SuccessMessage"])', 'success');</text>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <text>BabyAlert.toast('@Html.Raw(TempData["ErrorMessage"])', 'error');</text>
            }
            @if (TempData["StockWarning"] != null)
            {
                <text>BabyAlert.warning('Cảnh Báo Tồn Kho', '@Html.Raw(TempData["StockWarning"])');</text>
            }
            @if (TempData["CouponSuccess"] != null)
            {
                <text>BabyAlert.toast('@Html.Raw(TempData["CouponSuccess"])', 'success');</text>
            }
            @if (TempData["CouponError"] != null)
            {
                <text>BabyAlert.toast('@Html.Raw(TempData["CouponError"])', 'error');</text>
            }
        });
    </script>
    <script>
        var currentChatMode = 'AI'; // 'AI' or 'Staff'
        var staffPollTimer = null;
        var renderedStaffMsgIds = new Set();

        function getBabyChatSessionId() {
            var sess = localStorage.getItem('babyshop_chat_session');
            if (!sess) {
                sess = 'sess_' + Date.now() + '_' + Math.random().toString(36).substring(2, 9);
                localStorage.setItem('babyshop_chat_session', sess);
            }
            return sess;
        }

        function toggleBabyContact() {
            var widget = document.getElementById('babyContactWidget');
            if (widget) {
                widget.classList.toggle('active');
            }
        }

        function openBabyChat(mode) {
            var widget = document.getElementById('babyContactWidget');
            if (widget) widget.classList.remove('active');

            var chat = document.getElementById('babyChatWindow');
            if (chat) {
                chat.classList.add('active');
            }
            switchChatMode(mode || 'AI');

            setTimeout(function() {
                var input = document.getElementById('chatInputMessage');
                if (input) input.focus();
            }, 300);
        }

        function closeBabyChat() {
            var chat = document.getElementById('babyChatWindow');
            if (chat) {
                chat.classList.remove('active');
            }
            if (staffPollTimer) {
                clearInterval(staffPollTimer);
                staffPollTimer = null;
            }
        }

        function switchChatMode(mode) {
            currentChatMode = mode;
            var tabAI = document.getElementById('tabModeAI');
            var tabStaff = document.getElementById('tabModeStaff');
            var input = document.getElementById('chatInputMessage');

            if (mode === 'AI') {
                if (tabAI) tabAI.classList.add('active');
                if (tabStaff) tabStaff.classList.remove('active');
                if (input) input.placeholder = "Hỏi Real AI tư vấn size, sản phẩm 24/7...";
                if (staffPollTimer) {
                    clearInterval(staffPollTimer);
                    staffPollTimer = null;
                }
            } else {
                if (tabStaff) tabStaff.classList.add('active');
                if (tabAI) tabAI.classList.remove('active');
                if (input) input.placeholder = "Nhắn tin trực tiếp với chuyên viên CSKH...";
                
                // Tải lịch sử chat với nhân viên và bắt đầu kiểm tra tin nhắn mới
                loadStaffChatHistory();
                if (!staffPollTimer) {
                    staffPollTimer = setInterval(loadStaffChatHistory, 3000);
                }
            }
        }

        async function loadStaffChatHistory() {
            if (currentChatMode !== 'Staff') return;
            var sess = getBabyChatSessionId();
            try {
                var resp = await fetch('/Chat/GetStaffMessages?sessionId=' + encodeURIComponent(sess));
                if (!resp.ok) return;
                var data = await resp.json();
                if (data.success && data.messages) {
                    var messagesContainer = document.getElementById('babyChatMessages');
                    var typingEl = document.getElementById('chatTypingIndicator');
                    var hasNew = false;

                    data.messages.forEach(function(m) {
                        // 1. Đã đăng ký ID này thì bỏ qua
                        if (renderedStaffMsgIds.has(m.id)) return;

                        // 2. Nếu phần tử trên DOM đã có ID này thì ghi nhận và bỏ qua
                        if (document.querySelector(`.baby-msg-wrap[data-msg-id="${m.id}"]`)) {
                            renderedStaffMsgIds.add(m.id);
                            return;
                        }

                        // 3. Nếu là tin nhắn của Khách hàng, kiểm tra xem bong bóng vừa gửi đã có trên DOM chưa (tránh nhân đôi)
                        if (m.sender === 'Customer') {
                            var matchingUserEl = Array.from(document.querySelectorAll('.baby-msg-wrap.msg-user')).find(function(el) {
                                var bubble = el.querySelector('.baby-msg-bubble');
                                return bubble && bubble.textContent.trim() === m.message.trim() && !el.hasAttribute('data-msg-id');
                            });
                            if (matchingUserEl) {
                                matchingUserEl.setAttribute('data-msg-id', m.id);
                                renderedStaffMsgIds.add(m.id);
                                return; // Trùng khớp với tin vừa gửi, không thêm lại!
                            }
                        }

                        // 4. Nếu chưa có trên màn hình, render vào khung chat
                        renderedStaffMsgIds.add(m.id);
                        hasNew = true;

                        if (m.sender === 'Customer') {
                            var uHtml = `
                                <div class="baby-msg-wrap msg-user" data-msg-id="${m.id}">
                                    <div class="baby-msg-content">
                                        <div class="baby-msg-bubble">${escapeHtml(m.message)}</div>
                                        <div class="baby-msg-time">${m.time}</div>
                                    </div>
                                </div>
                            `;
                            typingEl.insertAdjacentHTML('beforebegin', uHtml);
                        } else {
                            var sHtml = `
                                <div class="baby-msg-wrap msg-bot" data-msg-id="${m.id}">
                                    <div class="baby-msg-avatar" style="background: var(--baby-sage-light); color: var(--baby-sage);">
                                        <i class="bi bi-person-check-fill"></i>
                                    </div>
                                    <div class="baby-msg-content">
                                        <div class="baby-msg-bubble" style="border-left: 3px solid var(--baby-sage);">${formatChatReply(m.message)}</div>
                                        <div class="baby-msg-time">${escapeHtml(m.senderName)} • ${m.time}</div>
                                    </div>
                                </div>
                            `;
                            typingEl.insertAdjacentHTML('beforebegin', sHtml);
                        }
                    });

                    if (hasNew) {
                        messagesContainer.scrollTop = messagesContainer.scrollHeight;
                    }
                }
            } catch (e) {
                console.error("Lỗi khi đồng bộ chat nhân viên:", e);
            }
        }

        function sendQuickMessage(text) {
            var input = document.getElementById('chatInputMessage');
            if (input) {
                input.value = text;
                handleChatSubmit(new Event('submit'));
            }
        }

        function sendCSKHMessage(text, custName, custPhone) {
            // 1. Mở cửa sổ chat và chuyển ngay sang chế độ CSKH (Staff)
            openBabyChat('Staff');

            // 2. Lưu tên và SĐT vào biến tạm để gửi kèm request
            if (custName) window.currentCustomerName = custName;
            if (custPhone) window.currentCustomerPhone = custPhone;

            // 3. Tránh gửi lặp lại nếu vừa gửi nội dung hỗ trợ đơn này
            if (window.lastSentOrderSupportText === text) {
                return;
            }
            window.lastSentOrderSupportText = text;

            // 4. Đưa vào ô input và tự động gửi tới bộ phận CSKH
            var input = document.getElementById('chatInputMessage');
            if (input) {
                input.value = text;
                setTimeout(function() {
                    handleChatSubmit(new Event('submit'));
                }, 200);
            }
        }

        async function handleChatSubmit(e) {
            if (e && e.preventDefault) e.preventDefault();
            var input = document.getElementById('chatInputMessage');
            if (!input) return;

            var msg = input.value.trim();
            if (!msg) return;

            // Clear input
            input.value = '';

            // 1. Render User Message
            var messagesContainer = document.getElementById('babyChatMessages');
            var now = new Date();
            var timeStr = now.getHours().toString().padStart(2, '0') + ':' + now.getMinutes().toString().padStart(2, '0');
            var clientMsgId = 'client_' + Date.now();

            var userHtml = `
                <div class="baby-msg-wrap msg-user" data-client-id="${clientMsgId}">
                    <div class="baby-msg-content">
                        <div class="baby-msg-bubble">${escapeHtml(msg)}</div>
                        <div class="baby-msg-time">${timeStr}</div>
                    </div>
                </div>
            `;
            var typingEl = document.getElementById('chatTypingIndicator');
            typingEl.insertAdjacentHTML('beforebegin', userHtml);
            typingEl.classList.add('active');
            messagesContainer.scrollTop = messagesContainer.scrollHeight;

            var sessId = getBabyChatSessionId();

            try {
                var payload = { 
                    message: msg, 
                    mode: currentChatMode, 
                    sessionId: sessId 
                };
                if (window.currentCustomerName) payload.customerName = window.currentCustomerName;
                if (window.currentCustomerPhone) payload.customerPhone = window.currentCustomerPhone;

                var response = await fetch('/Chat/SendMessage', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                var data = await response.json();
                typingEl.classList.remove('active');

                if (data && data.success) {
                    // Đăng ký messageId vào Set và gắn vào phần tử user vừa tạo để không bị nhân đôi
                    if (data.messageId) {
                        renderedStaffMsgIds.add(data.messageId);
                        var userEl = document.querySelector(`.baby-msg-wrap.msg-user[data-client-id="${clientMsgId}"]`);
                        if (userEl) {
                            userEl.setAttribute('data-msg-id', data.messageId);
                            userEl.removeAttribute('data-client-id');
                        }
                    }
                    var formattedReply = formatChatReply(data.reply);
                    var avatarIcon = data.mode === 'Staff' ? 'bi-person-check-fill' : 'bi-robot';
                    var avatarBg = data.mode === 'Staff' ? 'var(--baby-sage-light)' : 'var(--baby-primary-light)';
                    var avatarColor = data.mode === 'Staff' ? 'var(--baby-sage)' : 'var(--baby-primary)';

                    // Render Suggested Products if any
                    var prodsHtml = '';
                    if (data.suggestedProducts && data.suggestedProducts.length > 0) {
                        data.suggestedProducts.forEach(function(p) {
                            prodsHtml += `
                                <a href="/Product/Details/${p.id}" class="baby-chat-prod-card">
                                    <img src="${p.imageUrl}" alt="${escapeHtml(p.name)}" class="baby-chat-prod-thumb" />
                                    <div class="baby-chat-prod-info">
                                        <div class="baby-chat-prod-title">${escapeHtml(p.name)}</div>
                                        <div class="baby-chat-prod-price">${Number(p.price).toLocaleString('vi-VN')} đ</div>
                                    </div>
                                    <i class="bi bi-chevron-right text-muted small"></i>
                                </a>
                            `;
                        });
                    }

                    var botHtml = `
                        <div class="baby-msg-wrap msg-bot">
                            <div class="baby-msg-avatar" style="background: ${avatarBg}; color: ${avatarColor};">
                                <i class="bi ${avatarIcon}"></i>
                            </div>
                            <div class="baby-msg-content">
                                <div class="baby-msg-bubble">${formattedReply}</div>
                                ${prodsHtml}
                                <div class="baby-msg-time">${data.senderName || 'Trợ Lý'} • ${data.time || timeStr}</div>
                            </div>
                        </div>
                    `;
                    typingEl.insertAdjacentHTML('beforebegin', botHtml);
                } else {
                    var errorHtml = `
                        <div class="baby-msg-wrap msg-bot">
                            <div class="baby-msg-avatar"><i class="bi bi-exclamation-circle"></i></div>
                            <div class="baby-msg-content">
                                <div class="baby-msg-bubble">${data.reply || 'Hệ thống đang bận, mẹ vui lòng thử lại sau nhé!'}</div>
                            </div>
                        </div>
                    `;
                    typingEl.insertAdjacentHTML('beforebegin', errorHtml);
                }
            } catch (err) {
                typingEl.classList.remove('active');
                console.error(err);
            }

            messagesContainer.scrollTop = messagesContainer.scrollHeight;
        }

        function formatChatReply(rawText) {
            if (!rawText) return '';
            var safe = escapeHtml(rawText);
            // In đậm: **text**
            safe = safe.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
            // Chuyển đổi gạch đầu dòng Markdown (* hoặc -) thành list đẹp
            safe = safe.replace(/(?:^|\n)\s*[\*\-]\s+(.+)/g, '<div class="baby-bullet-item"><span class="baby-bullet-dot">•</span><span class="baby-bullet-text">$1</span></div>');
            // Xuống dòng
            safe = safe.replace(/\n/g, '<br />');
            // Dọn dẹp khoảng trống sau bullet div
            safe = safe.replace(/<\/div><br \/>/g, '</div>');
            return safe;
        }

        function escapeHtml(text) {
            var div = document.createElement('div');
            div.innerText = text;
            return div.innerHTML;
        }

        // Close contact menu when clicking outside
        document.addEventListener('click', function(e) {
            var widget = document.getElementById('babyContactWidget');
            var chat = document.getElementById('babyChatWindow');
            if (widget && widget.classList.contains('active')) {
                if (!widget.contains(e.target) && (!chat || !chat.contains(e.target))) {
                    widget.classList.remove('active');
                }
            }
        });

        // ==========================================
        // GLOBAL WISHLIST MANAGEMENT (LOCALSTORAGE)
        // ==========================================
        function getWishlist() {
            try {
                const raw = localStorage.getItem('babyshop_wishlist');
                return raw ? JSON.parse(raw) : [];
            } catch (e) {
                return [];
            }
        }

        function toggleWishlist(productId, event) {
            if (event) {
                event.preventDefault();
                event.stopPropagation();
            }
            productId = parseInt(productId);
            if (isNaN(productId)) return;

            let list = getWishlist();
            const index = list.indexOf(productId);
            let added = false;

            if (index > -1) {
                list.splice(index, 1);
                added = false;
            } else {
                list.unshift(productId);
                added = true;
            }

            localStorage.setItem('babyshop_wishlist', JSON.stringify(list));
            updateWishlistBadges();
            syncWishlistButtons();

            if (added) {
                renderWishlistToast("Đã lưu vào danh sách yêu thích cho bé ❤️", "success");
            } else {
                renderWishlistToast("Đã bỏ khỏi danh sách yêu thích", "info");
            }
        }

        function updateWishlistBadges() {
            const count = getWishlist().length;
            const badge = document.getElementById('wishlistBadge');
            const mobBadge = document.getElementById('mobileWishlistBadge');

            if (badge) {
                badge.textContent = count;
                if (count > 0) {
                    badge.classList.remove('d-none');
                } else {
                    badge.classList.add('d-none');
                }
            }
            if (mobBadge) {
                mobBadge.textContent = count;
            }
        }

        function syncWishlistButtons() {
            const list = getWishlist();
            document.querySelectorAll('.baby-wishlist-btn, .baby-wishlist-detail-btn').forEach(btn => {
                const pid = parseInt(btn.getAttribute('data-product-id'));
                if (!isNaN(pid)) {
                    const icon = btn.querySelector('i');
                    if (list.includes(pid)) {
                        btn.classList.add('is-active');
                        if (icon) {
                            icon.className = 'bi bi-heart-fill text-danger' + (btn.classList.contains('baby-wishlist-detail-btn') ? ' fs-5 me-2' : '');
                        }
                    } else {
                        btn.classList.remove('is-active');
                        if (icon) {
                            icon.className = 'bi bi-heart' + (btn.classList.contains('baby-wishlist-detail-btn') ? ' fs-5 me-2' : '');
                        }
                    }
                }
            });
        }

        function renderWishlistToast(message, type) {
            if (window.BabyAlert) {
                BabyAlert.toast(message, type === 'success' ? 'success' : 'info');
                return;
            }
            let container = document.getElementById('babyToastContainer');
            if (!container) {
                container = document.createElement('div');
                container.id = 'babyToastContainer';
                container.className = 'baby-toast-container';
                document.body.appendChild(container);
            }

            const toast = document.createElement('div');
            toast.className = `baby-toast ${type === 'success' ? 'baby-toast-success' : 'baby-toast-info'}`;
            toast.innerHTML = `<i class="bi ${type === 'success' ? 'bi-heart-fill text-danger' : 'bi-info-circle'} me-2"></i><span>${message}</span>`;
            container.appendChild(toast);

            setTimeout(() => {
                toast.classList.add('show');
            }, 10);

            setTimeout(() => {
                toast.classList.remove('show');
                setTimeout(() => toast.remove(), 300);
            }, 2500);
        }

        document.addEventListener('DOMContentLoaded', function() {
            updateWishlistBadges();
            syncWishlistButtons();
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
