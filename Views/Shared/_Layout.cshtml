@using WebsiteBabyShop.Models
@using WebsiteBabyShop.Helpers
@inject IHttpContextAccessor HttpContextAccessor

@{
    var cart = HttpContextAccessor.HttpContext?.Session.GetObject<List<CartItem>>("ShoppingCart") ?? new List<CartItem>();
    var cartCount = cart.Sum(c => c.Quantity);
    var isAuthenticated = User.Identity?.IsAuthenticated ?? false;
    var userName = User.Identity?.Name ?? "";
    var isAdmin = User.IsInRole("Admin");
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>@(ViewData["Title"] != null ? ViewData["Title"] + " - BabyShop Studio Kids" : "BabyShop | Thời Trang Trẻ Em Thiết Kế & Cao Cấp")</title>
    
    <!-- Bootstrap CSS & Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    
    <!-- SweetAlert2 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" />

    <!-- Contemporary Kids Boutique Design System -->
    <link rel="stylesheet" href="~/css/babyshop.css" asp-append-version="true" />
</head>
<body>
    <!-- 1. Top Announcement Bar -->
    <div class="baby-topbar text-center">
        <div class="container d-flex justify-content-between align-items-center">
            <span class="d-none d-md-inline"><i class="bi bi-feather me-1"></i> Chất liệu 100% Cotton Organic an toàn cho bé</span>
            <span class="mx-auto mx-md-0"><i class="bi bi-truck me-1"></i> Miễn phí vận chuyển từ <strong>300.000đ</strong> • Đổi hàng tận nhà <strong>7 ngày</strong></span>
            <div class="d-none d-lg-flex align-items-center gap-3">
                <button type="button" class="btn btn-link text-decoration-none text-dark p-0 small fw-semibold" data-bs-toggle="modal" data-bs-target="#sizeGuideModal" style="font-size: 0.8rem;">
                    <i class="bi bi-rulers me-1 text-primary"></i> Bảng Size Chuẩn
                </button>
                <span><i class="bi bi-telephone me-1"></i> Hotline: <strong>1900 633 520</strong></span>
            </div>
        </div>
    </div>

    <!-- 2. Frosted Sticky Header -->
    <header class="baby-header">
        <div class="container py-2">
            <div class="row align-items-center g-2 g-md-3">
                <!-- Mobile Menu Button & Brand Logo -->
                <div class="col-6 col-md-3 col-lg-3 d-flex align-items-center gap-2">
                    <button class="baby-mobile-toggle d-md-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileNavOffcanvas" aria-label="Menu">
                        <i class="bi bi-list"></i>
                    </button>

                    <a class="baby-brand" asp-controller="Home" asp-action="Index">
                        <div class="baby-brand-icon">
                            <i class="bi bi-stars"></i>
                        </div>
                        <div class="baby-brand-text">
                            <span class="baby-brand-name">BABY<span>SHOP</span></span>
                            <span class="baby-brand-sub">Studio Kids</span>
                        </div>
                    </a>
                </div>

                <!-- Desktop / Tablet Search Form -->
                <div class="col-12 col-md-4 col-lg-4 order-3 order-md-2 mt-2 mt-md-0">
                    <form asp-controller="Product" asp-action="Index" method="get" class="baby-search-form mx-auto">
                        <input type="text" name="search" id="globalSearchInput" class="baby-search-input" placeholder="Tìm kiếm váy bé gái, set yếm, đồ sơ sinh..." value="@Context.Request.Query["search"]" />
                        <button type="submit" class="baby-search-btn" title="Tìm kiếm">
                            <i class="bi bi-search"></i>
                        </button>
                    </form>
                </div>

                <!-- Right Actions: Order Tracking, Wishlist, Account, Cart -->
                <div class="col-6 col-md-5 col-lg-5 order-2 order-md-3 text-end d-flex justify-content-end align-items-center gap-1 gap-sm-2 gap-lg-3">
                    <!-- Order Tracking -->
                    <a asp-controller="OrderTracking" asp-action="Index" class="baby-header-action d-none d-md-flex" title="Tra cứu tiến độ đơn hàng">
                        <i class="bi bi-truck"></i>
                        <span>Tra Cứu Đơn</span>
                    </a>

                    <!-- Wishlist -->
                    <a asp-controller="Wishlist" asp-action="Index" class="baby-header-action position-relative d-none d-sm-flex" title="Sản phẩm yêu thích">
                        <i class="bi bi-heart"></i>
                        <span>Yêu Thích</span>
                        <span class="baby-header-badge d-none" id="wishlistBadge">0</span>
                    </a>

                    <!-- Rewards & Lucky Wheel -->
                    <a asp-controller="Rewards" asp-action="Index" class="baby-header-action position-relative d-none d-md-flex" title="Vòng quay may mắn & Điểm danh">
                        <i class="bi bi-gift text-danger"></i>
                        <span>Săn Quà</span>
                        <span class="baby-header-badge bg-danger text-white" style="display: inline-block;">Hot</span>
                    </a>

                    <!-- Account / Auth -->
                    @if (isAuthenticated)
                    {
                        <div class="dropdown">
                            <button class="baby-header-action dropdown-toggle" type="button" data-bs-toggle="dropdown" title="Tài khoản cá nhân">
                                <i class="bi bi-person-check text-primary"></i>
                                <span class="baby-header-username">@userName</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3 mt-2">
                                <li><h6 class="dropdown-header">Tài khoản của bạn</h6></li>
                                @if (isAdmin)
                                {
                                    <li>
                                        <a class="dropdown-item fw-bold text-danger" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                                            <i class="bi bi-shield-lock me-2"></i>Trang Quản Trị (Admin)
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                }
                                <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile"><i class="bi bi-person me-2"></i>Hồ sơ cá nhân</a></li>
                                <li><a class="dropdown-item fw-bold text-danger" asp-controller="Rewards" asp-action="Index"><i class="bi bi-gift-fill text-danger me-2"></i>Vòng Quay & Điểm Danh 🎡</a></li>
                                <li><a class="dropdown-item" asp-controller="Account" asp-action="MyVouchers"><i class="bi bi-ticket-perforated-fill text-danger me-2"></i>Kho Voucher của tôi</a></li>
                                <li><a asp-controller="OrderTracking" asp-action="Index" class="dropdown-item"><i class="bi bi-truck me-2"></i>Tra cứu đơn hàng</a></li>
                                <li><a class="dropdown-item" asp-controller="Account" asp-action="MyOrders"><i class="bi bi-bag-check me-2"></i>Đơn hàng đã mua</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline" onsubmit="sessionStorage.clear();">
                                        <button type="submit" class="dropdown-item text-secondary"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="baby-header-action" title="Đăng nhập tài khoản">
                            <i class="bi bi-person"></i>
                            <span>Tài Khoản</span>
                        </a>
                    }

                    <!-- Shopping Cart Pill -->
                    <a asp-controller="Cart" asp-action="Index" class="baby-cart-btn-pill ms-1" title="Giỏ hàng của mẹ">
                        <i class="bi bi-bag fs-5"></i>
                        <span class="d-none d-sm-inline">Giỏ Hàng</span>
                        <span class="baby-cart-count-pill" id="cartBadge">@cartCount</span>
                    </a>
                </div>
            </div>
        </div>

        <!-- 3. Desktop Navigation Bar -->
        <nav class="baby-navbar d-none d-md-block">
            <div class="container">
                <ul class="baby-nav-list">
                    <li class="baby-nav-item">
                        <a class="baby-nav-link" asp-controller="Home" asp-action="Index">
                            Trang Chủ
                        </a>
                    </li>

                    <!-- BÉ GÁI WITH MEGA MENU -->
                    <li class="baby-nav-item">
                        <a class="baby-nav-link" asp-controller="Product" asp-action="Index" asp-route-gender="Bé gái">
                            Bé Gái <i class="bi bi-chevron-down small opacity-50 ms-1"></i>
                        </a>
                        <div class="baby-mega-menu">
                            <div class="row g-4">
                                <div class="col-4">
                                    <div class="baby-mega-title">Trang Phục Bé Gái</div>
                                    <ul class="baby-mega-links">
                                        <li><a asp-controller="Product" asp-action="Index" asp-route-gender="Bé gái" asp-route-category="vay-dam-be-gai">Váy Đầm Công Chúa</a></li>
                                        <li><a asp-controller="Product" asp-action="Index" asp-route-gender="Bé gái" asp-route-category="ao-be-gai">Áo Thun & Sơ Mi</a></li>
                                        <li><a asp-controller="Product" asp-action="Index" asp-route-gender="Bé gái" asp-route-category="quan-be-gai">Quần & Chân Váy</a></li>
                                        <li><a asp-controller="Product" asp-action="Index" asp-route-gender="Bé gái" asp-route-category="do-bo-mac-nha">Đồ Bộ Mặc Nhà</a></li>
                                    </ul>
                                </div>
                                <div class="col-4">
                                    <div class="baby-mega-title">Theo Độ Tuổi</div>
                                    <ul class="baby-mega-links">
                                        <li><a asp-controller="Product" asp-action="Index" asp-route-gender="Bé gái">Bé tập đi (1 - 3 tuổi)</a></li>
                                        <li><a asp-controller="Product" asp-action="Index" asp-route-gender="Bé gái">Mẫu giáo (3 - 6 tuổi)</a></li>
                                        <li><a asp-controller="Product" asp-action="Index" asp-route-gender="Bé gái">Tiểu học (6 - 12 tuổi)</a></li>
                                        <li><a asp-controller="Product" asp-action="Index" asp-route-gender="Bé gái" asp-route-isNew="true" class="text-primary fw-bold">Xem tất cả đồ bé gái &rarr;</a></li>
                                    </ul>
                                </div>
                                <div class="col-4">
                                    <div class="rounded-3 overflow-hidden border p-3 text-center" style="background: var(--baby-rose-light);">
                                        <h6 class="fw-bold mb-1" style="color: var(--baby-rose);">Váy Mùa Hè 2026</h6>
                                        <p class="small text-muted mb-2">Vải thô đũi mát mịn</p>
                                        <a asp-controller="Product" asp-action="Index" asp-route-gender="Bé gái" class="btn btn-baby-primary btn-sm">Khám Phá</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </li>

                    <!-- BÉ TRAI WITH MEGA MENU -->
                    <li class="baby-nav-item">
                        <a class="baby-nav-link" asp-controller="Product" asp-action="Index" asp-route-gender="Bé trai">
                            Bé Trai <i class="bi bi-chevron-down small opacity-50 ms-1"></i>
                        </a>
                        <div class="baby-mega-menu">
                            <div class="row g-4">
                                <div class="col-4">
                                    <div class="baby-mega-title">Trang Phục Bé Trai</div>
                                    <ul class="baby-mega-links">
                                        <li><a asp-controller="Product" asp-action="Index" asp-route-gender="Bé trai" asp-route-category="ao-polo-be-trai">Áo Polo & Sơ Mi</a></li>
                                        <li><a asp-controller="Product" asp-action="Index" asp-route-gender="Bé trai" asp-route-category="ao-phong-be-trai">Áo Phông Năng Động</a></li>
                                        <li><a asp-controller="Product" asp-action="Index" asp-route-gender="Bé trai" asp-route-category="quan-kaki-short">Quần Kaki & Shorts</a></li>
                                        <li><a asp-controller="Product" asp-action="Index" asp-route-gender="Bé trai" asp-route-category="set-yem-be-trai">Set Yếm Cá Tính</a></li>
                                    </ul>
                                </div>
                                <div class="col-4">
                                    <div class="baby-mega-title">Bộ Sưu Tập</div>
                                    <ul class="baby-mega-links">
                                        <li><a asp-controller="Product" asp-action="Index" asp-route-gender="Bé trai">Thời Trang Đi Học</a></li>
                                        <li><a asp-controller="Product" asp-action="Index" asp-route-gender="Bé trai">Đồ Đi Chơi Dã Ngoại</a></li>
                                        <li><a asp-controller="Product" asp-action="Index" asp-route-gender="Bé trai" asp-route-isNew="true" class="text-primary fw-bold">Xem tất cả đồ bé trai &rarr;</a></li>
                                    </ul>
                                </div>
                                <div class="col-4">
                                    <div class="rounded-3 overflow-hidden border p-3 text-center" style="background: var(--baby-sage-light);">
                                        <h6 class="fw-bold mb-1" style="color: var(--baby-sage);">Polo Năng Động</h6>
                                        <p class="small text-muted mb-2">Thấm hút mồ hôi tối đa</p>
                                        <a asp-controller="Product" asp-action="Index" asp-route-gender="Bé trai" class="btn btn-baby-primary btn-sm">Khám Phá</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </li>

                    <!-- SƠ SINH -->
                    <li class="baby-nav-item">
                        <a class="baby-nav-link" asp-controller="Product" asp-action="Index" asp-route-gender="Sơ sinh">
                            Sơ Sinh (0 - 24M)
                        </a>
                    </li>

                    <!-- GIÀY & PHỤ KIỆN -->
                    <li class="baby-nav-item">
                        <a class="baby-nav-link" asp-controller="Product" asp-action="Index" asp-route-category="phu-kien-giay-dep">
                            Giày Dép & Phụ Kiện
                        </a>
                    </li>

                    <!-- HÀNG MỚI VỀ -->
                    <li class="baby-nav-item">
                        <a class="baby-nav-link" asp-controller="Product" asp-action="Index" asp-route-isNew="true">
                            Mới Về <span class="nav-badge new">New</span>
                        </a>
                    </li>

                    <!-- SIÊU SALE -->
                    <li class="baby-nav-item">
                        <a class="baby-nav-link" asp-controller="Product" asp-action="Index" asp-route-isSale="true">
                            Ưu Đãi <span class="nav-badge sale">Sale</span>
                        </a>
                    </li>

                    <!-- VÒNG QUAY MAY MẮN -->
                    <li class="baby-nav-item">
                        <a class="baby-nav-link text-danger fw-bold" asp-controller="Rewards" asp-action="Index">
                            <i class="bi bi-gift-fill me-1"></i> Săn Quà <span class="nav-badge new" style="background: #ef4444;">Hot</span>
                        </a>
                    </li>
                    <li class="baby-nav-item ms-auto">
                        <button type="button" class="baby-nav-link border-0 bg-transparent text-primary fw-semibold" data-bs-toggle="modal" data-bs-target="#sizeGuideModal">
                            <i class="bi bi-rulers me-1"></i> Bảng Đo Size Cho Bé
                        </button>
                    </li>
                </ul>
            </div>
        </nav>
    </header>

    <!-- 4. Mobile Offcanvas Navigation Drawer -->
    <div class="offcanvas offcanvas-start baby-offcanvas" tabindex="-1" id="mobileNavOffcanvas" aria-labelledby="mobileNavLabel">
        <div class="baby-offcanvas-header d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-2">
                <div class="baby-brand-icon" style="width: 32px; height: 32px; font-size: 1.1rem;">
                    <i class="bi bi-stars"></i>
                </div>
                <span class="fw-bold fs-6">BABYSHOP KIDS</span>
            </div>
            <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="baby-offcanvas-body">
            <!-- Categories Group -->
            <div class="mobile-nav-group">
                <a asp-controller="Home" asp-action="Index" class="mobile-nav-link">
                    <span><i class="bi bi-house me-2 text-muted"></i> Trang Chủ</span>
                    <i class="bi bi-chevron-right small text-muted"></i>
                </a>
                <a asp-controller="Product" asp-action="Index" asp-route-gender="Bé gái" class="mobile-nav-link">
                    <span>👗 Thời Trang Bé Gái</span>
                    <i class="bi bi-chevron-right small text-muted"></i>
                </a>
                <a asp-controller="Product" asp-action="Index" asp-route-gender="Bé trai" class="mobile-nav-link">
                    <span>👕 Thời Trang Bé Trai</span>
                    <i class="bi bi-chevron-right small text-muted"></i>
                </a>
                <a asp-controller="Product" asp-action="Index" asp-route-gender="Sơ sinh" class="mobile-nav-link">
                    <span>👶 Đồ Sơ Sinh (0 - 24M)</span>
                    <i class="bi bi-chevron-right small text-muted"></i>
                </a>
                <a asp-controller="Product" asp-action="Index" asp-route-category="phu-kien-giay-dep" class="mobile-nav-link">
                    <span>👟 Giày Dép & Phụ Kiện</span>
                    <i class="bi bi-chevron-right small text-muted"></i>
                </a>
                <a asp-controller="Product" asp-action="Index" asp-route-isNew="true" class="mobile-nav-link">
                    <span>✨ Hàng Mới Về</span>
                    <span class="badge bg-success-subtle text-success small">New</span>
                </a>
                <a asp-controller="Product" asp-action="Index" asp-route-isSale="true" class="mobile-nav-link">
                    <span>🔥 Ưu Đãi Đặc Biệt</span>
                    <span class="badge bg-danger-subtle text-danger small">Sale</span>
                </a>
                <a asp-controller="Rewards" asp-action="Index" class="mobile-nav-link text-danger fw-bold">
                    <span>🎡 Vòng Quay & Điểm Danh</span>
                    <span class="badge bg-danger text-white small">Hot</span>
                </a>
            </div>

            <!-- Quick Service Actions -->
            <div class="mobile-nav-group">
                <a asp-controller="Wishlist" asp-action="Index" class="mobile-nav-link">
                    <span><i class="bi bi-heart me-2 text-danger"></i> Sản Phẩm Yêu Thích</span>
                    <span class="badge bg-danger-subtle text-danger rounded-pill" id="mobileWishlistBadge">0</span>
                </a>
                <a asp-controller="OrderTracking" asp-action="Index" class="mobile-nav-link">
                    <span><i class="bi bi-truck me-2 text-primary"></i> Tra Cứu Đơn Hàng</span>
                    <i class="bi bi-chevron-right small text-muted"></i>
                </a>
                <button type="button" class="mobile-nav-link w-100 text-start border-0 bg-transparent" data-bs-toggle="modal" data-bs-target="#sizeGuideModal" data-bs-dismiss="offcanvas">
                    <span><i class="bi bi-rulers me-2 text-muted"></i> Bảng Đo Size Chuẩn</span>
                    <i class="bi bi-chevron-right small text-muted"></i>
                </button>
                <a href="tel:1900633520" class="mobile-nav-link">
                    <span><i class="bi bi-telephone me-2 text-muted"></i> Hotline CSKH: 1900 633 520</span>
                </a>
            </div>

            <!-- Auth link for mobile -->
            @if (isAuthenticated)
            {
                <div class="mobile-nav-group">
                    <a asp-controller="Account" asp-action="Profile" class="mobile-nav-link">
                        <span><i class="bi bi-person me-2 text-muted"></i> @userName</span>
                    </a>
                    <a asp-controller="Account" asp-action="MyVouchers" class="mobile-nav-link">
                        <span><i class="bi bi-ticket-perforated-fill me-2 text-danger"></i> Kho Voucher của tôi</span>
                    </a>
                    <a asp-controller="Account" asp-action="MyOrders" class="mobile-nav-link">
                        <span><i class="bi bi-bag-check me-2 text-muted"></i> Đơn hàng của tôi</span>
                    </a>
                    @if (isAdmin)
                    {
                        <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="mobile-nav-link text-danger fw-bold">
                            <span><i class="bi bi-shield-lock me-2"></i> Trang Quản Trị</span>
                        </a>
                    }
                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline" onsubmit="sessionStorage.clear();">
                        <button type="submit" class="mobile-nav-link text-secondary w-100 text-start border-0 bg-transparent">
                            <i class="bi bi-box-arrow-right me-2"></i> Đăng xuất
                        </button>
                    </form>
                </div>
            }
            else
            {
                <div class="p-2">
                    <a asp-controller="Account" asp-action="Login" class="btn btn-baby-primary w-100 justify-content-center">
                        <i class="bi bi-person me-1"></i> Đăng Nhập / Đăng Ký
                    </a>
                </div>
            }
        </div>
    </div>

    <!-- 5. Main Content Body -->
    <main role="main">
        @RenderBody()
    </main>

    <!-- 6. Mobile Bottom Navigation Bar (Fixed for mobile) -->
    <div class="baby-bottom-nav d-md-none">
        <a asp-controller="Home" asp-action="Index" class="baby-bottom-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "active" : "")">
            <i class="bi bi-house"></i>
            <span>Trang chủ</span>
        </a>
        <button type="button" class="baby-bottom-item border-0 bg-transparent" data-bs-toggle="offcanvas" data-bs-target="#mobileNavOffcanvas">
            <i class="bi bi-grid"></i>
            <span>Danh mục</span>
        </button>
        <button type="button" class="baby-bottom-item border-0 bg-transparent" onclick="document.getElementById('globalSearchInput')?.focus(); window.scrollTo({top: 0, behavior: 'smooth'});">
            <i class="bi bi-search"></i>
            <span>Tìm kiếm</span>
        </button>
        <a asp-controller="Cart" asp-action="Index" class="baby-bottom-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Cart" ? "active" : "")">
            <i class="bi bi-bag"></i>
            <span>Giỏ hàng</span>
            @if (cartCount > 0)
            {
                <span class="baby-bottom-badge">@cartCount</span>
            }
        </a>
        <a asp-controller="Account" asp-action="@(isAuthenticated ? "Profile" : "Login")" class="baby-bottom-item @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Account" ? "active" : "")">
            <i class="bi bi-person"></i>
            <span>Tài khoản</span>
        </a>
    </div>

    <!-- 7. Size Guide Modal (Bảng Đo Size Chuẩn) -->
    <div class="modal fade" id="sizeGuideModal" tabindex="-1" aria-labelledby="sizeGuideModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content rounded-4 border-0 shadow">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold" id="sizeGuideModalLabel">
                        <i class="bi bi-rulers text-primary me-2"></i>Bảng Hướng Dẫn Chọn Size Chuẩn Cho Bé
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
