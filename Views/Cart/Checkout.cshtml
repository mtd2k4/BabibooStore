@model WebsiteBabyShop.Models.Order
@{
    ViewData["Title"] = "Thanh Toán Đơn Hàng - BabyShop";
    var cart = ViewBag.Cart as List<WebsiteBabyShop.Models.CartItem> ?? new List<WebsiteBabyShop.Models.CartItem>();
    int userPoints = ViewBag.UserRewardPoints != null ? (int)ViewBag.UserRewardPoints : 0;
    string memberTier = ViewBag.UserMemberTier != null ? (string)ViewBag.UserMemberTier : "Thành viên hạng Đồng";
    if (memberTier == "Mẹ Đồng") { memberTier = "Thành viên hạng Đồng"; }
    decimal maxPointDiscount = userPoints * 100;

    var appliedCoupon = ViewBag.AppliedCoupon as WebsiteBabyShop.Models.Coupon;
    var availableCoupons = ViewBag.AvailableCoupons as List<WebsiteBabyShop.Models.Coupon> ?? new List<WebsiteBabyShop.Models.Coupon>();
    var userVouchers = ViewBag.UserVouchers as List<WebsiteBabyShop.Models.UserCoupon> ?? new List<WebsiteBabyShop.Models.UserCoupon>();
    string? couponError = TempData["CouponError"] as string;
    string? couponSuccess = TempData["CouponSuccess"] as string;
    string? couponWarning = ViewBag.CouponWarning as string;
    var currentUser = ViewBag.CurrentUser as WebsiteBabyShop.Models.User;
}

<script>
    // Dọn sạch ngay lập tức mọi cache tạm từ phiên đăng nhập trước hoặc tài khoản khác
    (function () {
        try {
            var isCoupon = sessionStorage.getItem("checkout_coupon_action");
            var raw = sessionStorage.getItem("checkout_temp_data");
            if (isCoupon !== "1" || !raw) {
                sessionStorage.removeItem("checkout_temp_data");
                sessionStorage.removeItem("checkout_coupon_action");
            } else {
                var d = JSON.parse(raw);
                if (!d || d.username !== "@(currentUser?.Username ?? "")") {
                    sessionStorage.removeItem("checkout_temp_data");
                    sessionStorage.removeItem("checkout_coupon_action");
                }
            }
        } catch (e) {
            sessionStorage.removeItem("checkout_temp_data");
            sessionStorage.removeItem("checkout_coupon_action");
        }
    })();
</script>

<div class="container py-3 py-md-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index"><i class="bi bi-house"></i> Trang Chủ</a></li>
            <li class="breadcrumb-item"><a asp-controller="Cart" asp-action="Index">Giỏ Hàng</a></li>
            <li class="breadcrumb-item active" aria-current="page">Thanh Toán</li>
        </ol>
    </nav>

    <h2 class="fw-bold mb-4"><i class="bi bi-shield-check text-success me-2"></i>Thông Tin Giao Hàng & Thanh Toán</h2>

    <form asp-action="Checkout" method="post">
        @Html.AntiForgeryToken()
        <div class="row g-4">
            <!-- Left: Delivery Information -->
            <div class="col-12 col-lg-7">
                <div class="bg-white rounded-4 shadow-sm border p-4 mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-geo-alt text-primary me-2"></i>1. Địa Chỉ Nhận Hàng</h5>
                    </div>

                    @if (currentUser != null)
                    {
                        bool isMissingName = string.IsNullOrWhiteSpace(currentUser.FullName);
                        bool isMissingPhone = string.IsNullOrWhiteSpace(currentUser.PhoneNumber);
                        bool isMissingEmail = string.IsNullOrWhiteSpace(currentUser.Email);
                        bool isMissingAddress = string.IsNullOrWhiteSpace(currentUser.Address);
                        bool hasAnyMissing = isMissingName || isMissingPhone || isMissingEmail || isMissingAddress;

                        if (hasAnyMissing)
                        {
                            <div class="alert alert-warning py-2 px-3 mb-3 small rounded-3 d-flex align-items-center gap-2">
                                <i class="bi bi-exclamation-circle-fill text-warning fs-5 flex-shrink-0"></i>
                                <div>
                                    <strong>Thông tin tài khoản chưa đầy đủ:</strong> Các mục đánh dấu <span class="badge bg-warning text-dark">Bắt buộc nhập</span> cần được bổ sung. Sau khi đặt hàng thành công, hệ thống sẽ <strong>tự động lưu thông tin vào tài khoản</strong> để làm mặc định cho các lần mua sau!
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-success bg-success bg-opacity-10 text-success border border-success border-opacity-25 py-2 px-3 mb-3 small rounded-3 d-flex align-items-center gap-2">
                                <i class="bi bi-check-circle-fill text-success fs-5 flex-shrink-0"></i>
                                <div>
                                    Đã đồng bộ thông tin giao hàng thật từ tài khoản <strong>@(currentUser.FullName)</strong>. Bạn có thể kiểm tra hoặc điều chỉnh nếu giao tới địa chỉ khác.
                                </div>
                            </div>
                        }
                    }

                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <div class="d-flex justify-content-between align-items-center mb-1 flex-wrap gap-1">
                                <label asp-for="CustomerName" class="form-label fw-bold small mb-0">Họ và tên người nhận (*)</label>
                                @if (currentUser != null)
                                {
                                    if (!string.IsNullOrWhiteSpace(currentUser.FullName))
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 small" style="font-size: 0.72rem;">
                                            <i class="bi bi-check-circle-fill me-1"></i>Từ tài khoản
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning bg-opacity-10 text-dark border border-warning border-opacity-25 small" style="font-size: 0.72rem;">
                                            <i class="bi bi-exclamation-triangle-fill text-warning me-1"></i>Chưa có - Bắt buộc nhập
                                        </span>
                                    }
                                }
                            </div>
                            <input asp-for="CustomerName" class="form-control rounded-3" placeholder="Nhập họ và tên người nhận (Bắt buộc)" value="@(Model.CustomerName ?? "")" required />
                            <span asp-validation-for="CustomerName" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <div class="d-flex justify-content-between align-items-center mb-1 flex-wrap gap-1">
                                <label asp-for="CustomerPhone" class="form-label fw-bold small mb-0">Số điện thoại liên hệ (*)</label>
                                @if (currentUser != null)
                                {
                                    if (!string.IsNullOrWhiteSpace(currentUser.PhoneNumber))
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 small" style="font-size: 0.72rem;">
                                            <i class="bi bi-check-circle-fill me-1"></i>Từ tài khoản
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning bg-opacity-10 text-dark border border-warning border-opacity-25 small" style="font-size: 0.72rem;">
                                            <i class="bi bi-exclamation-triangle-fill text-warning me-1"></i>Chưa có SĐT - Bắt buộc nhập
                                        </span>
                                    }
                                }
                            </div>
                            <input asp-for="CustomerPhone" class="form-control rounded-3" placeholder="Nhập số điện thoại liên hệ (Bắt buộc)" value="@(Model.CustomerPhone ?? "")" required />
                            <span asp-validation-for="CustomerPhone" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <div class="d-flex justify-content-between align-items-center mb-1 flex-wrap gap-1">
                                <label asp-for="CustomerEmail" class="form-label fw-bold small mb-0">Email (nhận xác nhận đơn hàng) (*)</label>
                                @if (currentUser != null)
                                {
                                    if (!string.IsNullOrWhiteSpace(currentUser.Email))
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 small" style="font-size: 0.72rem;">
                                            <i class="bi bi-check-circle-fill me-1"></i>Từ tài khoản
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning bg-opacity-10 text-dark border border-warning border-opacity-25 small" style="font-size: 0.72rem;">
                                            <i class="bi bi-exclamation-triangle-fill text-warning me-1"></i>Chưa có Email - Bắt buộc nhập
                                        </span>
                                    }
                                }
                            </div>
                            <input asp-for="CustomerEmail" type="email" class="form-control rounded-3" placeholder="Nhập email nhận xác nhận đơn hàng (Bắt buộc)" value="@(Model.CustomerEmail ?? "")" required />
                            <span asp-validation-for="CustomerEmail" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <div class="d-flex justify-content-between align-items-center mb-1 flex-wrap gap-1">
                                <label asp-for="ShippingAddress" class="form-label fw-bold small mb-0">
                                    Địa chỉ nhận hàng chi tiết <span class="text-danger">*</span>
                                </label>
                                @if (currentUser != null)
                                {
                                    if (!string.IsNullOrWhiteSpace(currentUser.Address))
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 small">
                                            <i class="bi bi-geo-alt-fill me-1"></i>Địa chỉ mặc định của bạn
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning bg-opacity-10 text-dark border border-warning border-opacity-25 small">
                                            <i class="bi bi-exclamation-triangle-fill text-warning me-1"></i>Chưa có địa chỉ - Bắt buộc nhập
                                        </span>
                                    }
                                }
                                else if (User.Identity?.IsAuthenticated ?? false)
                                {
                                    <span class="badge bg-light text-primary border small">
                                        <i class="bi bi-bookmark-check me-1"></i>Sẽ lưu làm địa chỉ mặc định
                                    </span>
                                }
                            </div>
                            <input asp-for="ShippingAddress" class="form-control rounded-3" placeholder="Số nhà, tên đường, Phường/Xã, Quận/Huyện, Tỉnh/TP (Bắt buộc nhập)" value="@(Model.ShippingAddress ?? "")" required />
                            @if (currentUser != null && string.IsNullOrWhiteSpace(currentUser.Address))
                            {
                                <div class="alert alert-warning py-2 px-3 mt-2 mb-0 small rounded-3 d-flex align-items-center gap-2">
                                    <i class="bi bi-info-circle-fill text-warning fs-5 flex-shrink-0"></i>
                                    <span>Tài khoản của bạn chưa có địa chỉ nhận hàng. Vui lòng nhập địa chỉ giao hàng, hệ thống sẽ <strong>tự động lưu làm địa chỉ mặc định</strong> cho các lần mua sau!</span>
                                </div>
                            }
                            else
                            {
                                <div class="form-text text-muted small mt-1">
                                    <i class="bi bi-info-circle me-1"></i>Địa chỉ nhận hàng sẽ được tự động lưu làm mặc định cho tài khoản của bạn và có thể thay đổi bất cứ lúc nào tại Hồ sơ cá nhân.
                                </div>
                            }
                            <span asp-validation-for="ShippingAddress" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Note" class="form-label fw-bold small">Ghi chú cho shipper / cửa hàng</label>
                            <textarea asp-for="Note" class="form-control rounded-3" rows="2" placeholder="Ví dụ: Giao giờ hành chính, bé 13kg mẹ nhớ check lại size giúp..."></textarea>
                        </div>
                    </div>
                </div>

                <!-- Payment Methods -->
                <div class="bg-white rounded-4 shadow-sm border p-4">
                    <h5 class="fw-bold mb-3 text-dark"><i class="bi bi-wallet2 text-primary me-2"></i>2. Phương Thức Thanh Toán</h5>

                    <div class="d-flex flex-column gap-3">
                        <div class="border rounded-3 p-3 d-flex align-items-center gap-3">
                            <input class="form-check-input mt-0" type="radio" asp-for="PaymentMethod" value="COD" id="payCod" checked />
                            <label class="form-check-label w-100 cursor-pointer" for="payCod">
                                <div class="fw-bold"><i class="bi bi-cash-coin text-success me-1"></i> Thanh toán khi nhận hàng (COD)</div>
                                <div class="text-muted small">Mẹ nhận hàng, mở đồng kiểm đồ xinh cho bé rồi mới thanh toán tiền cho shipper.</div>
                            </label>
                        </div>

                        <div class="border rounded-3 p-3 d-flex align-items-center gap-3">
                            <input class="form-check-input mt-0" type="radio" asp-for="PaymentMethod" value="BankTransfer" id="payBank" />
                            <label class="form-check-label w-100 cursor-pointer" for="payBank">
                                <div class="fw-bold"><i class="bi bi-qr-code text-primary me-1"></i> Chuyển khoản ngân hàng (VietQR / Quét mã 24/7)</div>
                                <div class="text-muted small">Quét mã QR chuyển khoản nhanh chóng, xác nhận đơn hàng tự động.</div>
                            </label>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right: Order Items Review & Total -->
            <div class="col-12 col-lg-5">
                <div class="bg-white rounded-4 shadow-sm border p-4 sticky-top" style="top: 100px;">
                    <h5 class="fw-bold mb-3">Đơn Hàng Của Bạn (@cart.Sum(c => c.Quantity) món)</h5>

                    <!-- Cart Item mini list -->
                    <div class="overflow-auto pe-1 mb-3" style="max-height: 240px;">
                        @foreach (var item in cart)
                        {
                            <div class="d-flex align-items-center gap-3 py-2 border-bottom">
                                <img src="@(string.IsNullOrEmpty(item.ProductImage) ? "https://images.unsplash.com/photo-1622290291468-a28f7a7dc6a8?auto=format&fit=crop&w=100&q=80" : item.ProductImage)" 
                                     alt="@item.ProductName" class="rounded-2" style="width: 50px; height: 50px; object-fit: cover;" />
                                <div class="flex-grow-1 small">
                                    <div class="fw-bold text-truncate" style="max-width: 180px;">@item.ProductName</div>
                                    <div class="text-muted">Size: @(item.Size ?? "-") | @(item.Color ?? "-")</div>
                                    <div>SL: @item.Quantity &times; @item.Price.ToString("N0") đ</div>
                                </div>
                                <div class="fw-bold text-end">
                                    @item.TotalPrice.ToString("N0") đ
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Voucher / Mã Giảm Giá Card -->
                    <div class="card border rounded-3 p-3 mb-3 bg-white shadow-sm">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <label class="fw-bold small text-dark mb-0">
                                <i class="bi bi-ticket-perforated-fill text-danger me-1"></i>Mã Giảm Giá / Voucher
                            </label>
                            @if (userVouchers.Any() || availableCoupons.Any())
                            {
                                <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none text-primary fw-semibold small" data-bs-toggle="modal" data-bs-target="#checkoutVouchersModal">
                                    <i class="bi bi-stars text-warning me-1"></i>Kho voucher (@(userVouchers.Count > 0 ? userVouchers.Count : availableCoupons.Count))
                                </button>
                            }
                        </div>

                        @if (!string.IsNullOrEmpty(couponSuccess))
                        {
                            <div class="alert alert-success alert-dismissible fade show rounded-3 p-2 small mb-2" role="alert">
                                <i class="bi bi-check-circle-fill me-1"></i>@couponSuccess
                                <button type="button" class="btn-close p-2" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(couponError))
                        {
                            <div class="alert alert-danger alert-dismissible fade show rounded-3 p-2 small mb-2" role="alert">
                                <i class="bi bi-exclamation-circle-fill me-1"></i>@couponError
                                <button type="button" class="btn-close p-2" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(couponWarning))
                        {
                            <div class="alert alert-warning alert-dismissible fade show rounded-3 p-2 small mb-2" role="alert">
                                <i class="bi bi-exclamation-triangle-fill me-1"></i>@couponWarning
                                <button type="button" class="btn-close p-2" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        }

                        @if (appliedCoupon != null || Model.DiscountAmount > 0 || !string.IsNullOrEmpty(Model.CouponCode))
                        {
                            string displayCode = appliedCoupon?.Code ?? Model.CouponCode ?? "";
                            string displayTitle = appliedCoupon?.Title ?? "Mã giảm giá ưu đãi";
                            decimal displayDiscount = Model.DiscountAmount > 0 ? Model.DiscountAmount : (ViewBag.DiscountAmount != null ? (decimal)ViewBag.DiscountAmount : 0);

                            <div class="p-2 px-3 rounded-3 bg-success-subtle border border-success-subtle d-flex align-items-center justify-content-between">
                                <div>
                                    <div class="d-flex align-items-center gap-1">
                                        <span class="badge bg-success text-white fw-bold">@displayCode</span>
                                        <span class="small fw-bold text-success">-@displayDiscount.ToString("N0") đ</span>
                                    </div>
                                    <div class="text-muted" style="font-size: 0.75rem;">@displayTitle</div>
                                </div>
                                <button type="button" class="btn btn-outline-danger btn-sm rounded-pill py-0 px-2 small" onclick="removeCouponFromCheckout()">
                                    <i class="bi bi-x me-1"></i>Gỡ mã
                                </button>
                            </div>
                        }
                        else
                        {
                            <div class="input-group input-group-sm">
                                <input type="text" id="checkoutCouponInput" class="form-control text-uppercase font-monospace" placeholder="Nhập mã voucher..." onkeydown="if(event.key==='Enter'){event.preventDefault();applyCouponFromCheckout();}" />
                                <button class="btn btn-baby-primary px-3 fw-bold" type="button" onclick="applyCouponFromCheckout()">
                                    Áp dụng
                                </button>
                            </div>
                        }
                    </div>

                    <!-- Baby Club Points Card -->
                    @if (userPoints > 0)
                    {
                        <div class="p-3 rounded-3 bg-warning-subtle bg-opacity-25 border border-warning-subtle mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="rounded-circle bg-warning text-dark d-flex align-items-center justify-content-center fw-bold" style="width: 28px; height: 28px; font-size: 0.8rem;">
                                        <i class="bi bi-star-fill"></i>
                                    </div>
                                    <div>
                                        <div class="fw-bold small text-dark">Baby Club: <span class="badge bg-warning text-dark">@memberTier</span></div>
                                        <div class="text-muted small">Bạn có <strong>@userPoints.ToString("N0") điểm</strong> (tương đương @maxPointDiscount.ToString("N0")đ)</div>
                                    </div>
                                </div>
                                <div class="form-check form-switch m-0">
                                    <input class="form-check-input" type="checkbox" name="usePoints" value="true" id="usePointsCheck" onchange="togglePointsUsage(this.checked)">
                                </div>
                            </div>

                            <div id="pointsUsageSection" style="display: none;" class="pt-2 border-top border-warning-subtle">
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <label for="pointsToUseInput" class="small text-dark fw-semibold text-nowrap">Dùng:</label>
                                    <input type="number" id="pointsToUseInput" name="pointsToUse" class="form-control form-control-sm text-center fw-bold" style="width: 90px;" value="@userPoints" min="1" max="@userPoints" oninput="updatePointsDiscount(this.value)">
                                    <span class="small text-muted text-nowrap">điểm (-<span id="pointDiscountDisplay" class="fw-bold text-danger">@maxPointDiscount.ToString("N0")</span>đ)</span>
                                    <button type="button" class="btn btn-sm btn-outline-warning text-dark py-0 px-2 ms-auto small" onclick="useMaxPoints()">Dùng hết</button>
                                </div>
                                <span class="text-muted small" style="font-size: 0.75rem;">* Tỉ lệ quy đổi: 100 điểm = 10.000 VNĐ (1 điểm = 100 VNĐ) trừ trực tiếp vào đơn hàng.</span>
                            </div>
                        </div>
                    }
                    else if (User.Identity?.IsAuthenticated ?? false)
                    {
                        <div class="p-2 px-3 rounded-3 bg-light border mb-3 d-flex align-items-center justify-content-between">
                            <div class="small text-muted"><i class="bi bi-star me-1 text-warning"></i>Baby Club: <strong>0 điểm</strong> (Tích 1 điểm cho mỗi 1.000đ chi tiêu - đơn từ 100k nhận 100 điểm khi đơn giao thành công)</div>
                        </div>
                    }

                    <input type="hidden" asp-for="CouponCode" />
                    <input type="hidden" asp-for="DiscountAmount" />
                    <input type="hidden" asp-for="MemberDiscount" />

                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Tiền hàng:</span>
                        <span class="fw-bold">@Model.SubTotal.ToString("N0") đ</span>
                    </div>

                    @if (Model.DiscountAmount > 0)
                    {
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-success">
                                <i class="bi bi-tag-fill me-1"></i>Giảm giá voucher (@Model.CouponCode):
                            </span>
                            <span class="text-danger fw-bold">-@Model.DiscountAmount.ToString("N0") đ</span>
                        </div>
                    }

                    @if (Model.MemberDiscount > 0)
                    {
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-primary fw-semibold">
                                <i class="bi bi-award-fill me-1"></i>Chiết khấu @memberTier (@(ViewBag.TierDiscountPercent ?? 3)%):
                            </span>
                            <span class="text-danger fw-bold">-@Model.MemberDiscount.ToString("N0") đ</span>
                        </div>
                    }

                    <div id="pointDiscountRow" class="d-flex justify-content-between mb-2" style="display: none !important;">
                        <span class="text-warning-emphasis">
                            <i class="bi bi-star-fill text-warning me-1"></i>Điểm thưởng Baby Club:
                        </span>
                        <span id="pointDiscountText" class="text-danger fw-bold">-0 đ</span>
                    </div>

                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Phí giao hàng:</span>
                        @if (Model.ShippingFee == 0)
                        {
                            <span class="text-success fw-bold">MIỄN PHÍ</span>
                        }
                        else
                        {
                            <span class="fw-bold">@Model.ShippingFee.ToString("N0") đ</span>
                        }
                    </div>

                    <hr class="opacity-10 my-3" />

                    <div class="d-flex justify-content-between mb-4">
                        <span class="fs-5 fw-bold">Tổng thanh toán:</span>
                        <span class="fs-4 fw-bold text-dark" id="checkoutTotalDisplay">@Model.TotalAmount.ToString("N0") đ</span>
                    </div>

                    <button type="submit" class="btn btn-baby-primary w-100 justify-content-center py-3 fs-5">
                        <i class="bi bi-check-circle-fill me-2"></i> HOÀN TẤT ĐẶT HÀNG
                    </button>

                    <div class="text-center mt-3 text-muted small">
                        Bằng việc bấm đặt hàng, bạn đồng ý với <a asp-controller="Policy" asp-action="Return" target="_blank" class="text-decoration-underline text-baby-primary">chính sách chất lượng và đổi trả tận nhà trong 7 ngày</a> của BabyShop.
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

<!-- Modal Danh Sách Voucher Khả Dụng -->
<div class="modal fade" id="checkoutVouchersModal" tabindex="-1" aria-labelledby="checkoutVouchersModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom py-3 px-4">
                <h5 class="modal-title fw-bold text-dark" id="checkoutVouchersModalLabel">
                    <i class="bi bi-ticket-perforated-fill text-danger me-2"></i>Chọn Mã Giảm Giá / Voucher
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-3 p-md-4">
                @if (userVouchers.Any())
                {
                    <div class="mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="small fw-bold text-dark"><i class="bi bi-wallet2 text-danger me-1"></i>Kho Voucher Của Bạn (@userVouchers.Count):</span>
                            <a asp-controller="Account" asp-action="MyVouchers" class="small text-primary text-decoration-none fw-semibold">
                                <i class="bi bi-box-arrow-up-right me-1"></i>Quản lý kho
                            </a>
                        </div>
                        <div class="d-flex flex-column gap-3">
                            @foreach (var uv in userVouchers)
                            {
                                var c = uv.Coupon;
                                if (c == null) continue;
                                bool isCurrent = !string.IsNullOrEmpty(Model.CouponCode) && Model.CouponCode.Equals(c.Code, StringComparison.OrdinalIgnoreCase);
                                bool isFlashNotStarted = c.IsFlashHunt && DateTime.Now < c.StartDate;
                                bool isEligible = (c.MinOrderAmount <= 0 || Model.SubTotal >= c.MinOrderAmount) && !isFlashNotStarted;
                                decimal deficit = c.MinOrderAmount - Model.SubTotal;
                                var timeLeft = uv.ExpiryDate - DateTime.Now;

                                <div class="p-3 rounded-3 border @(isCurrent ? "border-success bg-success-subtle shadow-sm" : isFlashNotStarted ? "border-danger-subtle bg-light shadow-sm" : c.IsForYou ? "border-warning bg-warning-subtle bg-opacity-25 shadow-sm" : isEligible ? "border-primary-subtle bg-white shadow-sm" : "border-light-subtle bg-light text-muted opacity-75")">
                                    <div class="d-flex align-items-center justify-content-between">
                                        <div class="pe-2">
                                            <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                                                <span class="badge @(isCurrent ? "bg-success text-white" : isFlashNotStarted ? "bg-secondary text-white" : c.IsForYou ? "bg-warning text-dark border border-warning" : isEligible ? "bg-primary-subtle text-primary border border-primary-subtle" : "bg-secondary text-white") font-monospace fw-bold fs-6">
                                                    @c.Code
                                                </span>
                                                @if (c.IsFlashHunt)
                                                {
                                                    if (isFlashNotStarted)
                                                    {
                                                        <span class="badge bg-danger text-white rounded-pill px-2 py-0 small fw-bold" style="font-size: 0.68rem;">
                                                            <i class="bi bi-alarm-fill me-1"></i>Sắp mở lúc @c.StartDate.ToString("HH:mm dd/MM")
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-danger text-white rounded-pill px-2 py-0 small fw-bold" style="font-size: 0.68rem;">
                                                            <i class="bi bi-lightning-charge-fill me-1"></i>Săn Giờ Vàng (Đang mở)
                                                        </span>
                                                    }
                                                }
                                                @if (c.IsForYou)
                                                {
                                                    <span class="badge bg-warning text-dark border border-warning-subtle rounded-pill px-2 py-0 small fw-bold" style="font-size: 0.68rem;">
                                                        <i class="bi bi-gift-fill me-1"></i>Độc Quyền 12H
                                                    </span>
                                                }
                                                <span class="fw-bold small text-dark">
                                                    @(c.DiscountType == WebsiteBabyShop.Models.DiscountType.Percentage ? $"Giảm {c.DiscountValue:0.#}%" : $"Giảm {c.DiscountValue:N0} đ")
                                                </span>
                                                @if (timeLeft.TotalHours < 24)
                                                {
                                                    <span class="badge bg-danger text-white rounded-pill px-2 py-0 small" style="font-size: 0.68rem;">Hết hạn hôm nay</span>
                                                }
                                                else if (timeLeft.TotalDays < 3)
                                                {
                                                    <span class="badge bg-warning text-dark rounded-pill px-2 py-0 small" style="font-size: 0.68rem;">Còn @((int)timeLeft.TotalDays) ngày</span>
                                                }
                                            </div>
                                            <div class="small text-dark fw-semibold">@c.Title</div>
                                            <div class="text-muted small" style="font-size: 0.76rem;">
                                                @if (c.MinOrderAmount > 0)
                                                {
                                                    <span>Đơn tối thiểu: <strong>@c.MinOrderAmount.ToString("N0") đ</strong></span>
                                                }
                                                @if (c.MaxDiscountAmount.HasValue && c.MaxDiscountAmount.Value > 0)
                                                {
                                                    <span> • Tối đa: <strong>@c.MaxDiscountAmount.Value.ToString("N0") đ</strong></span>
                                                }
                                            </div>
                                            <div class="small text-muted mt-1" style="font-size: 0.72rem;">
                                                <i class="bi bi-clock me-1 text-primary"></i>Hạn dùng trong kho: <strong>@uv.ExpiryDate.ToString("dd/MM/yyyy HH:mm")</strong>
                                            </div>
                                            @if (isFlashNotStarted)
                                            {
                                                var waitTime = c.StartDate - DateTime.Now;
                                                string waitText = waitTime.TotalHours >= 1 ? $"{(int)waitTime.TotalHours} giờ {waitTime.Minutes} phút" : $"{waitTime.Minutes} phút {waitTime.Seconds} giây";
                                                <div class="text-danger small mt-1 fw-semibold" style="font-size: 0.74rem;">
                                                    <i class="bi bi-hourglass-split me-1"></i>Ưu đãi Săn Giờ Vàng mở lúc @c.StartDate.ToString("HH:mm dd/MM") (còn @waitText)
                                                </div>
                                            }
                                            else if (!isEligible)
                                            {
                                                <div class="text-danger small mt-1" style="font-size: 0.74rem;">
                                                    <i class="bi bi-info-circle me-1"></i>Mua thêm @deficit.ToString("N0") đ để áp dụng
                                                </div>
                                            }
                                        </div>
                                        <div>
                                            @if (isFlashNotStarted)
                                            {
                                                <button type="button" class="btn btn-secondary btn-sm rounded-pill px-3 py-1 text-white opacity-75" disabled title="Mã Săn Giờ Vàng sẽ mở lúc @c.StartDate.ToString("HH:mm dd/MM/yyyy")">
                                                    <i class="bi bi-lock-fill me-1"></i>Chưa mở
                                                </button>
                                            }
                                            else if (isCurrent)
                                            {
                                                <span class="badge bg-success text-white py-2 px-3 rounded-pill small">
                                                    <i class="bi bi-check2-circle me-1"></i>Đang dùng
                                                </span>
                                            }
                                            else if (isEligible)
                                            {
                                                <button type="button" class="btn btn-baby-primary btn-sm rounded-pill px-3 py-1 fw-bold" onclick="applyCouponCode('@c.Code')">
                                                    Dùng mã
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="button" class="btn btn-light btn-sm rounded-pill px-3 py-1 text-muted" disabled>
                                                    Chưa đủ
                                                </button>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }

                @* Hiển thị các voucher toàn sàn chưa lưu vào kho *@
                @{
                    var userCouponIds = userVouchers.Select(uv => uv.CouponId).ToHashSet();
                    var otherCoupons = availableCoupons.Where(ac => !userCouponIds.Contains(ac.Id)).ToList();
                }

                @if (otherCoupons.Any())
                {
                    <div>
                        <div class="small fw-bold text-dark mb-2">
                            <i class="bi bi-stars text-warning me-1"></i>Voucher Toàn Sàn Khác:
                        </div>
                        <div class="d-flex flex-column gap-3">
                            @foreach (var c in otherCoupons)
                            {
                                bool isCurrent = !string.IsNullOrEmpty(Model.CouponCode) && Model.CouponCode.Equals(c.Code, StringComparison.OrdinalIgnoreCase);
                                bool isEligible = c.MinOrderAmount <= 0 || Model.SubTotal >= c.MinOrderAmount;
                                decimal deficit = c.MinOrderAmount - Model.SubTotal;

                                <div class="p-3 rounded-3 border @(isCurrent ? "border-success bg-success-subtle shadow-sm" : isEligible ? "border-primary-subtle bg-white" : "border-light-subtle bg-light text-muted opacity-75")">
                                    <div class="d-flex align-items-center justify-content-between">
                                        <div class="pe-2">
                                            <div class="d-flex align-items-center gap-2 mb-1">
                                                <span class="badge @(isCurrent ? "bg-success text-white" : isEligible ? "bg-primary-subtle text-primary border border-primary-subtle" : "bg-secondary text-white") font-monospace fw-bold fs-6">
                                                    @c.Code
                                                </span>
                                                <span class="fw-bold small text-dark">
                                                    @(c.DiscountType == WebsiteBabyShop.Models.DiscountType.Percentage ? $"Giảm {c.DiscountValue:0.#}%" : $"Giảm {c.DiscountValue:N0} đ")
                                                </span>
                                            </div>
                                            <div class="small text-dark fw-semibold">@c.Title</div>
                                            <div class="text-muted small" style="font-size: 0.76rem;">
                                                @if (c.MinOrderAmount > 0)
                                                {
                                                    <span>Đơn tối thiểu: <strong>@c.MinOrderAmount.ToString("N0") đ</strong></span>
                                                }
                                                @if (c.MaxDiscountAmount.HasValue && c.MaxDiscountAmount.Value > 0)
                                                {
                                                    <span> • Tối đa: <strong>@c.MaxDiscountAmount.Value.ToString("N0") đ</strong></span>
                                                }
                                            </div>
                                            <div class="small text-muted mt-1" style="font-size: 0.72rem;">
                                                <i class="bi bi-clock me-1"></i>Hạn dùng: @(c.ExpiryDate?.ToString("dd/MM/yyyy") ?? "Vô thời hạn")
                                            </div>
                                            @if (!isEligible)
                                            {
                                                <div class="text-danger small mt-1" style="font-size: 0.74rem;">
                                                    <i class="bi bi-info-circle me-1"></i>Mua thêm @deficit.ToString("N0") đ để áp dụng
                                                </div>
                                            }
                                        </div>
                                        <div>
                                            @if (isCurrent)
                                            {
                                                <span class="badge bg-success text-white py-2 px-3 rounded-pill small">
                                                    <i class="bi bi-check2-circle me-1"></i>Đang dùng
                                                </span>
                                            }
                                            else if (isEligible)
                                            {
                                                <button type="button" class="btn btn-outline-primary btn-sm rounded-pill px-3 py-1 fw-bold" onclick="applyCouponCode('@c.Code')">
                                                    Dùng mã
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="button" class="btn btn-light btn-sm rounded-pill px-3 py-1 text-muted" disabled>
                                                    Chưa đủ
                                                </button>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }

                @if (!userVouchers.Any() && !otherCoupons.Any())
                {
                    <div class="text-center py-4 text-muted">
                        <i class="bi bi-ticket-detailed fs-1 text-muted d-block mb-2"></i>
                        <span>Hiện chưa có mã giảm giá nào khả dụng cho đơn hàng này.</span>
                    </div>
                }
            </div>
            <div class="modal-footer bg-light py-2">
                <button type="button" class="btn btn-secondary btn-sm rounded-pill px-3" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

<script>
    var baseCheckoutTotal = @Model.TotalAmount;
    var maxUserPoints = @userPoints;

    function togglePointsUsage(use) {
        var section = document.getElementById("pointsUsageSection");
        var row = document.getElementById("pointDiscountRow");
        var input = document.getElementById("pointsToUseInput");
        if (!section || !row || !input) return;

        if (use) {
            section.style.display = "block";
            row.style.setProperty("display", "flex", "important");
            updatePointsDiscount(input.value);
        } else {
            section.style.display = "none";
            row.style.setProperty("display", "none", "important");
            document.getElementById("checkoutTotalDisplay").innerText = Number(baseCheckoutTotal).toLocaleString("vi-VN") + " đ";
        }
    }

    function updatePointsDiscount(pts) {
        pts = parseInt(pts) || 0;
        if (pts > maxUserPoints) { pts = maxUserPoints; document.getElementById("pointsToUseInput").value = pts; }
        if (pts < 0) { pts = 0; document.getElementById("pointsToUseInput").value = 0; }
        var discount = pts * 100;
        var finalTotal = Math.max(0, baseCheckoutTotal - discount);
        document.getElementById("pointDiscountDisplay").innerText = Number(discount).toLocaleString("vi-VN");
        document.getElementById("pointDiscountText").innerText = "-" + Number(discount).toLocaleString("vi-VN") + " đ";
        document.getElementById("checkoutTotalDisplay").innerText = Number(finalTotal).toLocaleString("vi-VN") + " đ";
    }

    function useMaxPoints() {
        var input = document.getElementById("pointsToUseInput");
        if (input) {
            input.value = maxUserPoints;
            updatePointsDiscount(maxUserPoints);
        }
    }

    var currentUsername = "@(currentUser?.Username ?? "")";

    // Quản lý lưu trữ & phục hồi dữ liệu form CHỈ khi áp dụng hoặc gỡ mã giảm giá
    function saveCheckoutFormData() {
        var data = {
            username: currentUsername,
            customerName: document.querySelector("input[name='CustomerName']")?.value || "",
            customerPhone: document.querySelector("input[name='CustomerPhone']")?.value || "",
            customerEmail: document.querySelector("input[name='CustomerEmail']")?.value || "",
            shippingAddress: document.querySelector("input[name='ShippingAddress']")?.value || "",
            note: document.querySelector("textarea[name='Note']")?.value || "",
            paymentMethod: document.querySelector("input[name='PaymentMethod']:checked")?.value || "COD",
            usePoints: document.getElementById("usePointsCheck")?.checked || false,
            pointsToUse: document.getElementById("pointsToUseInput")?.value || ""
        };
        sessionStorage.setItem("checkout_temp_data", JSON.stringify(data));
        sessionStorage.setItem("checkout_coupon_action", "1");
    }

    function restoreCheckoutFormData() {
        // Chỉ phục hồi khi VỪA bấm áp dụng hoặc gỡ mã giảm giá (redirect sau thao tác mã trong cùng phiên)
        var isCouponAction = sessionStorage.getItem("checkout_coupon_action");
        sessionStorage.removeItem("checkout_coupon_action");

        // Nếu truy cập bình thường (hoặc chuyển tài khoản, tạo tài khoản mới): XÓA SẠCH cache để dùng 100% dữ liệu thật từ Server/Database
        if (isCouponAction !== "1") {
            sessionStorage.removeItem("checkout_temp_data");
            return;
        }

        var raw = sessionStorage.getItem("checkout_temp_data");
        sessionStorage.removeItem("checkout_temp_data");
        if (!raw) return;

        try {
            var data = JSON.parse(raw);
            // BẮT BUỘC kiểm tra khớp đúng tài khoản đang đăng nhập, nếu khác tài khoản thì lập tức hủy bỏ!
            if (!data.username || data.username !== currentUsername) {
                return;
            }

            if (data.customerName && document.querySelector("input[name='CustomerName']")) {
                document.querySelector("input[name='CustomerName']").value = data.customerName;
            }
            if (data.customerPhone && document.querySelector("input[name='CustomerPhone']")) {
                document.querySelector("input[name='CustomerPhone']").value = data.customerPhone;
            }
            if (data.customerEmail && document.querySelector("input[name='CustomerEmail']")) {
                document.querySelector("input[name='CustomerEmail']").value = data.customerEmail;
            }
            if (data.shippingAddress && document.querySelector("input[name='ShippingAddress']")) {
                document.querySelector("input[name='ShippingAddress']").value = data.shippingAddress;
            }
            if (data.note && document.querySelector("textarea[name='Note']")) {
                document.querySelector("textarea[name='Note']").value = data.note;
            }
            if (data.paymentMethod) {
                var radio = document.querySelector("input[name='PaymentMethod'][value='" + data.paymentMethod + "']");
                if (radio) radio.checked = true;
            }
            if (data.usePoints && maxUserPoints > 0) {
                var chk = document.getElementById("usePointsCheck");
                if (chk) {
                    chk.checked = true;
                    togglePointsUsage(true);
                    if (data.pointsToUse) {
                        var inp = document.getElementById("pointsToUseInput");
                        if (inp) {
                            inp.value = data.pointsToUse;
                            updatePointsDiscount(data.pointsToUse);
                        }
                    }
                }
            }
        } catch (e) {
            console.error("Error restoring checkout temp data", e);
        }
    }

    function applyCouponFromCheckout() {
        var input = document.getElementById("checkoutCouponInput");
        var code = input ? input.value.trim() : "";
        if (!code) {
            alert("Vui lòng nhập mã giảm giá.");
            return;
        }
        applyCouponCode(code);
    }

    function applyCouponCode(code) {
        saveCheckoutFormData();
        var token = document.querySelector("input[name='__RequestVerificationToken']")?.value || "";
        var form = document.createElement("form");
        form.method = "POST";
        form.action = "/Cart/ApplyCoupon";

        var inpToken = document.createElement("input");
        inpToken.type = "hidden";
        inpToken.name = "__RequestVerificationToken";
        inpToken.value = token;
        form.appendChild(inpToken);

        var inpCode = document.createElement("input");
        inpCode.type = "hidden";
        inpCode.name = "couponCode";
        inpCode.value = code;
        form.appendChild(inpCode);

        var inpUrl = document.createElement("input");
        inpUrl.type = "hidden";
        inpUrl.name = "returnUrl";
        inpUrl.value = "/Cart/Checkout";
        form.appendChild(inpUrl);

        document.body.appendChild(form);
        form.submit();
    }

    function removeCouponFromCheckout() {
        saveCheckoutFormData();
        var token = document.querySelector("input[name='__RequestVerificationToken']")?.value || "";
        var form = document.createElement("form");
        form.method = "POST";
        form.action = "/Cart/RemoveCoupon";

        var inpToken = document.createElement("input");
        inpToken.type = "hidden";
        inpToken.name = "__RequestVerificationToken";
        inpToken.value = token;
        form.appendChild(inpToken);

        var inpUrl = document.createElement("input");
        inpUrl.type = "hidden";
        inpUrl.name = "returnUrl";
        inpUrl.value = "/Cart/Checkout";
        form.appendChild(inpUrl);

        document.body.appendChild(form);
        form.submit();
    }

    document.addEventListener("DOMContentLoaded", function () {
        restoreCheckoutFormData();
        var mainForm = document.querySelector("form[action*='Checkout']");
        if (mainForm) {
            mainForm.addEventListener("submit", function () {
                sessionStorage.removeItem("checkout_temp_data");
                sessionStorage.removeItem("checkout_coupon_action");
            });
        }
    });
</script>
