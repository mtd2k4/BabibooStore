@model WebsiteBabyShop.Models.Category
@{
    ViewData["Title"] = "Thêm Mới Danh Mục";
}

<div class="card border-0 rounded-4 shadow-sm p-4">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <h4 class="fw-bold m-0"><i class="bi bi-plus-circle-fill text-warning-emphasis me-2"></i>Thêm Mới Danh Mục</h4>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Quay Lại
        </a>
    </div>

    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 small"></div>

        <div class="row g-3">
            <div class="col-12 col-md-6">
                <label asp-for="Name" class="form-label fw-bold small"></label>
                <input asp-for="Name" class="form-control rounded-3" placeholder="Ví dụ: Đồ Bơi Trẻ Em" required />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <div class="col-12 col-md-6">
                <label asp-for="Slug" class="form-label fw-bold small"></label>
                <input asp-for="Slug" class="form-control rounded-3" placeholder="do-boi-tre-em (tùy chọn)" />
            </div>

            <div class="col-12 col-md-8">
                <label asp-for="ImageUrl" class="form-label fw-bold small"></label>
                <input asp-for="ImageUrl" class="form-control rounded-3" placeholder="https://images.unsplash.com/..." />
            </div>

            <div class="col-12 col-md-4">
                <label asp-for="DisplayOrder" class="form-label fw-bold small"></label>
                <input asp-for="DisplayOrder" type="number" class="form-control rounded-3" />
            </div>

            <div class="col-12">
                <label asp-for="Description" class="form-label fw-bold small"></label>
                <textarea asp-for="Description" class="form-control rounded-3" rows="3" placeholder="Mô tả danh mục..."></textarea>
            </div>

            <div class="col-12">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" asp-for="IsActive" id="catActiveCheck">
                    <label class="form-check-label fw-bold small" for="catActiveCheck">Hiển thị trên trang chủ & menu</label>
                </div>
            </div>

            <div class="col-12 pt-3">
                <button type="submit" class="btn btn-primary-baby px-4 py-2">
                    <i class="bi bi-check-circle-fill me-1"></i> Tạo Danh Mục
                </button>
            </div>
        </div>
    </form>
</div>
