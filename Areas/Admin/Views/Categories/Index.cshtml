@model List<WebsiteBabyShop.Models.Category>
@{
    ViewData["Title"] = "Quản Lý Danh Mục Thời Trang Bé";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold m-0"><i class="bi bi-tags-fill text-warning-emphasis me-2"></i>Danh Sách Danh Mục (@(ViewBag.TotalItems ?? Model.Count))</h4>
    <a asp-action="Create" class="btn btn-primary-baby">
        <i class="bi bi-plus-circle-fill me-1"></i> Thêm Danh Mục Mới
    </a>
</div>

<div class="card border-0 rounded-4 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Ảnh</th>
                        <th>Tên danh mục</th>
                        <th>Slug</th>
                        <th>Số sản phẩm</th>
                        <th>Trạng thái</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "https://images.unsplash.com/photo-1515488042361-ee00e0ddd4e4?auto=format&fit=crop&w=100&q=80" : item.ImageUrl)" 
                                     alt="@item.Name" class="rounded-circle" style="width: 48px; height: 48px; object-fit: cover;" />
                            </td>
                            <td class="fw-bold">@item.Name</td>
                            <td class="text-muted small">@item.Slug</td>
                            <td>
                                <span class="badge bg-primary-subtle text-primary fw-bold">@item.Products.Count sản phẩm</span>
                            </td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success">Hiển thị</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Ẩn</span>
                                }
                            </td>
                            <td>
                                <div class="d-flex gap-2">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary rounded-circle" title="Chỉnh sửa">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn xóa danh mục này?');" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-circle" title="Xóa">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <partial name="_AdminPagination" />
    </div>
</div>
