@model List<WebsiteBabyShop.Models.BankAccount>
@{
    ViewData["Title"] = "Cấu Hình Ngân Hàng & VietQR";
    var defaultAcc = ViewBag.DefaultAccount as WebsiteBabyShop.Models.BankAccount;
    int totalCount = Model.Count;
    int activeCount = Model.Count(b => b.IsActive);
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
    <div>
        <h4 class="fw-bold m-0">
            <i class="bi bi-bank2 text-primary me-2"></i>Cấu Hình Tài Khoản Ngân Hàng & VietQR 24/7
        </h4>
        <div class="text-muted small mt-1">
            Quản lý tài khoản thụ hưởng hiển thị trên trang đặt hàng thành công và Email xác nhận đơn hàng tự động.
        </div>
    </div>
    <a asp-action="Create" class="btn btn-primary-baby shadow-sm">
        <i class="bi bi-plus-circle-fill me-1"></i> Thêm Tài Khoản Ngân Hàng
    </a>
</div>

<!-- KPI Summary Cards -->
<div class="row g-3 mb-4">
    <div class="col-12 col-md-4">
        <div class="card border-0 rounded-4 shadow-sm p-3 h-100 bg-white">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-3 p-3 bg-primary-subtle text-primary fs-4 d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                    <i class="bi bi-bank"></i>
                </div>
                <div>
                    <div class="text-muted small fw-semibold">Tổng Tài Khoản Cấu Hình</div>
                    <div class="fs-4 fw-bold text-dark">@totalCount tài khoản</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card border-0 rounded-4 shadow-sm p-3 h-100 bg-white">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-3 p-3 bg-success-subtle text-success fs-4 d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                    <i class="bi bi-qr-code-scan"></i>
                </div>
                <div>
                    <div class="text-muted small fw-semibold">Đang Mở Nhận Chuyển Khoản</div>
                    <div class="fs-4 fw-bold text-dark">@activeCount / @totalCount đang bật</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card border-0 rounded-4 shadow-sm p-3 h-100 bg-white">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-3 p-3 bg-warning-subtle text-warning-emphasis fs-4 d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                    <i class="bi bi-star-fill"></i>
                </div>
                <div class="overflow-hidden">
                    <div class="text-muted small fw-semibold">Ngân Hàng Mặc Định (VietQR)</div>
                    @if (defaultAcc != null)
                    {
                        <div class="fw-bold text-dark text-truncate">@defaultAcc.BankCode • @defaultAcc.AccountNumber</div>
                        <div class="small text-muted text-truncate">@defaultAcc.AccountHolder</div>
                    }
                    else
                    {
                        <div class="fw-bold text-danger">Chưa có tài khoản bật</div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Spotlight Card: Default Active VietQR Preview -->
@if (defaultAcc != null)
{
    var sampleQr = defaultAcc.BuildVietQrUrl(250000, "BS-DEMO-8888");
    <div class="card border-0 rounded-4 shadow-sm mb-4 bg-white overflow-hidden">
        <div class="card-body p-4">
            <div class="row g-4 align-items-center">
                <div class="col-12 col-md-4 col-lg-3 text-center">
                    <div class="p-3 border rounded-4 bg-light d-inline-block">
                        <img src="@sampleQr" alt="VietQR Mặc Định" class="img-fluid rounded-3" style="max-width: 190px; height: auto;" />
                        <div class="small text-muted mt-2">
                            <i class="bi bi-eye me-1"></i>Mẫu đơn thử: 250.000đ
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-8 col-lg-9">
                    <div class="d-flex align-items-center gap-2 flex-wrap mb-2">
                        <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1">
                            <i class="bi bi-check-circle-fill me-1"></i>Đang áp dụng mặc định cho VietQR & Email
                        </span>
                        <span class="badge bg-light text-dark border px-3 py-1">
                            Mẫu QR: @defaultAcc.QrTemplate
                        </span>
                    </div>
                    <h5 class="fw-bold text-dark mb-3">@defaultAcc.BankName</h5>
                    <div class="row g-3 mb-3">
                        <div class="col-12 col-sm-6 col-lg-4">
                            <div class="p-3 rounded-3 bg-light border">
                                <div class="small text-muted">Số tài khoản thụ hưởng</div>
                                <div class="fw-bold fs-5 font-monospace text-primary">@defaultAcc.AccountNumber</div>
                            </div>
                        </div>
                        <div class="col-12 col-sm-6 col-lg-4">
                            <div class="p-3 rounded-3 bg-light border">
                                <div class="small text-muted">Chủ tài khoản</div>
                                <div class="fw-bold fs-6 text-dark text-uppercase">@defaultAcc.AccountHolder</div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-4">
                            <div class="p-3 rounded-3 bg-light border">
                                <div class="small text-muted">Chi nhánh</div>
                                <div class="fw-semibold text-dark">@(string.IsNullOrEmpty(defaultAcc.Branch) ? "Toàn quốc (Napas 24/7)" : defaultAcc.Branch)</div>
                            </div>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(defaultAcc.Note))
                    {
                        <div class="alert alert-light border rounded-3 py-2 px-3 small mb-3 text-dark">
                            <i class="bi bi-info-circle text-primary me-1"></i>
                            <strong>Ghi chú hiển thị cho khách:</strong> @defaultAcc.Note
                        </div>
                    }
                    <a asp-action="Edit" asp-route-id="@defaultAcc.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                        <i class="bi bi-pencil-square me-1"></i> Chỉnh sửa tài khoản mặc định
                    </a>
                </div>
            </div>
        </div>
    </div>
}

<!-- Accounts Table -->
<div class="card border-0 rounded-4 shadow-sm bg-white">
    <div class="card-header bg-white border-bottom py-3 px-4">
        <h6 class="fw-bold m-0 text-dark">Danh Sách Tài Khoản Ngân Hàng (@totalCount)</h6>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Ngân hàng</th>
                        <th>Số tài khoản</th>
                        <th>Chủ tài khoản</th>
                        <th>Mẫu QR</th>
                        <th>Vai trò & Trạng thái</th>
                        <th>Cập nhật</th>
                        <th class="text-end pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var previewUrl = item.BuildVietQrUrl(250000, "BS-DEMO-8888");
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle fw-bold px-2 py-1">@item.BankCode</span>
                                    <div>
                                        <div class="fw-bold text-dark">@item.BankName</div>
                                        @if (!string.IsNullOrEmpty(item.Branch))
                                        {
                                            <div class="small text-muted">@item.Branch</div>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="fw-bold font-monospace text-primary fs-6">@item.AccountNumber</span>
                            </td>
                            <td class="fw-semibold text-uppercase text-dark">@item.AccountHolder</td>
                            <td>
                                <span class="badge bg-light text-dark border">@item.QrTemplate</span>
                            </td>
                            <td>
                                <div class="d-flex flex-wrap gap-1 align-items-center">
                                    @if (item.IsDefault)
                                    {
                                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">
                                            <i class="bi bi-star-fill me-1"></i>Mặc định
                                        </span>
                                    }
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">Đang bật</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border">Tạm ngưng</span>
                                    }
                                </div>
                            </td>
                            <td class="small text-muted">@item.UpdatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="text-end pe-4">
                                <div class="d-inline-flex gap-1 align-items-center">
                                    <button type="button"
                                            class="btn btn-sm btn-outline-info rounded-pill px-2"
                                            title="Xem thử mã VietQR"
                                            onclick="showQrPreviewModal('@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(item.BankName))', '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(item.AccountNumber))', '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(item.AccountHolder))', '@previewUrl')">
                                        <i class="bi bi-qr-code"></i>
                                    </button>

                                    @if (!item.IsDefault)
                                    {
                                        <form asp-action="SetDefault" asp-route-id="@item.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-warning rounded-pill px-2 text-dark" title="Đặt làm mặc định">
                                                <i class="bi bi-star"></i> Mặc định
                                            </button>
                                        </form>
                                    }

                                    <form asp-action="ToggleActive" asp-route-id="@item.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm @(item.IsActive ? "btn-outline-secondary" : "btn-outline-success") rounded-circle" title="@(item.IsActive ? "Tạm ngưng tài khoản này" : "Kích hoạt lại")">
                                            <i class="bi @(item.IsActive ? "bi-pause-fill" : "bi-play-fill")"></i>
                                        </button>
                                    </form>

                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary rounded-circle" title="Chỉnh sửa">
                                        <i class="bi bi-pencil"></i>
                                    </a>

                                    @if (totalCount > 1)
                                    {
                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa tài khoản ngân hàng này?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-circle" title="Xóa">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Preview VietQR -->
<div class="modal fade" id="qrPreviewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow-lg">
            <div class="modal-header border-bottom">
                <h5 class="modal-title fw-bold text-dark">
                    <i class="bi bi-qr-code-scan text-primary me-2"></i>Xem Trước Mã Thanh Toán VietQR
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body text-center p-4">
                <div class="p-3 border rounded-4 bg-light d-inline-block mb-3">
                    <img id="modalQrImg" src="" alt="VietQR Preview" class="img-fluid rounded-3" style="max-width: 260px;" />
                </div>
                <div class="fw-bold text-dark fs-6" id="modalBankName"></div>
                <div class="font-monospace fw-bold text-primary fs-5 mt-1" id="modalAccNo"></div>
                <div class="text-muted small text-uppercase fw-semibold" id="modalAccHolder"></div>
                <div class="small text-muted mt-2">
                    Mở ứng dụng ngân hàng quét thử để kiểm tra tên chủ tài khoản thụ hưởng trên hệ thống Napas 24/7.
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function showQrPreviewModal(bankName, accNo, accHolder, qrUrl) {
            document.getElementById('modalBankName').innerText = bankName;
            document.getElementById('modalAccNo').innerText = 'STK: ' + accNo;
            document.getElementById('modalAccHolder').innerText = accHolder;
            document.getElementById('modalQrImg').src = qrUrl;
            const modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('qrPreviewModal'));
            modal.show();
        }
    </script>
}
