@model List<WebsiteBabyShop.Models.User>
@{
    ViewData["Title"] = "Quản Lý Người Dùng & Khách Hàng";
    int totalUsers = ViewBag.TotalUsers ?? 0;
    int adminCount = ViewBag.AdminCount ?? 0;
    int customerCount = ViewBag.CustomerCount ?? 0;
    int newThisWeek = ViewBag.NewThisWeek ?? 0;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold m-0 text-dark"><i class="bi bi-people-fill text-primary me-2"></i>Quản Lý Tài Khoản & Khách Hàng</h4>
        <span class="text-muted small">Quản lý danh sách thành viên, phân quyền quản trị và theo dõi lịch sử mua hàng của ba mẹ</span>
    </div>
    <a asp-action="Create" class="btn btn-primary-baby shadow-sm">
        <i class="bi bi-person-plus-fill me-1"></i> Thêm Tài Khoản Mới
    </a>
</div>

<!-- Stat Cards -->
<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="admin-card-stat">
            <div class="rounded-circle bg-primary-subtle text-primary d-flex align-items-center justify-content-center" style="width: 50px; height: 50px; font-size: 1.5rem;">
                <i class="bi bi-people"></i>
            </div>
            <div>
                <span class="text-muted small">Tổng Người Dùng</span>
                <h4 class="fw-bold m-0 text-dark">@totalUsers</h4>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="admin-card-stat">
            <div class="rounded-circle bg-danger-subtle text-danger d-flex align-items-center justify-content-center" style="width: 50px; height: 50px; font-size: 1.5rem;">
                <i class="bi bi-shield-lock-fill"></i>
            </div>
            <div>
                <span class="text-muted small">Quản Trị Viên</span>
                <h4 class="fw-bold m-0 text-danger">@adminCount</h4>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="admin-card-stat">
            <div class="rounded-circle bg-success-subtle text-success d-flex align-items-center justify-content-center" style="width: 50px; height: 50px; font-size: 1.5rem;">
                <i class="bi bi-person-heart"></i>
            </div>
            <div>
                <span class="text-muted small">Khách Hàng Mua Sắm</span>
                <h4 class="fw-bold m-0 text-success">@customerCount</h4>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="admin-card-stat">
            <div class="rounded-circle bg-warning-subtle text-warning-emphasis d-flex align-items-center justify-content-center" style="width: 50px; height: 50px; font-size: 1.5rem;">
                <i class="bi bi-person-plus"></i>
            </div>
            <div>
                <span class="text-muted small">Mới Đăng Ký Tuần Này</span>
                <h4 class="fw-bold m-0 text-dark">+@newThisWeek</h4>
            </div>
        </div>
    </div>
</div>

<!-- Search & Filters -->
<div class="card border-0 rounded-4 shadow-sm mb-4 p-3">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-12 col-md-5">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                <input type="text" name="search" class="form-control border-start-0" placeholder="Tìm theo họ tên, username, email hoặc SĐT..." value="@ViewBag.Search" />
            </div>
        </div>
        <div class="col-6 col-md-3">
            <select name="role" class="form-select">
                <option value="">-- Tất cả vai trò --</option>
                <option value="Admin" selected="@(ViewBag.Role == "Admin")">Quản trị viên (Admin)</option>
                <option value="Customer" selected="@(ViewBag.Role == "Customer")">Khách hàng (Customer)</option>
            </select>
        </div>
        <div class="col-6 col-md-2">
            <select name="status" class="form-select">
                <option value="">-- Trạng thái --</option>
                <option value="Active" selected="@(ViewBag.Status == "Active")">Đang hoạt động</option>
                <option value="Locked" selected="@(ViewBag.Status == "Locked")">Đang bị khóa</option>
            </select>
        </div>
        <div class="col-12 col-md-2">
            <button type="submit" class="btn btn-dark w-100 rounded-pill"><i class="bi bi-filter me-1"></i> Lọc dữ liệu</button>
        </div>
    </form>
</div>

<!-- Users Table -->
<div class="card border-0 rounded-4 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Người Dùng</th>
                        <th>Tên Đăng Nhập</th>
                        <th>Email & Số Điện Thoại</th>
                        <th>Địa Chỉ Mặc Định</th>
                        <th>Đơn Hàng</th>
                        <th>Vai Trò</th>
                        <th>Trạng Thái</th>
                        <th>Ngày Tạo</th>
                        <th class="text-end pe-3">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var u in Model)
                        {
                            string initial = !string.IsNullOrEmpty(u.FullName) ? u.FullName.Substring(0, 1).ToUpper() : "U";
                            bool isSelf = u.Username.Equals(User.Identity?.Name, StringComparison.OrdinalIgnoreCase);
                            <tr>
                                <td class="ps-3">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle text-white d-flex align-items-center justify-content-center fw-bold shadow-xs" 
                                             style="width: 38px; height: 38px; background: @(u.Role == "Admin" ? "#dc3545" : "var(--baby-primary, #C57B57)"); font-size: 1rem;">
                                            @initial
                                        </div>
                                        <div>
                                            <a asp-action="Details" asp-route-id="@u.Id" class="fw-bold text-dark text-decoration-none">
                                                @u.FullName
                                            </a>
                                            @if (isSelf)
                                            {
                                                <span class="badge bg-secondary small ms-1">Bạn</span>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <code class="text-dark fw-bold">@u.Username</code>
                                </td>
                                <td>
                                    <div class="small">@u.Email</div>
                                    @if (!string.IsNullOrEmpty(u.PhoneNumber))
                                    {
                                        <div class="small text-muted"><i class="bi bi-telephone me-1"></i>@u.PhoneNumber</div>
                                    }
                                </td>
                                <td>
                                    <span class="small text-truncate d-inline-block text-muted" style="max-width: 200px;" title="@u.Address">
                                        @(string.IsNullOrEmpty(u.Address) ? "Chưa có địa chỉ" : u.Address)
                                    </span>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        @u.Orders.Count đơn
                                    </span>
                                </td>
                                <td>
                                    @if (u.Role == "Admin")
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3 py-1">
                                            <i class="bi bi-shield-check me-1"></i>Quản trị viên
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-1">
                                            <i class="bi bi-person me-1"></i>Khách hàng
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (u.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1">
                                            <i class="bi bi-check-circle-fill me-1"></i>Hoạt động
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3 py-1">
                                            <i class="bi bi-lock-fill me-1"></i>Bị khóa
                                        </span>
                                    }
                                </td>
                                <td>
                                    <div class="small text-muted">@u.CreatedAt.ToString("dd/MM/yyyy")</div>
                                </td>
                                <td class="text-end pe-3">
                                    <div class="d-flex justify-content-end gap-1">
                                        <a asp-action="Details" asp-route-id="@u.Id" class="btn btn-sm btn-outline-primary rounded-circle" title="Xem hồ sơ & lịch sử mua hàng">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        @if (!isSelf)
                                        {
                                            <!-- Đổi quyền -->
                                            <form asp-action="ToggleRole" asp-route-id="@u.Id" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn chuyển vai trò tài khoản @u.Username?');">
                                                <button type="submit" class="btn btn-sm btn-outline-secondary rounded-circle" title="Chuyển đổi quyền Admin / Customer">
                                                    <i class="bi bi-person-gear"></i>
                                                </button>
                                            </form>

                                            <!-- Khóa / Mở khóa -->
                                            <form asp-action="ToggleActive" asp-route-id="@u.Id" method="post" class="d-inline">
                                                <button type="submit" class="btn btn-sm @(u.IsActive ? "btn-outline-warning" : "btn-outline-success") rounded-circle" title="@(u.IsActive ? "Khóa tài khoản" : "Mở khóa tài khoản")">
                                                    <i class="bi @(u.IsActive ? "bi-lock" : "bi-unlock")"></i>
                                                </button>
                                            </form>

                                            <!-- Xóa -->
                                            <form asp-action="Delete" asp-route-id="@u.Id" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa tài khoản @u.FullName (@u.Username)?');">
                                                <button type="submit" class="btn btn-sm btn-outline-danger rounded-circle" title="Xóa tài khoản">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center py-5 text-muted">
                                <i class="bi bi-people fs-1 d-block mb-2 text-secondary opacity-50"></i>
                                Không tìm thấy người dùng nào phù hợp với bộ lọc.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <partial name="_AdminPagination" />
    </div>
</div>
