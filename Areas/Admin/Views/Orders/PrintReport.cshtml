@model List<WebsiteBabyShop.Models.Order>
@{
    Layout = null;
    DateTime? fromDate = ViewBag.FromDate as DateTime?;
    DateTime? toDate = ViewBag.ToDate as DateTime?;
    string? status = ViewBag.Status as string;
    decimal totalRevenue = ViewBag.TotalRevenue ?? 0;
    int totalOrders = ViewBag.TotalOrders ?? 0;
    int completedOrders = ViewBag.CompletedOrders ?? 0;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Báo Cáo Doanh Thu & Đơn Hàng - BabyShop</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; color: #1e293b; background: #f8fafc; }
        .report-paper { max-width: 1050px; margin: 20px auto; background: white; padding: 40px; border-radius: 12px; box-shadow: 0 4px 16px rgba(0,0,0,0.06); }
        .table th { background-color: #f1f5f9; font-size: 0.8rem; text-transform: uppercase; font-weight: 700; color: #475569; }
        @@media print {
            body { background: white; margin: 0; padding: 0; }
            .no-print { display: none !important; }
            .report-paper { max-width: 100%; margin: 0; padding: 0; box-shadow: none; }
            table { page-break-inside: auto; }
            tr { page-break-inside: avoid; page-break-after: auto; }
        }
        /* Contrast Safeguards */
        .bg-success-subtle { background-color: #dcfce7 !important; color: #15803d !important; }
        .bg-warning-subtle { background-color: #fef3c7 !important; color: #92400e !important; }
        .bg-secondary-subtle { background-color: #f1f5f9 !important; color: #475569 !important; }
        .text-success { color: #15803d !important; }
        .text-warning-emphasis { color: #92400e !important; }
        .badge { font-weight: 600; }
        .badge.bg-light, .badge.bg-white { color: #1e293b !important; background-color: #f8fafc !important; }
    </style>
</head>
<body>
    <div class="report-paper">
        <!-- Action Bar -->
        <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom no-print">
            <a href="javascript:history.back()" class="btn btn-outline-secondary rounded-pill px-3">
                <i class="bi bi-arrow-left me-1"></i> Quay lại
            </a>
            <div class="d-flex gap-2">
                <button onclick="window.print()" class="btn btn-dark rounded-pill px-4 shadow-sm">
                    <i class="bi bi-printer-fill me-1"></i> In Báo Cáo / Xuất PDF
                </button>
            </div>
        </div>

        <!-- Shop & Report Header -->
        <div class="row align-items-center mb-4 pb-3 border-bottom">
            <div class="col-7">
                <h4 class="fw-bold text-dark m-0">BABYSHOP - THỜI TRANG TRẺ EM CAO CẤP</h4>
                <div class="small text-muted">Địa chỉ: Hà Nội, Việt Nam | Hotline: 0988.889.999</div>
                <div class="small text-muted">Email: cskh@babyshop.vn | Website: www.babyshop.vn</div>
            </div>
            <div class="col-5 text-end">
                <h4 class="fw-bold text-uppercase text-primary m-0">BÁO CÁO BÁN HÀNG</h4>
                <div class="small text-muted mt-1">Ngày xuất: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</div>
                <div class="small text-muted">
                    Kỳ báo cáo: @(fromDate.HasValue ? fromDate.Value.ToString("dd/MM/yyyy") : "Từ trước") - @(toDate.HasValue ? toDate.Value.ToString("dd/MM/yyyy") : "Hiện tại")
                </div>
            </div>
        </div>

        <!-- KPI Cards -->
        <div class="row g-3 mb-4">
            <div class="col-4">
                <div class="p-3 bg-light rounded-3 border">
                    <div class="small text-muted">Tổng Doanh Thu Thực Tế</div>
                    <div class="fs-4 fw-bold text-success">@totalRevenue.ToString("N0") đ</div>
                </div>
            </div>
            <div class="col-4">
                <div class="p-3 bg-light rounded-3 border">
                    <div class="small text-muted">Tổng Số Đơn Hàng</div>
                    <div class="fs-4 fw-bold text-dark">@totalOrders đơn</div>
                </div>
            </div>
            <div class="col-4">
                <div class="p-3 bg-light rounded-3 border">
                    <div class="small text-muted">Đơn Đã Hoàn Thành</div>
                    <div class="fs-4 fw-bold text-primary">@completedOrders đơn</div>
                </div>
            </div>
        </div>

        <!-- Data Table -->
        <div class="table-responsive mb-4">
            <table class="table table-bordered align-middle table-sm mb-0">
                <thead>
                    <tr>
                        <th class="text-center" style="width: 45px;">STT</th>
                        <th>Mã Đơn</th>
                        <th>Khách Hàng & SĐT</th>
                        <th>Địa Chỉ Giao</th>
                        <th class="text-end">Tiền Hàng</th>
                        <th class="text-end">Giảm Giá</th>
                        <th class="text-end">Tổng Thu</th>
                        <th>Thanh Toán</th>
                        <th>Trạng Thái</th>
                        <th>Ngày Đặt</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        int stt = 1;
                        foreach (var o in Model)
                        {
                            <tr>
                                <td class="text-center fw-bold text-muted">@stt</td>
                                <td class="fw-bold">@o.OrderCode</td>
                                <td>
                                    <div class="fw-bold">@o.CustomerName</div>
                                    <div class="small text-muted">@o.CustomerPhone</div>
                                </td>
                                <td class="small" style="max-width: 200px;">@o.ShippingAddress</td>
                                <td class="text-end">@o.SubTotal.ToString("N0")</td>
                                <td class="text-end text-danger">
                                    @if (o.DiscountAmount > 0 || o.PointDiscount > 0 || o.MemberDiscount > 0)
                                    {
                                        <span>-@((o.DiscountAmount + o.PointDiscount + o.MemberDiscount).ToString("N0"))</span>
                                    }
                                    else
                                    {
                                        <span>0</span>
                                    }
                                </td>
                                <td class="text-end fw-bold text-dark">@o.TotalAmount.ToString("N0")</td>
                                <td>
                                    <span class="badge @(o.IsPaid ? "bg-success-subtle text-success border border-success" : "bg-warning-subtle text-warning-emphasis border border-warning") small">
                                        @(o.IsPaid ? "Đã TT" : "Chưa TT")
                                    </span>
                                </td>
                                <td>
                                    <span class="badge bg-secondary-subtle text-dark border small">@o.OrderStatus</span>
                                </td>
                                <td class="small text-muted">@o.CreatedAt.ToString("dd/MM/yy HH:mm")</td>
                            </tr>
                            stt++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="10" class="text-center py-4 text-muted">Không tìm thấy đơn hàng nào trong khoảng thời gian đã chọn.</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="table-light fw-bold">
                        <td colspan="6" class="text-end pe-3">TỔNG DOANH THU:</td>
                        <td class="text-end fs-6 text-success">@totalRevenue.ToString("N0") đ</td>
                        <td colspan="3"></td>
                    </tr>
                </tfoot>
            </table>
        </div>

        <!-- Footer Signatures -->
        <div class="row pt-4 text-center">
            <div class="col-4">
                <div class="fw-bold small text-uppercase mb-5">Người Lập Báo Cáo</div>
                <div class="text-muted small">(Ký & ghi rõ họ tên)</div>
            </div>
            <div class="col-4">
                <div class="fw-bold small text-uppercase mb-5">Kế Toán Bán Hàng</div>
                <div class="text-muted small">(Ký & ghi rõ họ tên)</div>
            </div>
            <div class="col-4">
                <div class="fw-bold small text-uppercase mb-5">Ban Giám Đốc Phê Duyệt</div>
                <div class="text-muted small">(Ký & đóng dấu)</div>
            </div>
        </div>
    </div>
</body>
</html>
