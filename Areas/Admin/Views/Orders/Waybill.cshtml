@model WebsiteBabyShop.Models.Order
@{
    Layout = null;
    string format = ViewBag.Format as string ?? "k80";
    bool isK80 = format == "k80";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Phiếu Gửi Hàng - @Model.OrderCode</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- JsBarcode library for generating scannable barcode -->
    <script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.5/dist/JsBarcode.all.min.js"></script>
    <style>
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background: #e2e8f0; margin: 0; padding: 20px; color: #000; }
        .bill-paper {
            background: white;
            margin: 0 auto;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            box-sizing: border-box;
        }
        .bill-k80 {
            width: 80mm;
            padding: 4mm;
            font-size: 11px;
            line-height: 1.35;
        }
        .bill-a5 {
            width: 148mm;
            min-height: 210mm;
            padding: 10mm;
            font-size: 13px;
        }
        .dotted-line {
            border-top: 1px dashed #444;
            margin: 6px 0;
        }
        .double-line {
            border-top: 2px double #000;
            margin: 8px 0;
        }
        .barcode-box svg {
            max-width: 100%;
            height: auto;
        }
        @@media print {
            body { background: white; padding: 0; margin: 0; }
            .no-print { display: none !important; }
            .bill-paper { box-shadow: none; margin: 0 auto; }
            .bill-k80 { width: 80mm; padding: 2mm; }
            .bill-a5 { width: 100%; }
        }
    </style>
</head>
<body>
    <!-- Format selector and Print buttons -->
    <div class="text-center mb-4 no-print">
        <div class="btn-group me-2" role="group">
            <a asp-action="PrintWaybill" asp-route-id="@Model.Id" asp-route-format="k80" class="btn btn-sm @(isK80 ? "btn-dark" : "btn-outline-dark")">Khổ K80 (Máy in nhiệt 80mm)</a>
            <a asp-action="PrintWaybill" asp-route-id="@Model.Id" asp-route-format="a5" class="btn btn-sm @(!isK80 ? "btn-dark" : "btn-outline-dark")">Khổ A5 / A4 (Giấy thường)</a>
        </div>
        <button onclick="window.print()" class="btn btn-sm btn-primary px-3 rounded-pill shadow-sm">
            <i class="bi bi-printer-fill me-1"></i> In Ngay
        </button>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-secondary px-3 rounded-pill ms-2">
            Đóng
        </a>
    </div>

    <!-- Printable Area -->
    <div class="bill-paper @(isK80 ? "bill-k80" : "bill-a5")">
        <!-- Shop Header -->
        <div class="text-center">
            <div class="fw-bold fs-6 text-uppercase">BabyShop - Đồ Cho Bé</div>
            <div style="font-size: 0.85em;">Hotline: 0988.889.999 | www.babyshop.vn</div>
            <div>Hà Nội, Việt Nam</div>
        </div>

        <div class="dotted-line"></div>

        <!-- Barcode Area -->
        <div class="text-center barcode-box">
            <svg id="barcode"></svg>
            <div class="fw-bold" style="font-size: 1.1em; letter-spacing: 1px;">@Model.OrderCode</div>
            <div style="font-size: 0.85em;" class="text-muted">Ngày đặt: @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
        </div>

        <div class="dotted-line"></div>

        <!-- Receiver Information -->
        <div>
            <div class="fw-bold text-uppercase" style="font-size: 0.9em;">NGƯỜI NHẬN:</div>
            <div class="fw-bold fs-6">@Model.CustomerName</div>
            <div class="fw-bold fs-6"><i class="bi bi-telephone-fill me-1"></i>@Model.CustomerPhone</div>
            <div>@Model.ShippingAddress</div>
            @if (!string.IsNullOrEmpty(Model.Note))
            {
                <div class="mt-1 p-1 bg-light border rounded" style="font-size: 0.85em;">
                    <strong>Ghi chú:</strong> @Model.Note
                </div>
            }
        </div>

        <div class="dotted-line"></div>

        <!-- Items Table -->
        <table class="w-100" style="font-size: 0.9em;">
            <thead>
                <tr style="border-bottom: 1px solid #ccc;">
                    <th style="padding: 2px 0;">Sản phẩm</th>
                    <th class="text-center" style="width: 30px;">SL</th>
                    <th class="text-end" style="width: 65px;">Thành tiền</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model.OrderDetails)
                {
                    <tr style="border-bottom: 1px dashed #eee;">
                        <td style="padding: 3px 0;">
                            <div>@d.ProductName</div>
                            <div class="text-muted" style="font-size: 0.85em;">
                                @(string.IsNullOrEmpty(d.Color) ? "" : d.Color + " - ")@(string.IsNullOrEmpty(d.Size) ? "" : "Size: " + d.Size)
                            </div>
                        </td>
                        <td class="text-center fw-bold">@d.Quantity</td>
                        <td class="text-end fw-bold">@((d.UnitPrice * d.Quantity).ToString("N0"))</td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="dotted-line"></div>

        <!-- Payment & Total Calculation -->
        <table class="w-100" style="font-size: 0.9em;">
            <tr>
                <td>Tiền hàng:</td>
                <td class="text-end">@Model.SubTotal.ToString("N0") đ</td>
            </tr>
            @if (Model.DiscountAmount > 0)
            {
                <tr>
                    <td>Mã giảm giá (@Model.CouponCode):</td>
                    <td class="text-end text-danger">-@Model.DiscountAmount.ToString("N0") đ</td>
                </tr>
            }
            @if (Model.MemberDiscount > 0)
            {
                <tr>
                    <td>Chiết khấu thành viên:</td>
                    <td class="text-end text-primary">-@Model.MemberDiscount.ToString("N0") đ</td>
                </tr>
            }
            @if (Model.PointDiscount > 0)
            {
                <tr>
                    <td>Điểm Baby Club (@Model.PointsUsed điểm):</td>
                    <td class="text-end text-success">-@Model.PointDiscount.ToString("N0") đ</td>
                </tr>
            }
            <tr>
                <td>Phí giao hàng:</td>
                <td class="text-end">@(Model.ShippingFee == 0 ? "Miễn phí" : Model.ShippingFee.ToString("N0") + " đ")</td>
            </tr>
        </table>

        <div class="double-line"></div>

        <!-- COD Amount Highlight -->
        <div class="text-center p-1 border border-2 border-dark rounded">
            <div style="font-size: 0.85em;" class="text-uppercase fw-bold">
                @(Model.PaymentMethod == "COD" && !Model.IsPaid ? "TIỀN THU HỘ (COD)" : "TRẠNG THÁI THANH TOÁN")
            </div>
            <div class="fw-bold fs-5 text-danger">
                @if (Model.PaymentMethod == "COD" && !Model.IsPaid)
                {
                    <span>@Model.TotalAmount.ToString("N0") đ</span>
                }
                else
                {
                    <span class="text-success">ĐÃ THANH TOÁN ONLINE (0 đ)</span>
                }
            </div>
        </div>

        <!-- Shipper Note -->
        <div class="mt-2 text-center" style="font-size: 0.8em; border: 1px dashed #666; padding: 4px;">
            <strong>CHỈ DẪN CHO SHIPPER:</strong><br />
            Cho khách xem hàng, không cho thử.<br />
            Đồ trẻ em cao cấp - Xin nhẹ tay!
        </div>

        <div class="text-center mt-2" style="font-size: 0.75em; color: #555;">
            Cảm ơn ba mẹ đã tin tưởng mua sắm tại BabyShop! ❤️
        </div>
    </div>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            JsBarcode("#barcode", "@Model.OrderCode", {
                format: "CODE128",
                width: @(isK80 ? "1.6" : "2"),
                height: @(isK80 ? "36" : "45"),
                displayValue: false,
                margin: 2
            });
        });
    </script>
</body>
</html>
