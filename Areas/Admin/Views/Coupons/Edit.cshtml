@model WebsiteBabyShop.Models.Coupon
@{
    ViewData["Title"] = "Chỉnh Sửa Voucher " + Model.Code;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold m-0 text-dark"><i class="bi bi-pencil-square text-primary me-2"></i>Chỉnh Sửa Voucher: <span class="text-danger font-monospace">@Model.Code</span></h4>
        <span class="text-muted small">Cập nhật thông tin chiết khấu, hạn dùng hoặc điều kiện áp dụng</span>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill btn-sm">
        <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="card border-0 rounded-4 shadow-sm p-4">
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="UsedCount" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 small" role="alert"></div>

                <div class="row g-3">
                    <!-- Mã Voucher -->
                    <div class="col-md-6">
                        <label asp-for="Code" class="form-label fw-bold small"></label> <span class="text-danger">*</span>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-ticket-perforated"></i></span>
                            <input asp-for="Code" class="form-control font-monospace text-uppercase fw-bold" required />
                        </div>
                        <span asp-validation-for="Code" class="text-danger small"></span>
                    </div>

                    <!-- Tên chương trình -->
                    <div class="col-md-6">
                        <label asp-for="Title" class="form-label fw-bold small"></label> <span class="text-danger">*</span>
                        <input asp-for="Title" class="form-control" required />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <!-- Mô tả -->
                    <div class="col-12">
                        <label asp-for="Description" class="form-label fw-bold small"></label>
                        <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <!-- Loại giảm giá -->
                    <div class="col-12">
                        <label class="form-label fw-bold small">Hình thức giảm giá</label> <span class="text-danger">*</span>
                        <div class="d-flex gap-4 p-3 bg-light rounded-3">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" asp-for="DiscountType" value="Percentage" id="typePercent" onchange="toggleDiscountFields()">
                                <label class="form-check-label fw-semibold" for="typePercent">
                                    <i class="bi bi-percent text-primary me-1"></i> Giảm theo phần trăm (%)
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" asp-for="DiscountType" value="FixedAmount" id="typeFixed" onchange="toggleDiscountFields()">
                                <label class="form-check-label fw-semibold" for="typeFixed">
                                    <i class="bi bi-cash-stack text-success me-1"></i> Giảm số tiền cố định (VNĐ)
                                </label>
                            </div>
                        </div>
                    </div>

                    <!-- Giá trị giảm -->
                    <div class="col-md-6">
                        <label asp-for="DiscountValue" class="form-label fw-bold small" id="discountValueLabel">Giá trị giảm</label> <span class="text-danger">*</span>
                        <div class="input-group">
                            <input asp-for="DiscountValue" type="number" step="any" class="form-control fw-bold" required />
                            <span class="input-group-text bg-light fw-bold" id="discountUnitLabel">%</span>
                        </div>
                        <span asp-validation-for="DiscountValue" class="text-danger small"></span>
                    </div>

                    <!-- Mức giảm tối đa -->
                    <div class="col-md-6" id="maxDiscountGroup">
                        <label asp-for="MaxDiscountAmount" class="form-label fw-bold small">Mức giảm tối đa (VNĐ)</label>
                        <div class="input-group">
                            <input asp-for="MaxDiscountAmount" type="number" step="1000" class="form-control" />
                            <span class="input-group-text bg-light">VNĐ</span>
                        </div>
                    </div>

                    <!-- Đơn hàng tối thiểu -->
                    <div class="col-md-6">
                        <label asp-for="MinOrderAmount" class="form-label fw-bold small">Đơn hàng tối thiểu (VNĐ)</label>
                        <div class="input-group">
                            <input asp-for="MinOrderAmount" type="number" step="1000" class="form-control" />
                            <span class="input-group-text bg-light">VNĐ</span>
                        </div>
                    </div>

                    <!-- Giới hạn số lượt dùng -->
                    <div class="col-md-6">
                        <label asp-for="UsageLimit" class="form-label fw-bold small">Số lượt sử dụng tối đa</label>
                        <div class="input-group">
                            <input asp-for="UsageLimit" type="number" class="form-control" />
                            <span class="input-group-text bg-light">Đã dùng: <strong>@Model.UsedCount</strong></span>
                        </div>
                    </div>

                    <!-- Ngày bắt đầu -->
                    <div class="col-md-6">
                        <label asp-for="StartDate" class="form-label fw-bold small">Ngày bắt đầu hiệu lực</label>
                        <input asp-for="StartDate" type="datetime-local" class="form-control" value="@Model.StartDate.ToString("yyyy-MM-ddTHH:mm")" />
                    </div>

                    <!-- Ngày hết hạn -->
                    <div class="col-md-6">
                        <label asp-for="ExpiryDate" class="form-label fw-bold small">Ngày hết hạn</label>
                        <input asp-for="ExpiryDate" type="datetime-local" class="form-control" value="@(Model.ExpiryDate.HasValue ? Model.ExpiryDate.Value.ToString("yyyy-MM-ddTHH:mm") : "")" />
                    </div>

                    <!-- Kích hoạt -->
                    <div class="col-12 mt-3">
                        <div class="form-check form-switch p-3 bg-light rounded-3">
                            <input class="form-check-input ms-0 me-3" type="checkbox" asp-for="IsActive" id="isActiveSwitch">
                            <label class="form-check-label fw-bold" for="isActiveSwitch">
                                Kích hoạt voucher này (cho phép khách hàng nhập và áp dụng)
                            </label>
                        </div>
                    </div>

                    <!-- Chương trình Săn Mã Giờ Vàng -->
                    <div class="col-12 mt-2">
                        <div class="form-check form-switch p-3 rounded-3 border border-warning-subtle" style="background: #FFFDF8;">
                            <input class="form-check-input ms-0 me-3" type="checkbox" asp-for="IsFlashHunt" id="isFlashHuntSwitch">
                            <label class="form-check-label fw-bold text-dark" for="isFlashHuntSwitch">
                                <i class="bi bi-fire text-danger me-1"></i>Săn Mã Giờ Vàng (Flash Hunt)
                            </label>
                            <div class="form-text text-muted small ms-0 mt-1">
                                Mã sẽ tự động xuất hiện sẵn trong Kho Voucher của tất cả người dùng, hiển thị đồng hồ đếm ngược và chỉ mở cho phép sử dụng khi đến đúng mốc Ngày bắt đầu hiệu lực.
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-light rounded-pill px-4">Hủy bỏ</a>
                    <button type="submit" class="btn btn-primary-baby rounded-pill px-4 shadow-sm">
                        <i class="bi bi-save me-1"></i> Cập Nhật Thay Đổi
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function toggleDiscountFields() {
            const isPercent = document.getElementById('typePercent').checked;
            const valueLabel = document.getElementById('discountValueLabel');
            const unitLabel = document.getElementById('discountUnitLabel');
            const maxGroup = document.getElementById('maxDiscountGroup');

            if (isPercent) {
                valueLabel.innerText = 'Giá trị giảm (%)';
                unitLabel.innerText = '%';
                maxGroup.style.display = 'block';
            } else {
                valueLabel.innerText = 'Số tiền giảm (VNĐ)';
                unitLabel.innerText = 'VNĐ';
                maxGroup.style.display = 'none';
            }
        }

        document.addEventListener('DOMContentLoaded', function() {
            toggleDiscountFields();
        });
    </script>
}
