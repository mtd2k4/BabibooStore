@model List<WebsiteBabyShop.Models.StockReceipt>
@{
    ViewData["Title"] = "Quản Lý Nhập Kho & Tồn Kho";
    int totalReceipts = ViewBag.TotalReceipts ?? 0;
    decimal totalCost = ViewBag.TotalCost ?? 0;
    int totalQuantity = ViewBag.TotalQuantity ?? 0;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold m-0 text-dark"><i class="bi bi-box-arrow-in-down text-primary me-2"></i>Quản Lý Nhập Kho & Tồn Kho</h4>
        <span class="text-muted small">Theo dõi lịch sử nhập hàng từ các xưởng may, nhà cung cấp và quản lý giá vốn sản phẩm</span>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="PrintReport" target="_blank" class="btn btn-outline-secondary rounded-pill px-3 shadow-sm">
            <i class="bi bi-printer me-1"></i> Xuất Báo Cáo Nhập Kho (PDF)
        </a>
        <a asp-action="Create" class="btn btn-primary-baby shadow-sm">
            <i class="bi bi-plus-circle-fill me-1"></i> Tạo Phiếu Nhập Hàng Mới
        </a>
    </div>
</div>

<!-- Stat Cards -->
<div class="row g-3 mb-4">
    <div class="col-12 col-md-4">
        <div class="admin-card-stat">
            <div class="rounded-circle bg-primary-subtle text-primary d-flex align-items-center justify-content-center" style="width: 50px; height: 50px; font-size: 1.5rem;">
                <i class="bi bi-receipt-cutoff"></i>
            </div>
            <div>
                <span class="text-muted small">Tổng Số Phiếu Nhập</span>
                <h4 class="fw-bold m-0 text-dark">@totalReceipts phiếu</h4>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="admin-card-stat">
            <div class="rounded-circle bg-success-subtle text-success d-flex align-items-center justify-content-center" style="width: 50px; height: 50px; font-size: 1.5rem;">
                <i class="bi bi-cash-coin"></i>
            </div>
            <div>
                <span class="text-muted small">Tổng Tiền Vốn Nhập Hàng</span>
                <h4 class="fw-bold m-0 text-success">@totalCost.ToString("N0") đ</h4>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="admin-card-stat">
            <div class="rounded-circle bg-info-subtle text-info d-flex align-items-center justify-content-center" style="width: 50px; height: 50px; font-size: 1.5rem;">
                <i class="bi bi-box-seam-fill"></i>
            </div>
            <div>
                <span class="text-muted small">Tổng Số Lượng Nhập Kho</span>
                <h4 class="fw-bold m-0 text-dark">@totalQuantity chiếc</h4>
            </div>
        </div>
    </div>
</div>

<!-- Filter Box -->
<div class="card border-0 rounded-4 shadow-sm mb-4 p-3">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-12 col-md-4">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                <input type="text" name="search" class="form-control border-start-0" placeholder="Tìm theo mã phiếu, tên hoặc SĐT nhà cung cấp..." value="@ViewBag.Search" />
            </div>
        </div>
        <div class="col-6 col-md-2">
            <input type="date" name="fromDate" class="form-control" value="@ViewBag.FromDate" title="Từ ngày" />
        </div>
        <div class="col-6 col-md-2">
            <input type="date" name="toDate" class="form-control" value="@ViewBag.ToDate" title="Đến ngày" />
        </div>
        <div class="col-6 col-md-2">
            <select name="status" class="form-select">
                <option value="">-- Tất cả trạng thái --</option>
                <option value="Completed" selected="@(ViewBag.Status == "Completed")">Hoàn thành</option>
                <option value="Pending" selected="@(ViewBag.Status == "Pending")">Đang kiểm hàng</option>
                <option value="Cancelled" selected="@(ViewBag.Status == "Cancelled")">Đã hủy</option>
            </select>
        </div>
        <div class="col-6 col-md-2">
            <button type="submit" class="btn btn-dark w-100 rounded-pill"><i class="bi bi-filter me-1"></i> Lọc dữ liệu</button>
        </div>
    </form>
</div>

<!-- Stock Receipts Table -->
<div class="card border-0 rounded-4 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Mã Phiếu</th>
                        <th>Nhà Cung Cấp / Xưởng</th>
                        <th>Số Mặt Hàng</th>
                        <th>Tổng Số Lượng</th>
                        <th>Tổng Tiền Vốn</th>
                        <th>Người Lập</th>
                        <th>Ngày Nhập</th>
                        <th>Trạng Thái</th>
                        <th class="text-end pe-3">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            int totalQty = item.ReceiptDetails.Sum(d => d.Quantity);
                            <tr>
                                <td class="ps-3">
                                    <strong class="text-primary font-monospace fs-6">@item.ReceiptCode</strong>
                                </td>
                                <td>
                                    <div class="fw-bold text-dark">@item.SupplierName</div>
                                    @if (!string.IsNullOrEmpty(item.SupplierPhone))
                                    {
                                        <span class="small text-muted"><i class="bi bi-telephone me-1"></i>@item.SupplierPhone</span>
                                    }
                                </td>
                                <td>
                                    <div>
                                        <span class="badge bg-light text-dark border">
                                            @item.ReceiptDetails.Count mặt hàng
                                        </span>
                                    </div>
                                    @if (item.ReceiptDetails.Any())
                                    {
                                        <div class="d-flex align-items-center gap-1 mt-1 flex-wrap" style="max-width: 140px;">
                                            @foreach (var d in item.ReceiptDetails.Take(3))
                                            {
                                                var thumb = d.ProductVariant?.ImageUrl ?? d.Product?.MainImageUrl;
                                                if (!string.IsNullOrEmpty(thumb))
                                                {
                                                    <img src="@thumb" class="rounded border" style="width: 26px; height: 26px; object-fit: cover;" title="@d.ProductName (@d.Color - @d.Size)" onerror="this.src='/images/placeholder.png'" />
                                                }
                                            }
                                            @if (item.ReceiptDetails.Count > 3)
                                            {
                                                <span class="badge bg-secondary-subtle text-dark border rounded-circle" style="font-size: 0.65rem; padding: 4px;" title="Và @(item.ReceiptDetails.Count - 3) mặt hàng khác">+@(item.ReceiptDetails.Count - 3)</span>
                                            }
                                        </div>
                                    }
                                </td>
                                <td>
                                    <span class="fw-bold text-dark">@totalQty chiếc</span>
                                </td>
                                <td>
                                    <strong class="text-danger fs-6">@item.TotalAmount.ToString("N0") đ</strong>
                                </td>
                                <td>
                                    <span class="small text-muted">@item.CreatedBy</span>
                                </td>
                                <td>
                                    <div class="small">@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                                </td>
                                <td>
                                    @if (item.Status == "Completed")
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1">
                                            <i class="bi bi-check-circle-fill me-1"></i>Đã nhập kho
                                        </span>
                                    }
                                    else if (item.Status == "Pending")
                                    {
                                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-3 py-1">
                                            <i class="bi bi-clock-history me-1"></i>Đang kiểm hàng
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3 py-1">
                                            @item.Status
                                        </span>
                                    }
                                </td>
                                <td class="text-end pe-3">
                                    <div class="d-flex justify-content-end gap-2">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3" title="Xem chi tiết phiếu nhập">
                                            <i class="bi bi-eye me-1"></i> Chi tiết
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn xóa phiếu nhập @item.ReceiptCode?');" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-circle" title="Xóa phiếu nhập">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center py-5 text-muted">
                                <i class="bi bi-box-arrow-in-down fs-1 d-block mb-2 text-secondary opacity-50"></i>
                                Chưa có phiếu nhập kho nào phù hợp.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <partial name="_AdminPagination" />
    </div>
</div>
