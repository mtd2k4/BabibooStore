@model List<WebsiteBabyShop.Models.StockReceipt>
@{
    Layout = null;
    DateTime printedAt = ViewBag.PrintedAt != null ? (DateTime)ViewBag.PrintedAt : DateTime.Now;
    DateTime? fromDate = ViewBag.FromDate as DateTime?;
    DateTime? toDate = ViewBag.ToDate as DateTime?;
    string status = ViewBag.Status as string ?? "";

    int totalReceipts = Model.Count;
    int totalItems = Model.Sum(r => r.ReceiptDetails.Sum(d => d.Quantity));
    decimal totalAmount = Model.Sum(r => r.TotalAmount);
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Báo Cáo Nhập Kho Hàng Hóa - BabyShop</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            color: #1e293b;
            background-color: #f8fafc;
            padding: 20px 0;
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }
        .report-page {
            max-width: 1100px;
            margin: 0 auto;
            background: white;
            padding: 40px;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.05);
        }
        .table th {
            background-color: #f1f5f9 !important;
            color: #475569;
            font-weight: 700;
            font-size: 0.85rem;
            text-transform: uppercase;
        }
        .table td {
            vertical-align: middle;
            font-size: 0.9rem;
        }
        .kpi-card {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 10px;
            padding: 16px;
            text-align: center;
        }
        @@media print {
            body {
                background: white !important;
                padding: 0 !important;
            }
            .report-page {
                box-shadow: none !important;
                padding: 0 !important;
                max-width: 100% !important;
            }
            .no-print {
                display: none !important;
            }
        }
        /* Contrast Safeguards */
        .bg-primary-subtle { background-color: #dbeafe !important; color: #1e40af !important; }
        .bg-success-subtle { background-color: #dcfce7 !important; color: #15803d !important; }
        .bg-info-subtle { background-color: #e0f2fe !important; color: #0369a1 !important; }
        .text-primary { color: #1e40af !important; }
        .text-success { color: #15803d !important; }
        .badge { font-weight: 600; }
        .badge.bg-light, .badge.bg-white { color: #1e293b !important; background-color: #f8fafc !important; }
    </style>
</head>
<body>

    <!-- Controls Bar -->
    <div class="container mb-4 no-print" style="max-width: 1100px;">
        <div class="d-flex justify-content-between align-items-center bg-white p-3 rounded-3 shadow-sm border">
            <div class="d-flex align-items-center gap-2">
                <a href="/Admin/StockReceipts" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                    <i class="bi bi-arrow-left me-1"></i> Trở Về Quản Lý Nhập Kho
                </a>
            </div>
            <div>
                <button onclick="window.print()" class="btn btn-success fw-bold rounded-pill px-4 shadow-sm">
                    <i class="bi bi-printer-fill me-2"></i> In Báo Cáo / Xuất PDF
                </button>
            </div>
        </div>
    </div>

    <!-- Report Page -->
    <div class="report-page">
        <!-- Header -->
        <div class="row align-items-center pb-4 mb-4 border-bottom">
            <div class="col-7">
                <div class="d-flex align-items-center gap-3">
                    <div style="width: 48px; height: 48px; background: #C57B57; border-radius: 12px; display: flex; align-items: center; justify-content: center; color: white; font-size: 1.5rem;">
                        <i class="bi bi-balloon-heart-fill"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold mb-0 text-dark">BABY SHOP VIỆT NAM</h4>
                        <span class="text-muted small">Hệ thống thời trang & đồ dùng cho mẹ & bé cao cấp</span>
                    </div>
                </div>
            </div>
            <div class="col-5 text-end">
                <h5 class="fw-bold text-uppercase text-primary mb-1">Báo Cáo Nhập Kho Hàng Hóa</h5>
                <div class="text-muted small">Thời điểm xuất: <strong>@printedAt.ToString("dd/MM/yyyy HH:mm")</strong></div>
                @if (fromDate.HasValue || toDate.HasValue)
                {
                    <div class="text-muted small">Thời gian: <strong>@(fromDate?.ToString("dd/MM/yyyy") ?? "Từ đầu") - @(toDate?.ToString("dd/MM/yyyy") ?? "Hiện tại")</strong></div>
                }
            </div>
        </div>

        <!-- KPI Cards -->
        <div class="row g-3 mb-4">
            <div class="col-4">
                <div class="kpi-card">
                    <span class="text-muted small">Tổng Số Đợt Nhập Hàng</span>
                    <h4 class="fw-bold text-dark mt-1 mb-0">@totalReceipts.ToString("N0") <span class="fs-6 fw-normal text-muted">phiếu</span></h4>
                </div>
            </div>
            <div class="col-4">
                <div class="kpi-card">
                    <span class="text-muted small">Tổng Số Lượng Sản Phẩm Nhập</span>
                    <h4 class="fw-bold text-primary mt-1 mb-0">@totalItems.ToString("N0") <span class="fs-6 fw-normal">sản phẩm</span></h4>
                </div>
            </div>
            <div class="col-4">
                <div class="kpi-card">
                    <span class="text-muted small">Tổng Chi Phí Nhập Kho</span>
                    <h4 class="fw-bold text-success mt-1 mb-0">@totalAmount.ToString("N0") <span class="fs-6 fw-normal">đ</span></h4>
                </div>
            </div>
        </div>

        <!-- Receipts Table -->
        <div class="table-responsive mb-4">
            <table class="table table-bordered table-hover align-middle">
                <thead>
                    <tr class="text-center">
                        <th style="width: 40px;">STT</th>
                        <th style="width: 110px;">Mã Phiếu</th>
                        <th style="width: 100px;">Ngày Nhập</th>
                        <th>Nhà Cung Cấp</th>
                        <th style="width: 140px;">Người Nhập</th>
                        <th style="width: 100px;">Số Mặt Hàng</th>
                        <th style="width: 100px;">Tổng SL</th>
                        <th style="width: 140px;">Tổng Tiền</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        int stt = 1;
                        foreach (var r in Model)
                        {
                            int rItems = r.ReceiptDetails.Sum(d => d.Quantity);
                            <tr>
                                <td class="text-center text-muted fw-semibold">@(stt++)</td>
                                <td class="text-center font-monospace fw-bold text-primary">@r.ReceiptCode</td>
                                <td class="text-center small">@r.CreatedAt.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <div class="fw-semibold text-dark">@r.SupplierName</div>
                                    @if (!string.IsNullOrEmpty(r.SupplierPhone))
                                    {
                                        <div class="text-muted small"><i class="bi bi-telephone me-1"></i>@r.SupplierPhone</div>
                                    }
                                </td>
                                <td><span class="badge bg-light text-dark border">@r.CreatedBy</span></td>
                                <td class="text-center">@r.ReceiptDetails.Count loại</td>
                                <td class="text-center fw-bold">@rItems.ToString("N0")</td>
                                <td class="text-end fw-bold text-success">@r.TotalAmount.ToString("N0")đ</td>
                            </tr>
                        }
                        <tr class="table-light fw-bold">
                            <td colspan="6" class="text-end text-uppercase">TỔNG CỘNG:</td>
                            <td class="text-center text-primary fs-6">@totalItems.ToString("N0")</td>
                            <td class="text-end text-success fs-6">@totalAmount.ToString("N0")đ</td>
                        </tr>
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">Không có phiếu nhập kho nào trong khoảng thời gian này.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Signatures -->
        <div class="row pt-4 mt-5 text-center">
            <div class="col-4">
                <div class="fw-bold">NGƯỜI LẬP BÁO CÁO</div>
                <div class="text-muted small fst-italic">(Ký, họ tên)</div>
                <div style="height: 80px;"></div>
                <div class="fw-semibold">Thủ Kho Nhập</div>
            </div>
            <div class="col-4">
                <div class="fw-bold">KẾ TOÁN THANH TOÁN</div>
                <div class="text-muted small fst-italic">(Ký, họ tên)</div>
                <div style="height: 80px;"></div>
                <div class="fw-semibold">Phòng Kế Toán</div>
            </div>
            <div class="col-4">
                <div class="fw-bold">BAN GIÁM ĐỐC DUYỆT</div>
                <div class="text-muted small fst-italic">(Ký, đóng dấu)</div>
                <div style="height: 80px;"></div>
                <div class="fw-semibold">Giám Đốc Vận Hành</div>
            </div>
        </div>
    </div>

</body>
</html>
