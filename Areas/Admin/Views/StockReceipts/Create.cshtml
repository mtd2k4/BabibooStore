@model WebsiteBabyShop.Models.StockReceipt
@{
    ViewData["Title"] = "Lập Phiếu Nhập Kho Mới - BabyShop";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h4 class="fw-bold m-0 text-dark">
            <i class="bi bi-box-arrow-in-down text-primary me-2"></i>Lập Phiếu Nhập Kho Hàng Hóa
        </h4>
        <span class="text-muted small">Tự động tăng số lượng tồn kho theo từng biến thể màu sắc, kích cỡ đồng bộ với trang Quản lý sản phẩm</span>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill btn-sm px-3">
            <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách
        </a>
    </div>
</div>

@if (ViewBag.PreselectProductId != null)
{
    <div class="alert alert-info border-0 rounded-4 shadow-sm mb-4 d-flex align-items-center gap-3">
        <div class="rounded-circle bg-white text-info p-2 flex-shrink-0" style="width: 42px; height: 42px; display: flex; align-items: center; justify-content: center;">
            <i class="bi bi-box-arrow-in-down fs-5"></i>
        </div>
        <div class="flex-grow-1">
            <h6 class="fw-bold mb-1 text-dark"><i class="bi bi-link-45deg me-1"></i>Phiếu Nhập Kho Liên Kết Trực Tiếp Từ Quản Lý Sản Phẩm</h6>
            <div class="small text-muted">Hệ thống đã tự động nạp các phân loại của sản phẩm đã chọn vào bảng nhập hàng bên dưới. Bạn chỉ cần nhập số lượng thực tế và đơn giá nhập để tăng tồn kho.</div>
        </div>
    </div>
}

<form asp-action="Create" method="post" id="stockReceiptForm">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 small" role="alert"></div>

    <div class="row g-4">
        <!-- Cột Trái: Thông Tin Nhà Cung Cấp & Tóm Tắt -->
        <div class="col-12 col-lg-4">
            <div class="card border-0 rounded-4 shadow-sm p-4 sticky-top" style="top: 80px; z-index: 10;">
                <h5 class="fw-bold mb-3 text-dark">
                    <i class="bi bi-building text-primary me-2"></i>Thông Tin Nhà Cung Cấp
                </h5>
                
                <div class="mb-3">
                    <label asp-for="SupplierName" class="form-label fw-bold small">Nhà Cung Cấp / Xưởng May</label> <span class="text-danger">*</span>
                    <input asp-for="SupplierName" class="form-control" placeholder="VD: Xưởng May Cotton Kids Minh Châu..." required />
                    <span asp-validation-for="SupplierName" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="SupplierPhone" class="form-label fw-bold small">Số Điện Thoại Liên Hệ</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="bi bi-telephone text-muted"></i></span>
                        <input asp-for="SupplierPhone" class="form-control" placeholder="VD: 0988 776 655" />
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="SupplierAddress" class="form-label fw-bold small">Địa Chỉ Xưởng May / Kho Giao</label>
                    <textarea asp-for="SupplierAddress" class="form-control" rows="2" placeholder="Địa chỉ cơ sở may hoặc kho đối tác..."></textarea>
                </div>

                <div class="mb-3">
                    <label asp-for="Note" class="form-label fw-bold small">Ghi Chú Đợt Hàng</label>
                    <textarea asp-for="Note" class="form-control" rows="2" placeholder="Ghi chú đóng bao, lô hàng mùa hè 2026..."></textarea>
                </div>

                <!-- Tóm Tắt Phiếu Nhập -->
                <div class="p-3 bg-light rounded-4 mt-2 border">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted small">Tổng số mặt hàng:</span>
                        <strong id="summaryItemCount" class="text-dark">0 mặt hàng</strong>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted small">Tổng số lượng nhập:</span>
                        <strong id="summaryTotalQty" class="text-primary fw-bold">0 chiếc</strong>
                    </div>
                    <hr class="my-2" />
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="fw-bold text-dark">Tổng tiền vốn:</span>
                        <h4 class="fw-bold text-danger m-0" id="summaryGrandTotal">0 đ</h4>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary-baby w-100 rounded-pill py-3 mt-3 shadow-sm fw-bold">
                    <i class="bi bi-check2-circle me-1 fs-5 align-middle"></i> Hoàn Tất & Nhập Kho Tự Động
                </button>
            </div>
        </div>

        <!-- Cột Phải: Bảng Danh Sách Sản Phẩm Nhập -->
        <div class="col-12 col-lg-8">
            <div class="card border-0 rounded-4 shadow-sm p-4">
                <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                    <div>
                        <h5 class="fw-bold m-0 text-dark"><i class="bi bi-box-seam text-danger me-2"></i>Chi Tiết Mặt Hàng Nhập Kho</h5>
                        <span class="text-muted small">Chọn sản phẩm và biến thể để nhập kho. Tồn kho biến thể sẽ được cộng dồn tự động.</span>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-sm btn-outline-success rounded-pill px-3 shadow-sm" onclick="openQuickBatchModal()">
                            <i class="bi bi-lightning-charge-fill me-1"></i> Nhập Nhanh Theo Mẫu Sản Phẩm
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3 shadow-sm" onclick="addNewItemRow()">
                            <i class="bi bi-plus-circle me-1"></i> + Thêm Dòng Lẻ
                        </button>
                    </div>
                </div>

                <div class="table-responsive bg-white rounded-3 border">
                    <table class="table table-hover align-middle mb-0" id="itemsTable">
                        <thead class="table-light">
                            <tr class="small text-muted">
                                <th style="width: 32%;">Sản Phẩm</th>
                                <th style="width: 28%;">Biến Thể (Màu & Size)</th>
                                <th style="width: 14%;" class="text-center">SL Nhập</th>
                                <th style="width: 18%;" class="text-end">Giá Vốn (VNĐ)</th>
                                <th style="width: 8%;" class="text-end pe-3">Xóa</th>
                            </tr>
                        </thead>
                        <tbody id="itemsTableBody">
                            <!-- Populated dynamically via JS -->
                        </tbody>
                        <tfoot>
                            <tr class="bg-light fw-bold">
                                <td colspan="2" class="text-end py-3">TỔNG CỘNG ĐỢT NHẬP:</td>
                                <td class="text-center text-primary fs-6 py-3" id="footerTotalQty">0</td>
                                <td colspan="2" class="text-end pe-3 text-danger fs-5 py-3" id="footerTotalAmount">0 đ</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>

                <div class="p-3 bg-light rounded-3 small mt-3 border">
                    <div class="d-flex align-items-start gap-2">
                        <i class="bi bi-shield-check text-success fs-5"></i>
                        <div>
                            <strong>Cơ chế tự động hóa tồn kho:</strong>
                            <div class="text-muted">
                                Sau khi hoàn tất phiếu nhập kho, số lượng sản phẩm nhập sẽ được cộng dồn trực tiếp vào số lượng tồn kho (<code>StockQuantity</code>) của từng biến thể màu sắc và kích cỡ. Hệ thống bán hàng ngoài trang chủ sẽ cập nhật ngay lập tức.
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

<!-- Modal: Nhập Nhanh Toàn Bộ Biến Thể Của Sản Phẩm -->
<div class="modal fade" id="quickBatchModal" tabindex="-1" aria-labelledby="quickBatchModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-dark" id="quickBatchModalLabel">
                    <i class="bi bi-lightning-charge-fill text-warning me-2"></i>Nhập Nhanh Toàn Bộ Biến Thể Của Sản Phẩm
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <p class="text-muted small mb-3">
                    Chọn 1 sản phẩm để tự động nạp tất cả biến thể (màu sắc & kích cỡ) của mẫu đó vào phiếu nhập kho chỉ với 1 click:
                </p>

                <div class="row g-3 mb-4">
                    <div class="col-12">
                        <label class="form-label fw-bold small">Chọn Mẫu Sản Phẩm Cần Nhập:</label>
                        <select id="modalProductSelect" class="form-select" onchange="renderModalVariantsPreview()">
                            <!-- Populated via JS -->
                        </select>
                    </div>
                    <div class="col-6">
                        <label class="form-label fw-bold small">Số Lượng Mặc Định Cho Mỗi Biến Thể:</label>
                        <div class="input-group">
                            <input type="number" id="modalDefaultQty" class="form-control" value="20" min="1" />
                            <span class="input-group-text">chiếc</span>
                        </div>
                    </div>
                    <div class="col-6">
                        <label class="form-label fw-bold small">Giá Vốn Nhập Mặc Định:</label>
                        <div class="input-group">
                            <input type="number" id="modalDefaultPrice" class="form-control" value="120000" min="0" step="1000" />
                            <span class="input-group-text">đ</span>
                        </div>
                    </div>
                </div>

                <!-- Preview Variants List in Modal -->
                <div class="border rounded-3 p-3 bg-light">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="fw-bold small text-dark">Danh Sách Biến Thể Của Mẫu Này:</span>
                        <span id="modalVariantCountBadge" class="badge bg-primary rounded-pill">0 biến thể</span>
                    </div>
                    <div class="table-responsive" style="max-height: 250px; overflow-y: auto;">
                        <table class="table table-sm table-bordered bg-white align-middle mb-0">
                            <thead class="table-light small">
                                <tr>
                                    <th style="width: 40px;" class="text-center">
                                        <input type="checkbox" id="modalCheckAll" checked onchange="toggleModalCheckAll(this)" />
                                    </th>
                                    <th>Ảnh & Màu Sắc</th>
                                    <th>Kích Cỡ (Size)</th>
                                    <th>Tồn Hiện Tại</th>
                                    <th>Mã SKU</th>
                                </tr>
                            </thead>
                            <tbody id="modalVariantsTableBody">
                                <!-- Populated dynamically -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary-baby rounded-pill px-4 fw-bold" onclick="applyBatchImport()">
                    <i class="bi bi-plus-circle me-1"></i> Nạp Toàn Bộ Vào Bảng Nhập Hàng
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const productsData = @Html.Raw(ViewBag.ProductsJson ?? "[]");
        let itemIndex = 0;

        // Thêm một dòng mới
        function addNewItemRow(preselectedProdId = null, preselectedVariantId = null, customQty = 10, customPrice = null) {
            if (!productsData || productsData.length === 0) {
                alert("Hiện tại chưa có sản phẩm nào trong hệ thống để nhập hàng!");
                return;
            }

            const tbody = document.getElementById('itemsTableBody');
            const row = document.createElement('tr');
            row.className = 'stock-item-row';
            row.id = `itemRow_${itemIndex}`;

            const curIdx = itemIndex;

            // Xác định sản phẩm mặc định
            let selectedProd = productsData[0];
            if (preselectedProdId) {
                selectedProd = productsData.find(p => p.Id === parseInt(preselectedProdId)) || productsData[0];
            }

            // Gợi ý giá vốn ~45% giá bán nếu không có customPrice
            const suggestedPrice = customPrice !== null ? customPrice : (Math.round(selectedProd.Price * 0.45 / 1000) * 1000);

            // Xây dựng options sản phẩm
            const productOptionsHtml = productsData.map(p => 
                `<option value="${p.Id}" ${p.Id === selectedProd.Id ? 'selected' : ''}>
                    ${p.Name} (${p.Sku}) - [${Number(p.Price).toLocaleString('vi-VN')} đ]
                </option>`
            ).join('');

            row.innerHTML = `
                <td>
                    <div class="d-flex align-items-center gap-2">
                        <img src="${selectedProd.MainImageUrl || '/images/placeholder.png'}" 
                             id="prodImg_${curIdx}" 
                             class="rounded border flex-shrink-0" 
                             style="width: 44px; height: 44px; object-fit: cover;" 
                             onerror="this.src='/images/placeholder.png'" />
                        <div class="flex-grow-1" style="min-width: 0;">
                            <select name="items[${curIdx}].ProductId" 
                                    class="form-select form-select-sm product-select fw-bold text-truncate" 
                                    onchange="onProductChanged(${curIdx})" required>
                                ${productOptionsHtml}
                            </select>
                            <input type="hidden" name="items[${curIdx}].ProductName" id="productName_${curIdx}" value="${selectedProd.Name}" />
                            <div class="small text-muted text-truncate mt-1">
                                <span class="badge bg-light text-muted border py-0" id="prodCategory_${curIdx}">${selectedProd.CategoryName}</span>
                            </div>
                        </div>
                    </div>
                </td>
                <td>
                    <div class="d-flex align-items-center gap-2">
                        <div class="position-relative flex-shrink-0">
                            <img src="${selectedProd.MainImageUrl || '/images/placeholder.png'}" 
                                 id="variantImg_${curIdx}" 
                                 class="rounded border" 
                                 style="width: 38px; height: 38px; object-fit: cover;" 
                                 onerror="this.src='/images/placeholder.png'" />
                            <span id="variantDot_${curIdx}" 
                                  class="position-absolute bottom-0 end-0 rounded-circle border border-white" 
                                  style="width: 14px; height: 14px; background-color: #C57B57; box-shadow: 0 0 2px rgba(0,0,0,0.3);"></span>
                        </div>
                        <div class="flex-grow-1" style="min-width: 0;">
                            <select name="items[${curIdx}].ProductVariantId" 
                                    id="variantSelect_${curIdx}" 
                                    class="form-select form-select-sm variant-select fw-semibold" 
                                    onchange="onVariantChanged(${curIdx})" required>
                                <!-- Populated dynamically -->
                            </select>
                            <input type="hidden" name="items[${curIdx}].Size" id="variantSize_${curIdx}" value="" />
                            <input type="hidden" name="items[${curIdx}].Color" id="variantColor_${curIdx}" value="" />
                            <div class="d-flex align-items-center gap-1 mt-1 small">
                                <span class="text-muted" style="font-size: 0.76rem;">Tồn kho hiện tại:</span>
                                <span class="badge bg-secondary-subtle text-dark border py-0" id="currentStockBadge_${curIdx}">0</span>
                            </div>
                        </div>
                    </div>
                </td>
                <td>
                    <input type="number" 
                           name="items[${curIdx}].Quantity" 
                           id="qtyInput_${curIdx}" 
                           class="form-control form-control-sm text-center fw-bold qty-input" 
                           value="${customQty}" 
                           min="1" 
                           oninput="calculateTotals(); updatePostStockPreview(${curIdx});" 
                           required />
                    <div class="text-center mt-1" style="font-size: 0.72rem;">
                        <span class="text-success fw-semibold" id="postStockPreview_${curIdx}">Sau nhập: 0</span>
                    </div>
                </td>
                <td>
                    <div class="input-group input-group-sm">
                        <input type="number" 
                               name="items[${curIdx}].ImportPrice" 
                               class="form-control text-end fw-bold price-input" 
                               value="${suggestedPrice}" 
                               step="1000" 
                               min="0" 
                               oninput="calculateTotals()" 
                               required />
                        <span class="input-group-text">đ</span>
                    </div>
                    <div class="text-end text-muted mt-1 small" id="lineTotal_${curIdx}" style="font-size: 0.78rem;">
                        ${(customQty * suggestedPrice).toLocaleString('vi-VN')} đ
                    </div>
                </td>
                <td class="text-end pe-3">
                    <button type="button" class="btn btn-sm btn-outline-danger rounded-circle" onclick="removeItemRow('${curIdx}')" title="Xóa dòng này">
                        <i class="bi bi-trash"></i>
                    </button>
                </td>
            `;

            tbody.appendChild(row);

            // Cập nhật các lựa chọn biến thể
            updateVariantDropdown(curIdx, selectedProd, preselectedVariantId);

            itemIndex++;
            calculateTotals();
        }

        // Khi thay đổi sản phẩm trên một dòng
        function onProductChanged(idx) {
            const row = document.getElementById(`itemRow_${idx}`);
            if (!row) return;

            const select = row.querySelector('.product-select');
            const selectedProdId = parseInt(select.value);
            const prod = productsData.find(p => p.Id === selectedProdId);

            if (prod) {
                // Cập nhật tên và ảnh sản phẩm
                document.getElementById(`productName_${idx}`).value = prod.Name;
                document.getElementById(`prodImg_${idx}`).src = prod.MainImageUrl || '/images/placeholder.png';
                document.getElementById(`prodCategory_${idx}`).textContent = prod.CategoryName || 'Thời trang bé';

                // Cập nhật biến thể
                updateVariantDropdown(idx, prod);

                // Gợi ý giá vốn ~45%
                const suggestedPrice = Math.round(prod.Price * 0.45 / 1000) * 1000;
                row.querySelector('.price-input').value = suggestedPrice;

                calculateTotals();
            }
        }

        // Cập nhật danh sách biến thể trong dropdown của 1 dòng
        function updateVariantDropdown(idx, prod, targetVariantId = null) {
            const variantSelect = document.getElementById(`variantSelect_${idx}`);
            if (!variantSelect) return;

            if (!prod.Variants || prod.Variants.length === 0) {
                variantSelect.innerHTML = `<option value="0" data-stock="0" data-size="Tiêu chuẩn" data-color="Tiêu chuẩn" data-hex="#C57B57" data-img="${prod.MainImageUrl}">Mặc định (Tiêu chuẩn)</option>`;
            } else {
                variantSelect.innerHTML = prod.Variants.map(v => {
                    const isSelected = targetVariantId && v.Id === parseInt(targetVariantId);
                    return `<option value="${v.Id}" 
                                    data-stock="${v.StockQuantity}" 
                                    data-size="${v.Size}" 
                                    data-color="${v.Color}" 
                                    data-hex="${v.ColorHex || '#C57B57'}" 
                                    data-img="${v.ImageUrl || prod.MainImageUrl}"
                                    ${isSelected ? 'selected' : ''}>
                                ${v.Color} - ${v.Size} (Tồn: ${v.StockQuantity})
                            </option>`;
                }).join('');
            }

            // Gọi trigger onVariantChanged để đồng bộ hình ảnh, màu sắc, tồn kho
            onVariantChanged(idx);
        }

        // Khi thay đổi biến thể trên một dòng
        function onVariantChanged(idx) {
            const select = document.getElementById(`variantSelect_${idx}`);
            if (!select) return;

            const selectedOpt = select.options[select.selectedIndex];
            if (selectedOpt) {
                const stock = parseInt(selectedOpt.getAttribute('data-stock')) || 0;
                const size = selectedOpt.getAttribute('data-size') || "Tiêu chuẩn";
                const color = selectedOpt.getAttribute('data-color') || "Tiêu chuẩn";
                const hex = selectedOpt.getAttribute('data-hex') || "#C57B57";
                const img = selectedOpt.getAttribute('data-img') || "/images/placeholder.png";

                document.getElementById(`variantSize_${idx}`).value = size;
                document.getElementById(`variantColor_${idx}`).value = color;
                document.getElementById(`currentStockBadge_${idx}`).textContent = `${stock} cái`;

                // Cập nhật ảnh biến thể và chấm màu
                const vImg = document.getElementById(`variantImg_${idx}`);
                if (vImg) vImg.src = img;

                const vDot = document.getElementById(`variantDot_${idx}`);
                if (vDot) vDot.style.backgroundColor = hex;

                updatePostStockPreview(idx);
            }
        }

        // Cập nhật nhãn dự báo tồn kho sau nhập
        function updatePostStockPreview(idx) {
            const select = document.getElementById(`variantSelect_${idx}`);
            const qtyInput = document.getElementById(`qtyInput_${idx}`);
            const preview = document.getElementById(`postStockPreview_${idx}`);
            if (!select || !qtyInput || !preview) return;

            const selectedOpt = select.options[select.selectedIndex];
            const curStock = selectedOpt ? (parseInt(selectedOpt.getAttribute('data-stock')) || 0) : 0;
            const inputQty = parseInt(qtyInput.value) || 0;
            const postStock = curStock + inputQty;

            preview.textContent = `Sau nhập: ${postStock} cái`;
        }

        // Xóa một dòng và đánh số lại index
        function removeItemRow(idx) {
            const row = document.getElementById(`itemRow_${idx}`);
            if (row) {
                row.remove();
                reindexRows();
                calculateTotals();
            }
        }

        // Tái lập lại chỉ số `items[i]` để model binding luôn liên tục không đứt đoạn
        function reindexRows() {
            const rows = document.querySelectorAll('#itemsTableBody tr.stock-item-row');
            rows.forEach((row, i) => {
                row.id = `itemRow_${i}`;

                // Cập nhật name các inputs
                const prodSelect = row.querySelector('.product-select');
                if (prodSelect) prodSelect.name = `items[${i}].ProductId`;

                const prodName = row.querySelector('input[id^="productName_"]');
                if (prodName) { prodName.name = `items[${i}].ProductName`; prodName.id = `productName_${i}`; }

                const variantSelect = row.querySelector('.variant-select');
                if (variantSelect) { variantSelect.name = `items[${i}].ProductVariantId`; variantSelect.id = `variantSelect_${i}`; }

                const variantSize = row.querySelector('input[id^="variantSize_"]');
                if (variantSize) { variantSize.name = `items[${i}].Size`; variantSize.id = `variantSize_${i}`; }

                const variantColor = row.querySelector('input[id^="variantColor_"]');
                if (variantColor) { variantColor.name = `items[${i}].Color`; variantColor.id = `variantColor_${i}`; }

                const qtyInput = row.querySelector('.qty-input');
                if (qtyInput) { qtyInput.name = `items[${i}].Quantity`; qtyInput.id = `qtyInput_${i}`; }

                const priceInput = row.querySelector('.price-input');
                if (priceInput) priceInput.name = `items[${i}].ImportPrice`;

                const delBtn = row.querySelector('button[onclick^="removeItemRow"]');
                if (delBtn) delBtn.setAttribute('onclick', `removeItemRow('${i}')`);
            });
            itemIndex = rows.length;
        }

        // Tính tổng cộng toàn bộ bảng
        function calculateTotals() {
            let totalQty = 0;
            let grandTotal = 0;
            const rows = document.querySelectorAll('#itemsTableBody tr.stock-item-row');

            rows.forEach(r => {
                const qty = parseInt(r.querySelector('.qty-input')?.value) || 0;
                const price = parseFloat(r.querySelector('.price-input')?.value) || 0;
                const lineTotal = qty * price;
                totalQty += qty;
                grandTotal += lineTotal;

                const lineTotalEl = r.querySelector('[id^="lineTotal_"]');
                if (lineTotalEl) {
                    lineTotalEl.textContent = `${lineTotal.toLocaleString('vi-VN')} đ`;
                }
            });

            document.getElementById('summaryItemCount').innerText = `${rows.length} mặt hàng`;
            document.getElementById('summaryTotalQty').innerText = `${totalQty} chiếc`;
            document.getElementById('summaryGrandTotal').innerText = `${grandTotal.toLocaleString('vi-VN')} đ`;
            document.getElementById('footerTotalQty').innerText = `${totalQty} chiếc`;
            document.getElementById('footerTotalAmount').innerText = `${grandTotal.toLocaleString('vi-VN')} đ`;
        }

        // ==================== QUICK BATCH IMPORT MODAL ====================
        function openQuickBatchModal() {
            if (!productsData || productsData.length === 0) {
                alert("Chưa có sản phẩm nào trong hệ thống!");
                return;
            }

            const select = document.getElementById('modalProductSelect');
            select.innerHTML = productsData.map(p => 
                `<option value="${p.Id}">${p.Name} (${p.Sku}) - [${(p.Variants ? p.Variants.length : 0)} biến thể]</option>`
            ).join('');

            renderModalVariantsPreview();

            const modal = new bootstrap.Modal(document.getElementById('quickBatchModal'));
            modal.show();
        }

        function renderModalVariantsPreview() {
            const select = document.getElementById('modalProductSelect');
            const selectedProdId = parseInt(select.value);
            const prod = productsData.find(p => p.Id === selectedProdId);

            const tbody = document.getElementById('modalVariantsTableBody');
            const countBadge = document.getElementById('modalVariantCountBadge');

            if (!prod || !prod.Variants || prod.Variants.length === 0) {
                countBadge.textContent = "0 biến thể";
                tbody.innerHTML = `<tr><td colspan="5" class="text-center text-muted py-3">Sản phẩm này chưa có biến thể nào cụ thể.</td></tr>`;
                return;
            }

            // Gợi ý giá vốn
            document.getElementById('modalDefaultPrice').value = Math.round(prod.Price * 0.45 / 1000) * 1000;
            countBadge.textContent = `${prod.Variants.length} biến thể`;

            tbody.innerHTML = prod.Variants.map(v => `
                <tr>
                    <td class="text-center">
                        <input type="checkbox" class="modal-variant-check" value="${v.Id}" checked />
                    </td>
                    <td>
                        <div class="d-flex align-items-center gap-2">
                            <img src="${v.ImageUrl || prod.MainImageUrl}" class="rounded border" style="width: 30px; height: 30px; object-fit: cover;" onerror="this.src='/images/placeholder.png'" />
                            <span class="d-inline-block rounded-circle border" style="width: 12px; height: 12px; background-color: ${v.ColorHex || '#C57B57'};"></span>
                            <span class="fw-bold">${v.Color}</span>
                        </div>
                    </td>
                    <td><span class="badge bg-light text-dark border">${v.Size}</span></td>
                    <td><strong>${v.StockQuantity}</strong> cái</td>
                    <td><code class="small text-muted">${v.Sku || prod.Sku}</code></td>
                </tr>
            `).join('');
        }

        function toggleModalCheckAll(master) {
            const checks = document.querySelectorAll('.modal-variant-check');
            checks.forEach(c => c.checked = master.checked);
        }

        function applyBatchImport() {
            const select = document.getElementById('modalProductSelect');
            const selectedProdId = parseInt(select.value);
            const defaultQty = parseInt(document.getElementById('modalDefaultQty').value) || 10;
            const defaultPrice = parseFloat(document.getElementById('modalDefaultPrice').value) || 0;

            const selectedVariantCheckboxes = document.querySelectorAll('.modal-variant-check:checked');
            if (selectedVariantCheckboxes.length === 0) {
                alert("Vui lòng tick chọn ít nhất một biến thể để nhập kho!");
                return;
            }

            selectedVariantCheckboxes.forEach(chk => {
                const variantId = parseInt(chk.value);
                addNewItemRow(selectedProdId, variantId, defaultQty, defaultPrice);
            });

            // Đóng modal
            const modalEl = document.getElementById('quickBatchModal');
            const modalInstance = bootstrap.Modal.getInstance(modalEl);
            if (modalInstance) {
                modalInstance.hide();
            }

            calculateTotals();
        }

        const preselectedProductId = @(ViewBag.PreselectProductId != null ? ViewBag.PreselectProductId.ToString() : "null");
        const preselectedVariantId = @(ViewBag.PreselectVariantId != null ? ViewBag.PreselectVariantId.ToString() : "null");

        // Tự động khởi tạo dòng khi tải trang
        document.addEventListener('DOMContentLoaded', function() {
            if (!productsData || productsData.length === 0) return;

            if (preselectedProductId) {
                const targetProd = productsData.find(p => p.Id === parseInt(preselectedProductId));
                if (targetProd) {
                    if (preselectedVariantId) {
                        // Nhập chính xác 1 biến thể được chỉ định từ sản phẩm hoặc cảnh báo
                        addNewItemRow(targetProd.Id, parseInt(preselectedVariantId), 10);
                    } else if (targetProd.Variants && targetProd.Variants.length > 0) {
                        // Nạp toàn bộ các biến thể của sản phẩm này để nhập kho trọn gói
                        targetProd.Variants.forEach(v => {
                            addNewItemRow(targetProd.Id, v.Id, 10);
                        });
                    } else {
                        addNewItemRow(targetProd.Id, null, 10);
                    }

                    // Tự động cuộn đến bảng và focus vào ô số lượng của dòng đầu tiên
                    setTimeout(() => {
                        const firstQtyInput = document.querySelector('.qty-input');
                        if (firstQtyInput) {
                            firstQtyInput.focus();
                            firstQtyInput.select();
                        }
                    }, 250);
                    return;
                }
            }

            // Mặc định nạp 2 dòng mẫu nếu mở trang trực tiếp
            addNewItemRow(productsData[0].Id);
            if (productsData.length > 1) {
                addNewItemRow(productsData[1].Id);
            }
        });
    </script>
}
