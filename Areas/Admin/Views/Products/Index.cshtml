@model List<WebsiteBabyShop.Models.Product>
@{
    ViewData["Title"] = "Quản Lý Sản Phẩm Thời Trang Bé";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold m-0"><i class="bi bi-box-seam-fill text-danger me-2"></i>Danh Sách Sản Phẩm (@(ViewBag.TotalItems ?? Model.Count))</h4>
    <div class="d-flex gap-2">
        <a asp-action="PrintInventoryReport" target="_blank" class="btn btn-outline-secondary rounded-pill px-3 shadow-sm">
            <i class="bi bi-printer me-1"></i> Xuất Báo Cáo Tồn Kho (PDF)
        </a>
        <a asp-action="Create" class="btn btn-primary-baby shadow-sm">
            <i class="bi bi-plus-circle-fill me-1"></i> Thêm Mẫu Quần Áo Mới
        </a>
    </div>
</div>

<!-- Filters -->
<div class="card border-0 rounded-4 shadow-sm mb-4 p-3">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-12 col-md-4">
            <input type="text" name="search" class="form-control" placeholder="Tìm theo tên hoặc mã SKU..." value="@ViewBag.Search" />
        </div>
        <div class="col-6 col-md-3">
            <select name="gender" class="form-select">
                <option value="">-- Tất cả đối tượng --</option>
                <option value="Bé gái" selected="@(ViewBag.Gender == "Bé gái")">Bé gái</option>
                <option value="Bé trai" selected="@(ViewBag.Gender == "Bé trai")">Bé trai</option>
                <option value="Sơ sinh" selected="@(ViewBag.Gender == "Sơ sinh")">Sơ sinh</option>
                <option value="Unisex" selected="@(ViewBag.Gender == "Unisex")">Unisex</option>
            </select>
        </div>
        <div class="col-6 col-md-3">
            <select name="categoryId" asp-items="ViewBag.Categories" class="form-select">
                <option value="">-- Tất cả danh mục --</option>
            </select>
        </div>
        <div class="col-12 col-md-2">
            <button type="submit" class="btn btn-dark w-100"><i class="bi bi-filter me-1"></i> Lọc</button>
        </div>
    </form>
</div>

@if (TempData["NewlyCreatedProductId"] != null)
{
    <div class="alert alert-success border-0 rounded-4 shadow-sm mb-4 d-flex align-items-center justify-content-between flex-wrap gap-3 p-3">
        <div class="d-flex align-items-center gap-3">
            <div class="rounded-circle bg-success text-white p-2 flex-shrink-0" style="width: 44px; height: 44px; display: flex; align-items: center; justify-content: center;">
                <i class="bi bi-check-lg fs-4"></i>
            </div>
            <div>
                <h6 class="fw-bold mb-1 text-dark">Thêm sản phẩm thành công: @TempData["NewlyCreatedProductName"]</h6>
                <div class="small text-muted">Biến thể của sản phẩm đã được tạo với tồn kho khởi tạo là 0. Bạn hãy tạo phiếu nhập kho để kích hoạt hàng nhé!</div>
            </div>
        </div>
        <a asp-area="Admin" asp-controller="StockReceipts" asp-action="Create" asp-route-productId="@TempData["NewlyCreatedProductId"]" 
           class="btn btn-success rounded-pill px-4 py-2 fw-bold shadow-sm">
            <i class="bi bi-box-arrow-in-down me-1"></i> Tạo Phiếu Nhập Kho Ngay &rarr;
        </a>
    </div>
}

<!-- Table -->
<div class="card border-0 rounded-4 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Ảnh</th>
                        <th>Tên sản phẩm</th>
                        <th>Danh mục</th>
                        <th>Đối tượng</th>
                        <th>Giá niêm yết</th>
                        <th>Giá bán</th>
                        <th>Biến thể & Tồn kho</th>
                        <th>Trạng thái</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var totalStock = item.Variants.Sum(v => v.StockQuantity);
                        <tr>
                            <td>
                                <img src="@(string.IsNullOrEmpty(item.MainImageUrl) ? "https://images.unsplash.com/photo-1622290291468-a28f7a7dc6a8?auto=format&fit=crop&w=100&q=80" : item.MainImageUrl)" 
                                     alt="@item.Name" class="rounded-3" style="width: 50px; height: 50px; object-fit: cover;" />
                            </td>
                            <td>
                                <div class="fw-bold">@item.Name</div>
                                <span class="small text-muted">SKU: @item.Sku</span>
                            </td>
                            <td>@(item.Category?.Name ?? "-")</td>
                            <td>
                                @if (item.Gender == "Bé gái") { <span class="badge bg-danger-subtle text-danger">Bé gái</span> }
                                else if (item.Gender == "Bé trai") { <span class="badge bg-primary-subtle text-primary">Bé trai</span> }
                                else if (item.Gender == "Sơ sinh") { <span class="badge bg-warning-subtle text-warning-emphasis">Sơ sinh</span> }
                                else { <span class="badge bg-secondary-subtle text-secondary">Unisex</span> }
                            </td>
                            <td>@item.Price.ToString("N0") đ</td>
                            <td class="fw-bold text-danger">@item.CurrentPrice.ToString("N0") đ</td>
                            <td>
                                <div class="d-flex align-items-center gap-1">
                                    <span class="badge bg-light text-dark border">@item.Variants.Count biến thể</span>
                                    @if (totalStock == 0)
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle" title="Chưa nhập kho">Hết hàng (0)</span>
                                    }
                                    else if (totalStock <= 10)
                                    {
                                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">Tồn: @totalStock</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">Tồn: @totalStock</span>
                                    }
                                </div>
                                @if (item.Variants.Any(v => !string.IsNullOrEmpty(v.ColorHex)))
                                {
                                    <div class="d-flex align-items-center gap-1 mt-1 flex-wrap" style="max-width: 140px;">
                                        @foreach (var vGroup in item.Variants.Where(v => !string.IsNullOrEmpty(v.ColorHex)).GroupBy(v => v.ColorHex).Take(6))
                                        {
                                            var firstV = vGroup.First();
                                            <span style="display:inline-block; width: 14px; height: 14px; border-radius: 50%; background-color: @vGroup.Key; border: 1px solid rgba(0,0,0,0.2); box-shadow: inset 0 1px 2px rgba(0,0,0,0.15);" title="@(firstV.Color ?? vGroup.Key)"></span>
                                        }
                                    </div>
                                }
                            </td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success">Đang bán</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Tạm dừng</span>
                                }
                            </td>
                            <td>
                                <div class="d-flex gap-1">
                                    <a asp-area="Admin" asp-controller="StockReceipts" asp-action="Create" asp-route-productId="@item.Id" 
                                       class="btn btn-sm btn-outline-success rounded-circle" title="Tạo phiếu nhập kho">
                                        <i class="bi bi-box-arrow-in-down"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary rounded-circle" title="Chỉnh sửa">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn xóa sản phẩm này?');" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-circle" title="Xóa">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <partial name="_AdminPagination" />
    </div>
</div>
