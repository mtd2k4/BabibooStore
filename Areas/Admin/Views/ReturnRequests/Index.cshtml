@model IEnumerable<WebsiteBabyShop.Models.ReturnRequest>
@{
    ViewData["Title"] = "Quản Lý Yêu Cầu Đổi / Trả Hàng";
    string currentStatus = ViewBag.CurrentStatus ?? "";
    string currentFault = ViewBag.CurrentFaultSource ?? "";
    string currentSearch = ViewBag.CurrentSearch ?? "";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalItems = ViewBag.TotalItems ?? 0;
    int totalPending = ViewBag.TotalPending ?? 0;
}

<div class="container-fluid px-0">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h4 class="fw-bold mb-1 text-dark">
                <i class="bi bi-arrow-repeat text-primary me-2" style="color: var(--baby-primary) !important;"></i>
                Quản Lý Đổi / Trả Hàng
            </h4>
            <p class="text-muted small mb-0">Tiếp nhận, thẩm định video/hình ảnh chứng minh lỗi từ Shop hoặc Đơn vị vận chuyển, duyệt đổi trả 7 ngày</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            @if (totalPending > 0)
            {
                <span class="badge bg-danger rounded-pill px-3 py-2 fs-6 shadow-sm animate__animated animate__pulse animate__infinite">
                    <i class="bi bi-exclamation-circle me-1"></i> @totalPending Yêu Cầu Chờ Duyệt
                </span>
            }
        </div>
    </div>

    <!-- Stat Cards / Filter Row -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <a asp-action="Index" asp-route-status="Pending" class="text-decoration-none">
                <div class="admin-card-stat border @(currentStatus == "Pending" ? "border-danger shadow-sm" : "")">
                    <div class="rounded-circle p-3 bg-danger-subtle text-danger">
                        <i class="bi bi-clock-history fs-4"></i>
                    </div>
                    <div>
                        <div class="fs-4 fw-bold text-dark">@ViewBag.TotalPending</div>
                        <div class="small text-muted">Chờ Duyệt Thẩm Định</div>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a asp-action="Index" asp-route-faultSource="ShopFault" class="text-decoration-none">
                <div class="admin-card-stat border @(currentFault == "ShopFault" ? "border-danger shadow-sm" : "")">
                    <div class="rounded-circle p-3 bg-danger-subtle text-danger">
                        <i class="bi bi-shop fs-4"></i>
                    </div>
                    <div>
                        <div class="fs-4 fw-bold text-dark">@ViewBag.TotalShopFault</div>
                        <div class="small text-muted">Lỗi Từ Shop (Free Ship)</div>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a asp-action="Index" asp-route-faultSource="CarrierFault" class="text-decoration-none">
                <div class="admin-card-stat border @(currentFault == "CarrierFault" ? "border-warning shadow-sm" : "")">
                    <div class="rounded-circle p-3 bg-warning-subtle text-warning-emphasis">
                        <i class="bi bi-truck fs-4"></i>
                    </div>
                    <div>
                        <div class="fs-4 fw-bold text-dark">@ViewBag.TotalCarrierFault</div>
                        <div class="small text-muted">Lỗi Vận Chuyển (Khiếu nại ĐVVC)</div>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-3">
            <a asp-action="Index" asp-route-faultSource="CustomerRequest" class="text-decoration-none">
                <div class="admin-card-stat border @(currentFault == "CustomerRequest" ? "border-info shadow-sm" : "")">
                    <div class="rounded-circle p-3 bg-info-subtle text-info">
                        <i class="bi bi-person-check fs-4"></i>
                    </div>
                    <div>
                        <div class="fs-4 fw-bold text-dark">@ViewBag.TotalCustomer</div>
                        <div class="small text-muted">Khách Đổi Size/Ý Muốn</div>
                    </div>
                </div>
            </a>
        </div>
    </div>

    <!-- Filter & Search Panel -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3 p-md-4">
            <form method="get" asp-action="Index" class="row g-3 align-items-center">
                <div class="col-12 col-lg-4">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" name="search" value="@currentSearch" class="form-control bg-light border-start-0 ps-0" placeholder="Tìm theo mã ĐT, mã đơn, khách, SĐT...">
                    </div>
                </div>
                <div class="col-6 col-lg-3">
                    <select name="status" class="form-select bg-light" onchange="this.form.submit()">
                        <option value="">-- Tất cả trạng thái --</option>
                        <option value="Pending" selected="@(currentStatus == "Pending")">Chờ thẩm duyệt</option>
                        <option value="Approved" selected="@(currentStatus == "Approved")">Đã duyệt (Giao bưu tá)</option>
                        <option value="Processing" selected="@(currentStatus == "Processing")">Đang xử lý / Thu hồi</option>
                        <option value="Completed" selected="@(currentStatus == "Completed")">Đã hoàn tất</option>
                        <option value="Rejected" selected="@(currentStatus == "Rejected")">Đã từ chối</option>
                    </select>
                </div>
                <div class="col-6 col-lg-3">
                    <select name="faultSource" class="form-select bg-light" onchange="this.form.submit()">
                        <option value="">-- Nguồn gốc lỗi --</option>
                        <option value="ShopFault" selected="@(currentFault == "ShopFault")">Lỗi từ Shop</option>
                        <option value="CarrierFault" selected="@(currentFault == "CarrierFault")">Lỗi do Đơn vị vận chuyển</option>
                        <option value="CustomerRequest" selected="@(currentFault == "CustomerRequest")">Khách muốn đổi size / mẫu</option>
                    </select>
                </div>
                <div class="col-12 col-lg-2 d-flex gap-2">
                    <button type="submit" class="btn btn-dark w-100 rounded-3">
                        <i class="bi bi-funnel me-1"></i> Lọc
                    </button>
                    @if (!string.IsNullOrEmpty(currentStatus) || !string.IsNullOrEmpty(currentFault) || !string.IsNullOrEmpty(currentSearch))
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary rounded-3" title="Xóa bộ lọc">
                            <i class="bi bi-x-lg"></i>
                        </a>
                    }
                </div>
            </form>
        </div>
    </div>

    <!-- Data Table -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-muted small text-uppercase">
                    <tr>
                        <th class="ps-4">Mã Đổi Trả</th>
                        <th>Đơn Hàng</th>
                        <th>Khách Hàng</th>
                        <th>Nguồn Gốc Lỗi</th>
                        <th>Lý Do Chi Tiết</th>
                        <th>Bằng Chứng</th>
                        <th>Trạng Thái</th>
                        <th>Ngày Tạo</th>
                        <th class="text-end pe-4">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                                Không tìm thấy yêu cầu đổi / trả hàng nào phù hợp bộ lọc.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="fw-bold text-dark text-decoration-none d-block">
                                        @item.ReturnCode
                                    </a>
                                    @if (item.RequestType == "Exchange")
                                    {
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle" style="font-size: 0.72rem;">
                                            <i class="bi bi-arrow-repeat me-1"></i> Đổi Hàng
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle" style="font-size: 0.72rem;">
                                            <i class="bi bi-cash-stack me-1"></i> Trả Hàng / Hoàn Tiền
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (item.Order != null)
                                    {
                                        <a asp-controller="Orders" asp-action="Details" asp-route-id="@item.OrderId" class="fw-bold text-decoration-none text-secondary">
                                            #@item.Order.OrderCode
                                        </a>
                                        <div class="small text-muted">@item.Order.CreatedAt.ToString("dd/MM/yyyy")</div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Đơn #@item.OrderId</span>
                                    }
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark">@item.CustomerName</div>
                                    <div class="small text-muted"><i class="bi bi-telephone me-1"></i>@item.CustomerPhone</div>
                                </td>
                                <td>
                                    @if (item.FaultSource == "ShopFault")
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">
                                            <i class="bi bi-shop me-1"></i> Lỗi do Shop
                                        </span>
                                    }
                                    else if (item.FaultSource == "CarrierFault")
                                    {
                                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2 py-1">
                                            <i class="bi bi-truck me-1"></i> Lỗi Đơn vị VC
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info-subtle text-info border border-info-subtle px-2 py-1">
                                            <i class="bi bi-person me-1"></i> Khách đổi size
                                        </span>
                                    }
                                </td>
                                <td>
                                    <div class="small fw-semibold text-dark text-truncate" style="max-width: 180px;" title="@item.ReasonCategory">
                                        @item.ReasonCategory
                                    </div>
                                    <div class="small text-muted text-truncate" style="max-width: 180px;" title="@item.ReasonDetail">
                                        @item.ReasonDetail
                                    </div>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-1">
                                        @if (!string.IsNullOrEmpty(item.ProofImages))
                                        {
                                            var imgCount = item.ProofImages.Split(';', StringSplitOptions.RemoveEmptyEntries).Length;
                                            <span class="badge bg-light text-dark border" title="@imgCount ảnh chụp lỗi">
                                                <i class="bi bi-images text-primary me-1"></i> @imgCount ảnh
                                            </span>
                                        }
                                        @if (!string.IsNullOrEmpty(item.UnboxingVideoPath) || !string.IsNullOrEmpty(item.UnboxingVideoUrl))
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle" title="Có Video bóc hàng kiểm tra">
                                                <i class="bi bi-play-circle-fill me-1"></i> Video
                                            </span>
                                        }
                                    </div>
                                </td>
                                <td>
                                    @switch (item.Status)
                                    {
                                        case "Pending":
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">
                                                <i class="bi bi-hourglass-split me-1"></i> Chờ duyệt
                                            </span>
                                            break;
                                        case "Approved":
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">
                                                <i class="bi bi-check-circle me-1"></i> Đã duyệt
                                            </span>
                                            break;
                                        case "Processing":
                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2 py-1">
                                                <i class="bi bi-truck me-1"></i> Đang xử lý
                                            </span>
                                            break;
                                        case "Completed":
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                                <i class="bi bi-check2-all me-1"></i> Hoàn tất
                                            </span>
                                            break;
                                        case "Rejected":
                                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1">
                                                <i class="bi bi-x-circle me-1"></i> Từ chối
                                            </span>
                                            break;
                                        default:
                                            <span class="badge bg-light text-dark border">@item.Status</span>
                                            break;
                                    }
                                </td>
                                <td class="small text-muted">
                                    @item.CreatedAt.ToString("dd/MM/yyyy")
                                    <div style="font-size: 0.75rem;">@item.CreatedAt.ToString("HH:mm")</div>
                                </td>
                                <td class="text-end pe-4">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-dark rounded-pill px-3">
                                        <i class="bi bi-eye me-1"></i> Thẩm Định
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        @if (totalPages > 1)
        {
            <div class="card-footer bg-white border-top py-3 d-flex flex-wrap justify-content-between align-items-center">
                <div class="small text-muted">
                    Hiển thị <strong>@Model.Count()</strong> trên tổng số <strong>@totalItems</strong> yêu cầu
                </div>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-status="@currentStatus" asp-route-faultSource="@currentFault" asp-route-search="@currentSearch">
                                <i class="bi bi-chevron-left"></i>
                            </a>
                        </li>
                        @for (int i = 1; i <= totalPages; i++)
                        {
                            <li class="page-item @(currentPage == i ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-status="@currentStatus" asp-route-faultSource="@currentFault" asp-route-search="@currentSearch">
                                    @i
                                </a>
                            </li>
                        }
                        <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-status="@currentStatus" asp-route-faultSource="@currentFault" asp-route-search="@currentSearch">
                                <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>
